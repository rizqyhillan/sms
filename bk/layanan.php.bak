<?php
declare(strict_types=1);
require_once __DIR__.'/../includes/auth.php';
require_once __DIR__.'/_helper.php';
bk_require_access($pdo);
$today=date('Y-m-d');
$stQueue=$pdo->prepare("SELECT bl.*,s.nis,s.nisn,s.nama,mk.nama kelas FROM bk_layanan bl JOIN siswa s ON s.id=bl.siswa_id LEFT JOIN master_kelas mk ON mk.id=bl.kelas_id WHERE bl.tanggal=? ORDER BY bl.nomor_antrian ASC");
$stQueue->execute([$today]);
$rows=$stQueue->fetchAll();
$wait=array_filter($rows,fn($r)=>$r['status']==='menunggu');$serv=array_filter($rows,fn($r)=>$r['status']==='dilayani');$done=array_filter($rows,fn($r)=>$r['status']==='selesai');
$page_title='Layanan BK';require_once __DIR__.'/../layouts/header.php';require_once __DIR__.'/../layouts/sidebar.php';
?>
<main class="main"><header class="topbar"><div class="topbar-title">Layanan BK</div><div class="topbar-user"><?=e(user_name())?></div></header><section class="content">
<div class="page-header"><div><h1><i class="bi bi-chat-heart-fill"></i> Layanan BK</h1><p>Identifikasi siswa → masuk antrian → tentukan keperluan → layani → catat hasil.</p></div></div>
<div class="alert alert-info"><i class="bi bi-shield-check"></i> <strong>Terpisah dari Absensi.</strong> Layanan BK tidak mengubah Absensi Kehadiran maupun Absensi Sholat.</div>
