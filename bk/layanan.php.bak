<div class="dashboard-grid" style="grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px">
<div class="dashboard-table-card"><h2><i class="bi bi-person-plus-fill"></i> Daftarkan Siswa ke Antrian</h2><p>Scan QR atau cari siswa secara manual. <strong>Keperluan belum ditentukan pada tahap ini.</strong></p>
<div id="msg" class="alert" style="display:none"></div><?=csrf_field()?>
<div class="bk-source-card"><div class="bk-source-head"><div><strong>Scanner Siswa</strong><div class="bk-source-sub">Kamera laptop/HP, webcam USB, atau scanner USB QR.</div></div><span id="cameraCount" class="text-muted">Belum dideteksi</span></div><div class="bk-camera-controls"><label class="camera-select-wrap"><span>Pilih Kamera</span><select class="form-control" id="cameraSelect" disabled><option value="">Tekan Deteksi Kamera</option></select></label><button class="btn btn-outline-primary" type="button" id="detectCameras"><i class="bi bi-camera-video"></i> Deteksi Kamera</button></div></div>
<div class="scanner-layout bk-scanner-layout"><div><div id="reader" class="scanner-reader"><div class="scanner-placeholder"><div class="placeholder-icon">⌁</div><strong>Siap memindai QR</strong><span>Pilih kamera lalu aktifkan.</span></div></div><div class="form-actions"><button class="btn btn-primary" type="button" id="startCamera"><i class="bi bi-camera-video"></i> Aktifkan Kamera</button><button class="btn btn-secondary" type="button" id="stopCamera" disabled><i class="bi bi-camera-video-off"></i> Hentikan Kamera</button></div><div id="qrDecoderStatus" class="decoder-status">Pembaca QR: memeriksa dukungan browser…</div></div><div><div class="scanner-feedback-head"><label>Input QR / Scanner USB<input class="form-control" id="usb" autocomplete="off" placeholder="Arahkan scanner USB ke sini…"></label><button class="sound-toggle" type="button" id="soundToggle" aria-pressed="true"><i class="bi bi-volume-up-fill"></i><span>Suara ON</span></button></div><div id="usbStatus" class="usb-status"><strong>🔌 Scanner USB siap.</strong></div><div id="result" class="scan-result neutral">Belum ada scan.</div><div style="margin-top:14px"><label class="form-label">Cari siswa manual</label><input id="search" class="form-control" placeholder="Nama / NIS / NISN"><div id="results"></div></div></div></div>
</div>
<div class="dashboard-table-card"><h2><i class="bi bi-people-fill"></i> Antrian Hari Ini</h2><p>Antrian direset secara operasional setiap hari; histori tetap tersimpan.</p><div id="queue"></div></div>
</div>
<?php else: ?><div class="dashboard-table-card"><h2><i class="bi bi-display"></i> Monitoring Antrian Hari Ini</h2><p>Mode kepala sekolah hanya melihat antrian dan status layanan.</p><div id="queue"></div></div><?php endif; ?>
<div class="dashboard-table-card" style="margin-top:18px"><div class="section-title"><div><h2>Alur Layanan</h2><p>Keperluan ditentukan oleh Guru BK saat siswa mulai dilayani.</p></div></div><div class="bk-flow"><span>1. Scan / Manual</span><b>→</b><span>2. Menunggu</span><b>→</b><span>3. Tentukan Keperluan</span><b>→</b><span>4. Dilayani</span><b>→</b><span>5. Selesai & Catat</span></div></div>
</section></main>
<style>.bk-flow{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:10px 0;color:#334155;font-weight:750}.bk-flow span{padding:10px 13px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px}.queue-item{display:grid;grid-template-columns:58px 1fr auto;gap:12px;align-items:center;padding:13px;border:1px solid #e2e8f0;border-radius:13px;margin-bottom:9px;background:#fff}.queue-no{width:46px;height:46px;border-radius:12px;background:#eff6ff;color:#1d4ed8;display:grid;place-items:center;font-size:18px;font-weight:900}.queue-name{font-weight:850}.queue-meta{font-size:12px;color:#64748b;margin-top:3px}.queue-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.status-pill{display:inline-flex;padding:5px 9px;border-radius:999px;font-size:11px;font-weight:850}.st-wait{background:#fef3c7;color:#92400e}.st-serve{background:#dbeafe;color:#1e40af}.st-done{background:#dcfce7;color:#166534}.st-cancel{background:#f1f5f9;color:#475569}.service-modal{position:fixed;inset:0;background:rgba(15,23,42,.55);display:none;align-items:center;justify-content:center;z-index:9999;padding:18px}.service-box{width:min(720px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:18px;padding:22px}.service-box h3{margin:0 0 14px}.service-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media(max-width:700px){.service-grid{grid-template-columns:1fr}.queue-item{grid-template-columns:48px 1fr}.queue-actions{grid-column:1/-1;justify-content:flex-start}}</style>
<div class="service-modal" id="serviceModal"><div class="service-box"><h3 id="modalTitle">Mulai Layanan</h3><div id="modalBody"></div></div></div>
<script>
const BASE='<?=BASE_URL?>', CSRF=document.querySelector('input[name="csrf_token"]')?.value||'';const $=id=>document.getElementById(id);let stream=null,loop=null,detector=null,qrDecoderPromise=null,lastCode='',lastAt=0,usbBuffer='',usbLastAt=0,usbTimer=null;const esc=s=>String(s??'').replace(/[&<>'"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[m]));
function msg(t,type='success'){const x=$('msg');if(!x)return;x.className='alert alert-'+(type==='error'?'danger':'success');x.innerHTML=t;x.style.display='block';setTimeout(()=>x.style.display='none',4000)}
function beep(ok=true){try{const a=new AudioContext(),o=a.createOscillator(),g=a.createGain();o.frequency.value=ok?880:220;g.gain.value=.05;o.connect(g);g.connect(a.destination);o.start();o.stop(a.currentTime+.12)}catch(e){}}
async function enqueue(code,method='QR'){if(!code)return;const fd=new FormData();fd.append('csrf_token',CSRF);fd.append('action','enqueue');fd.append('kode_qr',code);fd.append('metode',method);try{const r=await fetch(BASE+'bk/layanan_api.php',{method:'POST',body:fd,cache:'no-store'}),d=await r.json();if(d.ok){$('result').className='scan-result success';$('result').innerHTML='<strong>ANTRIAN #'+esc(d.nomor)+'</strong><br>'+esc(d.student.nama)+' · '+esc(d.student.kelas);msg(d.duplicate?'Siswa sudah berada di antrian aktif #'+d.nomor+'.':'Siswa berhasil masuk antrian #'+d.nomor+'.','success');beep(true);loadQueue()}else{$('result').className='scan-result error';$('result').innerHTML=esc(d.message||'Gagal mendaftarkan siswa.');msg(esc(d.message||'Gagal mendaftarkan siswa.'),'error');beep(false)}}catch(e){msg('Tidak dapat terhubung ke server.','error')}}
function clearUsb(){usbBuffer='';if(usbTimer)clearTimeout(usbTimer);usbTimer=null}function processUsb(){const c=usbBuffer.trim();clearUsb();if(c){$('usb').value=c;enqueue(c,'USB')}}function usbKeyCapture(e){const t=e.target;if(t&&['INPUT','TEXTAREA','SELECT'].includes(t.tagName)&&t!==$('usb'))return;const now=performance.now();if(e.key==='Enter'||e.key==='Tab'){if(usbBuffer){e.preventDefault();processUsb()}return}if(typeof e.key!=='string'||e.key.length!==1)return;if(usbBuffer&&(now-usbLastAt)>90)clearUsb();usbBuffer+=e.key;usbLastAt=now;if(usbTimer)clearTimeout(usbTimer);usbTimer=setTimeout(()=>{if(usbBuffer.length>=3)processUsb();else clearUsb()},80)}document.addEventListener('keydown',usbKeyCapture,true);$('usb')?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();enqueue(e.target.value,'USB');e.target.value=''}});
async function loadQrFallback(){if(window.BarcodeDetector||window.jsQR)return true;if(qrDecoderPromise)return qrDecoderPromise;qrDecoderPromise=new Promise(resolve=>{const s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js';s.onload=()=>resolve(!!window.jsQR);s.onerror=()=>resolve(false);document.head.appendChild(s)});return qrDecoderPromise}
async function detectCameras(){if(!navigator.mediaDevices?.getUserMedia)return;try{const p=await navigator.mediaDevices.getUserMedia({video:true,audio:false});p.getTracks().forEach(t=>t.stop());const ds=await navigator.mediaDevices.enumerateDevices(),cams=ds.filter(d=>d.kind==='videoinput'),sel=$('cameraSelect');sel.innerHTML='';cams.forEach((d,i)=>{const o=document.createElement('option');o.value=d.deviceId;o.textContent=d.label||`Kamera ${i+1}`;sel.appendChild(o)});sel.disabled=!cams.length;$('cameraCount').textContent=cams.length+' kamera terdeteksi';msg(cams.length+' kamera terdeteksi.','success')}catch(e){msg('Izin kamera belum tersedia atau kamera tidak dapat dibaca.','error')}}$('detectCameras').onclick=detectCameras;
async function decode(video,canvas,ctx){let code=null;if(window.BarcodeDetector){try{detector=detector||new BarcodeDetector({formats:['qr_code']});const a=await detector.detect(canvas);if(a.length)code=a[0].rawValue}catch(e){}}if(!code&&window.jsQR){try{const im=ctx.getImageData(0,0,canvas.width,canvas.height),d=window.jsQR(im.data,im.width,im.height,{inversionAttempts:'attemptBoth'});if(d)code=d.data}catch(e){}}return code}
$('startCamera')?.addEventListener('click',async()=>{if(!$('cameraSelect').value)await detectCameras();if(!$('cameraSelect').value)return;if(!await loadQrFallback()&&!window.BarcodeDetector){msg('Decoder QR belum tersedia. Gunakan scanner USB.','error');return}try{if(stream)stream.getTracks().forEach(t=>t.stop());stream=await navigator.mediaDevices.getUserMedia({video:{deviceId:{exact:$('cameraSelect').value},width:{ideal:1280},height:{ideal:720}},audio:false});$('reader').innerHTML='';const v=document.createElement('video');v.autoplay=true;v.playsInline=true;v.muted=true;v.srcObject=stream;$('reader').appendChild(v);$('startCamera').disabled=true;$('stopCamera').disabled=false;const c=document.createElement('canvas'),x=c.getContext('2d',{willReadFrequently:true});const tick=async()=>{if(!stream)return;if(v.readyState>=2&&v.videoWidth){const sc=Math.min(1,960/v.videoWidth);c.width=Math.round(v.videoWidth*sc);c.height=Math.round(v.videoHeight*sc);x.drawImage(v,0,0,c.width,c.height);const code=await decode(v,c,x);if(code&&(code!==lastCode||Date.now()-lastAt>2500)){lastCode=code;lastAt=Date.now();enqueue(code,'QR')}}loop=requestAnimationFrame(tick)};tick();msg('Kamera aktif. Arahkan QR siswa.','success')}catch(e){msg('Kamera tidak dapat digunakan.','error')}});$('stopCamera')?.addEventListener('click',()=>{if(loop)cancelAnimationFrame(loop);loop=null;if(stream){stream.getTracks().forEach(t=>t.stop());stream=null}$('reader').innerHTML='<div class="scanner-placeholder"><strong>Kamera dihentikan</strong></div>';$('startCamera').disabled=false;$('stopCamera').disabled=true});
let st;$('search')?.addEventListener('input',()=>{clearTimeout(st);st=setTimeout(async()=>{const q=$('search').value.trim();if(q.length<2){$('results').innerHTML='';return}const r=await fetch(BASE+'bk/layanan_api.php?action=lookup&q='+encodeURIComponent(q),{cache:'no-store'}),d=await r.json();$('results').innerHTML=(d.data||[]).map(s=>`<button type="button" class="btn btn-light w-100 text-start" style="margin-top:6px" data-qr="${esc(s.kode_qr)}"><strong>${esc(s.nama)}</strong><div style="font-size:11px">${esc(s.nis)} · ${esc(s.nisn)} · ${esc(s.kelas)}</div></button>`).join('')||'<div class="text-muted" style="padding:8px">Siswa tidak ditemukan.</div>';document.querySelectorAll('#results [data-qr]').forEach(b=>b.onclick=()=>enqueue(b.dataset.qr,'MANUAL'))},250)});
const CAN_MANAGE = <?=json_encode(user_role()!=='kepala_sekolah')?>;
async function loadQueue(){
 try{
  const r=await fetch(BASE+'bk/layanan_api.php?action=queue',{cache:'no-store',headers:{'X-Requested-With':'fetch','Accept':'application/json'}});
  const d=await r.json();
  if(!d.ok) throw new Error(d.message||'Gagal memuat antrian');
  const q=$('queue'); if(!q)return;
  if(!d.data.length){q.innerHTML='<div class="empty-state">Belum ada siswa dalam antrian hari ini.</div>';return}
  q.innerHTML=d.data.map(r=>{
   let action='';
   const nm=esc(r.nama).replace(/'/g,"\\'");
   if(r.status==='menunggu'&&CAN_MANAGE) action=`<button class="btn btn-sm btn-primary" onclick="serviceStart(${r.id},'${nm}')">Layani</button><button class="btn btn-sm btn-outline-secondary" onclick="cancelService(${r.id})">Batal</button>`;
   if(r.status==='dilayani'&&CAN_MANAGE) action=`<button class="btn btn-sm btn-success" onclick="finishService(${r.id},'${nm}')">Selesaikan &amp; Catat</button><button class="btn btn-sm btn-outline-secondary" onclick="cancelService(${r.id})">Batal</button>`;
   const cls=r.status==='menunggu'?'wait':r.status==='dilayani'?'serve':r.status==='selesai'?'done':'cancel';
   return `<div class="queue-item"><div class="queue-no">${r.nomor_antrian}</div><div><div class="queue-name">${esc(r.nama)} <span class="status-pill st-${cls}">${statusLabel(r.status)}</span></div><div class="queue-meta">${esc(r.kelas||'-')} · Masuk ${esc(String(r.waktu_masuk).slice(11,16))} WIB · ${r.jenis_layanan?esc(r.jenis_layanan):'Keperluan belum ditentukan'}</div></div><div class="queue-actions">${action}</div></div>`;
  }).join('');
 }catch(e){console.error('loadQueue',e)}
}
function statusLabel(s){return {menunggu:'MENUNGGU',dilayani:'DILAYANI',selesai:'SELESAI',batal:'BATAL'}[s]||s}function serviceStart(id,name){$('modalTitle').textContent='Mulai Layanan — '+name;$('modalBody').innerHTML=`<label class="form-label">Keperluan/Layanan *</label><select id="mjenis" class="form-control"><option value="">Pilih keperluan...</option><option value="konsultasi">Konsultasi</option><option value="konseling">Konseling</option><option value="rujukan">Rujukan</option><option value="administratif">Administratif</option><option value="lainnya">Lainnya</option></select><div style="margin-top:14px;display:flex;gap:8px"><button class="btn btn-primary" onclick="startService(${id})">Mulai Layanan</button><button class="btn btn-secondary" onclick="closeModal()">Batal</button></div>`;$('serviceModal').style.display='flex'}async function startService(id){const f=new FormData();f.append('csrf_token',CSRF);f.append('action','start');f.append('id',id);f.append('jenis_layanan',$('mjenis').value);const r=await fetch(BASE+'bk/layanan_api.php',{method:'POST',body:f}),d=await r.json();if(!d.ok)return msg(d.message,'error');closeModal();loadQueue()}function finishService(id,name){$('modalTitle').textContent='Selesaikan Layanan — '+name;$('modalBody').innerHTML=`<div class="alert alert-info" style="margin-bottom:14px"><i class="bi bi-info-circle"></i> Isi catatan layanan, lalu tekan <strong>Simpan &amp; Selesaikan</strong>. Status baru berubah menjadi <strong>SELESAI</strong> setelah penyimpanan berhasil.</div><div class="service-grid"><div><label class="form-label">Topik</label><input id="mtopik" class="form-control"><label class="form-label mt-3">Permasalahan/Konteks</label><textarea id="mper" class="form-control" rows="5"></textarea></div><div><label class="form-label">Hasil</label><textarea id="mhasil" class="form-control" rows="5"></textarea><label class="form-label mt-3">Kesepakatan</label><textarea id="mkes" class="form-control" rows="4"></textarea><label class="form-label mt-3">Tindak Lanjut</label><textarea id="mtl" class="form-control" rows="4"></textarea></div></div><label class="mt-3" style="display:flex;gap:8px;align-items:center"><input type="checkbox" id="mort"> Melibatkan orang tua/wali</label><div style="margin-top:14px;display:flex;gap:8px"><button class="btn btn-success" onclick="finishService(${id})">Simpan &amp; Selesaikan</button><button class="btn btn-secondary" onclick="closeModal()">Batal</button></div>`;$('serviceModal').style.display='flex'}async function finishService(id){
 const f=new FormData();
 f.append('csrf_token',CSRF);f.append('action','finish');f.append('id',id);
 f.append('topik',$('mtopik').value);f.append('permasalahan',$('mper').value);f.append('hasil',$('mhasil').value);
 f.append('kesepakatan',$('mkes').value);f.append('tindak_lanjut',$('mtl').value);
 if($('mort').checked)f.append('melibatkan_ortu','1');
 try{
  const r=await fetch(BASE+'bk/layanan_api.php',{method:'POST',body:f,cache:'no-store',headers:{'Accept':'application/json'}});
  const d=await r.json();
  if(!d.ok){msg(d.message||'Layanan belum dapat diselesaikan.','error');return;}
  closeModal();
  msg('Layanan berhasil diselesaikan. Status siswa sekarang SELESAI.','success');
  await loadQueue();
 }catch(e){console.error('finishService',e);msg('Gagal menyimpan penyelesaian layanan. Periksa koneksi/server.','error');}
}
function cancelService(id){if(!confirm('Batalkan antrian/layanan ini?'))return;const f=new FormData();f.append('csrf_token',CSRF);f.append('action','cancel');f.append('id',id);fetch(BASE+'bk/layanan_api.php',{method:'POST',body:f}).then(r=>r.json()).then(d=>{if(!d.ok)msg(d.message,'error');else loadQueue()})}function closeModal(){$('serviceModal').style.display='none'}
function renderQueue(){const q=$('queue');if(!q)return;const rows=<?=json_encode($rows,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)?>;if(!rows.length){q.innerHTML='<div class="empty-state">Belum ada siswa dalam antrian hari ini.</div>';return}q.innerHTML=rows.map(r=>{let action='';if(r.status==='menunggu'&&<?=json_encode(user_role()!=='kepala_sekolah')?>)action=`<button class="btn btn-sm btn-primary" onclick="serviceStart(${r.id},'${esc(r.nama).replace(/'/g,"\\'")}')">Layani</button><button class="btn btn-sm btn-outline-secondary" onclick="cancelService(${r.id})">Batal</button>`;if(r.status==='dilayani'&&<?=json_encode(user_role()!=='kepala_sekolah')?>)action=`<button class="btn btn-sm btn-success" onclick="finishService(${r.id},'${esc(r.nama).replace(/'/g,"\\'")}')">Selesaikan</button><button class="btn btn-sm btn-outline-secondary" onclick="cancelService(${r.id})">Batal</button>`;return `<div class="queue-item"><div class="queue-no">${r.nomor_antrian}</div><div><div class="queue-name">${esc(r.nama)} <span class="status-pill st-${r.status==='menunggu'?'wait':r.status==='dilayani'?'serve':r.status==='selesai'?'done':'cancel'}">${statusLabel(r.status)}</span></div><div class="queue-meta">${esc(r.kelas||'-')} · Masuk ${esc(String(r.waktu_masuk).slice(11,16))} WIB · ${r.jenis_layanan?esc(r.jenis_layanan):'Keperluan belum ditentukan'}</div></div><div class="queue-actions">${action}</div></div>`}).join('')}
loadQueue();setInterval(loadQueue,5000);(async()=>{if(!('BarcodeDetector'in window)){const ok=await loadQrFallback();$('qrDecoderStatus').textContent=ok?'Pembaca QR: jsQR fallback siap.':'Fallback QR belum tersedia.'}else $('qrDecoderStatus').textContent='Pembaca QR: BarcodeDetector tersedia.';detectCameras();$('usb')?.focus()})();
</script><?php require_once __DIR__.'/../layouts/footer.php'; ?>
