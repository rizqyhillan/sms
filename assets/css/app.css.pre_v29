/* Izin actions + status colors. */
.izin-module .page-header-actions .btn-primary{background:#2563eb !important;border-color:#2563eb !important;color:#fff !important}
.izin-module .table .btn-secondary{background:#06b6d4 !important;border-color:#06b6d4 !important;color:#fff !important}
