}

/* =========================================================
   UI MASTER V6 — PROFESSIONAL CARD TYPOGRAPHY
   Keep full-color design; standardize card typography only.
   Presentation only. No business logic or database changes.
   ========================================================= */

.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-label,
.dashboard-page.role-admin .dashboard-notification-grid .dashboard-alert .alert-label{
    font-size:14px !important;
    font-weight:700 !important;
