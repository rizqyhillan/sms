        padding:15px !important;
    }
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-label{font-size:14px !important;}
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-value{font-size:28px !important;}
