/* LOCAL FONT — POPPINS (OFFLINE) */
@font-face { font-family: 'Poppins'; src: url('../fonts/poppins/Poppins-400.woff2') format('woff2'); font-style: normal; font-weight: 400; font-display: swap; }
@font-face { font-family: 'Poppins'; src: url('../fonts/poppins/Poppins-500.woff2') format('woff2'); font-style: normal; font-weight: 500; font-display: swap; }
@font-face { font-family: 'Poppins'; src: url('../fonts/poppins/Poppins-600.woff2') format('woff2'); font-style: normal; font-weight: 600; font-display: swap; }
@font-face { font-family: 'Poppins'; src: url('../fonts/poppins/Poppins-700.woff2') format('woff2'); font-style: normal; font-weight: 700; font-display: swap; }
@font-face { font-family: 'Poppins'; src: url('../fonts/poppins/Poppins-800.woff2') format('woff2'); font-style: normal; font-weight: 800; font-display: swap; }

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    font-family: 'Poppins', 'Segoe UI', system-ui, sans-serif;
    background: #f1f5f9;
    color: #1e293b;
}

a {
    text-decoration: none;
    color: inherit;
}


/* =====================================================
   APP
===================================================== */

.app {
    min-height: 100vh;
}


/* =====================================================
   SIDEBAR
===================================================== */

.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 250px;
    background: #0f172a;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    z-index: 1000;
    overflow: hidden;
}


/* =====================================================
   BRAND
===================================================== */

.sidebar-brand {
    flex: 0 0 auto;
    padding: 20px;
    border-bottom: 1px solid rgba(255,255,255,.08);
}

.sidebar-brand h2 {
    margin: 0;
    font-size: 17px;
    line-height: 1.4;
}

.sidebar-brand small {
    display: block;
    margin-top: 5px;
    color: #94a3b8;
    font-size: 11px;
}


/* =====================================================
   MENU
===================================================== */

.sidebar-menu {
    flex: 1 1 auto;
    min-height: 0;
    padding: 15px 10px;
    overflow-y: auto;
    overflow-x: hidden;
}

.menu-title {
    padding: 12px 10px 7px;
    margin-top: 8px;
    color: #64748b;
    font-size: 10px;
    text-transform: uppercase;
    font-weight: bold;
    letter-spacing: .5px;
}

.menu-item {
    display: block;
    padding: 10px 13px;
    margin-bottom: 3px;
    border-radius: 7px;
    color: #cbd5e1;
    font-size: 14px;
    transition: .2s;
    position: relative;
}

.menu-item:hover {
    background: #1e293b;
    color: #ffffff;
}

.menu-item.active {
    background: #2563eb;
    color: #ffffff;
}


/* =====================================================
   IKON MENU
===================================================== */

.menu-item {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 10px 13px;
    margin-bottom: 3px;
    border-radius: 9px;
    color: #cbd5e1;
    font-size: 14px;
    transition: .2s;
    position: relative;
}

.menu-item-sub {
    padding-left: 24px;
    font-size: 13px;
}

.menu-icon {
    width: 20px;
    min-width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    color: #94a3b8;
    font-size: 15px;
    line-height: 1;
}

.menu-label {
    min-width: 0;
    line-height: 1.25;
}

.menu-item:hover .menu-icon,
.menu-item.active .menu-icon {
    color: #ffffff;
}

.sidebar-logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
    background: #ffffff;
    border-radius: 12px;
    padding: 5px;
    margin-bottom: 8px;
}

.sidebar-brand-title {
    font-size: 17px;
    line-height: 1.4;
    font-weight: 750;
}

/* =====================================================
   SIDEBAR BOTTOM / LOGOUT
===================================================== */

.sidebar-bottom {
    flex: 0 0 auto;
    padding: 10px;
    border-top: 1px solid rgba(255,255,255,.08);
    background: #0f172a;
}

.logout-item {
    display: block;
    padding: 11px 13px;
    border-radius: 7px;
    color: #fca5a5;
    font-size: 14px;
}

.logout-item:hover {
    background: #7f1d1d;
    color: #ffffff;
}



/* =====================================================
   SCROLLBAR SIDEBAR
===================================================== */

.sidebar-menu::-webkit-scrollbar {
    width: 5px;
}

.sidebar-menu::-webkit-scrollbar-track {
    background: transparent;
}

.sidebar-menu::-webkit-scrollbar-thumb {
    background: #334155;
    border-radius: 10px;
}


/* =====================================================
   MAIN
===================================================== */

.main {
    margin-left: 250px;
    min-height: 100vh;
    padding-top: 70px;
}


/* =====================================================
   TOPBAR
===================================================== */

.topbar {
    position: fixed;
    top: 0;
    right: 0;
    left: 250px;
    height: 70px;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 25px;
    z-index: 900;
}

.topbar-title {
    font-size: 18px;
    font-weight: bold;
    color: #0f172a;
}

.topbar-school {
    display: block;
    margin-top: 2px;
    color: #64748b;
    font-size: 11px;
    font-weight: normal;
}

.user-info {
    text-align: right;
}

.user-info strong {
    display: block;
    font-size: 14px;
}

.user-info small {
    color: #64748b;
    font-size: 12px;
}


/* =====================================================
   CONTENT
===================================================== */

.content {
    padding: 25px;
}

.page-title {
    margin: 0 0 5px;
    font-size: 24px;
}

.page-description {
    margin: 0 0 25px;
    color: #64748b;
}


/* =====================================================
   PAGE HEADER
===================================================== */

.page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
}

.page-header > div:first-child {
    min-width: 0;
}

.page-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.page-header-actions .btn {
    position: relative;
    z-index: 1;
    white-space: nowrap;
}

.page-header h1 {
    margin: 0 0 6px;
    font-size: 24px;
    font-weight: 700;
}

.page-header h2 {
    margin: 0 0 6px;
    font-size: 24px;
    font-weight: 700;
}

.page-header p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
}


/* =====================================================
   DASHBOARD GRID
===================================================== */

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.dashboard-card {
    background: #ffffff;
    border-radius: 10px;
    padding: 20px;
    border: 1px solid #e2e8f0;
}

.dashboard-card h3 {
    margin: 0 0 8px;
    font-size: 14px;
    color: #64748b;
}

.dashboard-card .number {
    font-size: 28px;
    font-weight: bold;
}

.card-label {
    color: #64748b;
    font-size: 13px;
    margin-bottom: 8px;
}

.card-number {
    font-size: 28px;
    line-height: 1.2;
    font-weight: 700;
    color: #0f172a;
}

.card-description {
    margin-top: 6px;
    color: #94a3b8;
    font-size: 12px;
}


/* =====================================================
   SECTION TITLE
===================================================== */

.section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 28px 0 14px;
}

.section-title h2,
.section-title h3 {
    margin: 0 0 5px;
    font-size: 18px;
    font-weight: 700;
}

.section-title p {
    margin: 0;
    color: #64748b;
    font-size: 13px;
}


/* =====================================================
   TABLE CARD
===================================================== */

.dashboard-table-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
}


/* =====================================================
   FILTER
===================================================== */

.filter-form {
    display: flex;
    align-items: flex-end;
    gap: 16px;
    padding: 20px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    flex-wrap: wrap;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 220px;
}

.filter-group:first-child {
    flex: 1;
    min-width: 280px;
}

.filter-group label {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
}

.filter-group input,
.filter-group select {
    width: 100%;
    height: 42px;
    padding: 0 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #ffffff;
    color: #1e293b;
    font-family: inherit;
    font-size: 14px;
    box-sizing: border-box;
    outline: none;
}

.filter-group input:focus,
.filter-group select:focus {
    border-color: #64748b;
    box-shadow: 0 0 0 3px rgba(100, 116, 139, 0.12);
}

.filter-action {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 0;
}

.filter-bar {
    display: flex;
    gap: 10px;
    align-items: center;
    margin: 18px 0;
}

.filter-bar input {
    flex: 1;
}


/* =====================================================
   BUTTON
===================================================== */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 80px;
    height: 42px;
    padding: 0 16px;
    border-radius: 8px;
    border: 1px solid transparent;
    text-decoration: none;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    box-sizing: border-box;
    white-space: nowrap;
    line-height: 1;
}

.btn-primary {
    background: #1e293b;
    color: #ffffff;
}

.btn-primary:hover {
    background: #0f172a;
    color: #ffffff;
}

.btn-secondary {
    background: #ffffff;
    color: #334155;
    border-color: #cbd5e1;
}

.btn-secondary:hover {
    background: #f1f5f9;
    color: #334155;
}

.btn-sm {
    min-width: auto;
    height: 36px;
    padding: 0 10px;
    font-size: .85rem;
}


/* =====================================================
   FORM
===================================================== */

.form-card,
.qr-print-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 24px;
    margin-top: 18px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.form-grid label {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-weight: 600;
    color: #334155;
}

.form-control {
    width: 100%;
    min-height: 42px;
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    background: #ffffff;
    color: #1e293b;
    font-family: inherit;
    font-size: 14px;
}

.form-control:focus {
    outline: none;
    border-color: #64748b;
    box-shadow: 0 0 0 3px rgba(100, 116, 139, .12);
}

.form-actions {
    display: flex;
    gap: 10px;
    margin-top: 22px;
}


/* =====================================================
   TABLE INFO
===================================================== */

.table-info {
    padding: 15px 20px;
    color: #64748b;
    font-size: 13px;
    border-bottom: 1px solid #e2e8f0;
}

.table-info strong {
    color: #334155;
}


/* =====================================================
   TABLE
===================================================== */

.table-responsive {
    width: 100%;
    overflow-x: auto;
}

.data-table {
    width: 100%;
    min-width: 950px;
    border-collapse: collapse;
    font-size: 14px;
}

.data-table thead th {
    padding: 13px 14px;
    background: #f8fafc;
    color: #475569;
    font-size: 12px;
    font-weight: 700;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    border-bottom: 1px solid #e2e8f0;
    white-space: nowrap;
}

.data-table tbody td {
    padding: 13px 14px;
    color: #334155;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: middle;
}

.data-table tbody tr:hover {
    background: #f8fafc;
}

.data-table tbody tr:last-child td {
    border-bottom: none;
}

.data-table code {
    display: inline-block;
    padding: 4px 7px;
    background: #f1f5f9;
    border-radius: 5px;
    color: #475569;
    font-size: 12px;
}

.table-actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}


/* =====================================================
   STATUS BADGE
===================================================== */

.status-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 68px;
    padding: 5px 9px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
}

.status-aktif {
    background: #dcfce7;
    color: #166534;
}

.status-lulus {
    background: #dbeafe;
    color: #1e40af;
}

.status-nonaktif {
    background: #f1f5f9;
    color: #475569;
}

.status-draft {
    background: #fef3c7;
    color: #92400e;
}

.status-ditutup {
    background: #e2e8f0;
    color: #334155;
}


/* =====================================================
   ALERT
===================================================== */

.alert {
    padding: 12px 15px;
    border-radius: 10px;
    margin: 14px 0;
}

.alert-danger {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
}

.alert-success {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
}


/* =====================================================
   EMPTY STATE
===================================================== */

.empty-state {
    padding: 45px 25px;
    text-align: center;
    color: #64748b;
}

.empty-state strong {
    display: block;
    margin-bottom: 6px;
    color: #334155;
    font-size: 15px;
}

.empty-state p {
    margin: 0;
    font-size: 13px;
}


/* =====================================================
   PAGINATION
===================================================== */

.pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 16px 20px;
    border-top: 1px solid #e2e8f0;
    background: #ffffff;
}

.pagination-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0 13px;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    background: #ffffff;
    color: #334155;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
}

.pagination-link:hover {
    background: #f8fafc;
}

.pagination-info {
    color: #64748b;
    font-size: 13px;
}

.pagination-info strong {
    color: #334155;
}


/* =====================================================
   INFO BOX
===================================================== */

.info-box {
    margin-top: 20px;
    padding: 16px 18px;
    border: 1px solid #dbeafe;
    border-radius: 10px;
    background: #eff6ff;
    color: #334155;
    font-size: 13px;
    line-height: 1.6;
}

.info-box strong {
    color: #1e3a8a;
}

.info-box p {
    margin: 5px 0 0;
}


/* =====================================================
   DETAIL
===================================================== */

.detail-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
}

.detail-grid div {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.detail-grid small {
    color: #6b7280;
}


/* =====================================================
   QR
===================================================== */

.qr-print-card {
    text-align: center;
    max-width: 420px;
    margin: 30px auto;
}

.qr-print-card #qrcode {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
}


/* =====================================================
   LOGIN / AUTHENTICATION
===================================================== */

.login-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: #f1f5f9;
}

.login-shell {
    width: 100%;
    max-width: 440px;
}

.login-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 32px;
    box-shadow: 0 18px 50px rgba(15, 23, 42, .10);
}

.login-brand {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 30px;
}

.login-brand-mark {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: #0f172a;
    color: #ffffff;
    font-size: 19px;
    font-weight: 800;
}

.login-brand-title {
    font-size: 15px;
    font-weight: 700;
    color: #0f172a;
}

.login-brand-school {
    margin-top: 2px;
    color: #64748b;
    font-size: 12px;
}

.login-heading {
    margin-bottom: 22px;
}

.login-heading h1 {
    margin: 0 0 7px;
    font-size: 25px;
    line-height: 1.25;
    color: #0f172a;
}

.login-heading p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.6;
}

.form-group {
    margin-bottom: 17px;
}

.form-group label {
    display: block;
    margin-bottom: 7px;
    color: #334155;
    font-size: 14px;
    font-weight: 600;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    min-height: 44px;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    padding: 10px 12px;
    background: #ffffff;
    color: #0f172a;
    font: inherit;
    transition: border-color .15s ease, box-shadow .15s ease;
}

.form-group textarea {
    min-height: 100px;
    resize: vertical;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: #64748b;
    box-shadow: 0 0 0 3px rgba(100, 116, 139, .12);
}

.btn-block {
    width: 100%;
}

.login-footer {
    margin-top: 22px;
    padding-top: 17px;
    border-top: 1px solid #e2e8f0;
    color: #94a3b8;
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
}


/* =====================================================
   RESPONSIVE
===================================================== */

@media (max-width: 1000px) {

    .dashboard-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}


@media (max-width: 900px) {

    .filter-form {
        align-items: stretch;
    }

    .filter-group,
    .filter-group:first-child {
        width: 100%;
        min-width: 100%;
    }

    .filter-action {
        width: 100%;
    }

    .filter-action .btn {
        flex: 1;
    }

    .pagination {
        flex-wrap: wrap;
    }

}


@media (max-width: 800px) {

    .form-grid,
    .detail-grid {
        grid-template-columns: 1fr;
    }

    .filter-bar {
        flex-direction: column;
        align-items: stretch;
    }

}


@media (max-width: 700px) {

    .sidebar {
        width: 210px;
    }

    .main {
        margin-left: 210px;
    }

    .topbar {
        left: 210px;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .page-header {
        flex-direction: column;
        align-items: stretch;
    }

    .page-header-actions {
        width: 100%;
    }

    .page-header-actions .btn {
        flex: 0 0 auto;
    }

    .page-header h1,
    .page-header h2 {
        font-size: 21px;
    }

    .section-title {
        margin-top: 22px;
    }

    .filter-form {
        padding: 15px;
    }

    .table-info {
        padding: 13px 15px;
    }

    .pagination {
        padding: 13px 15px;
    }

    .form-card {
        padding: 18px;
    }

}


@media (max-width: 520px) {

    .login-page {
        padding: 14px;
        align-items: flex-start;
        padding-top: 30px;
    }

    .login-card {
        padding: 24px 20px;
        border-radius: 14px;
    }

    .page-header-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .page-header-actions .btn {
        width: 100%;
    }

    .form-actions {
        flex-direction: column;
    }

    .form-actions .btn {
        width: 100%;
    }

}


/* =====================================================
   PRINT QR
===================================================== */

@media print {

    body * {
        visibility: hidden;
    }

    .qr-print-card,
    .qr-print-card * {
        visibility: visible;
    }

    .qr-print-card {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        border: 0;
    }

}

/* PART 10 pagination */
.pagination-bar{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-top:16px;padding-top:14px;border-top:1px solid #e2e8f0}.pagination{display:flex;gap:6px;flex-wrap:wrap}.pagination .btn{min-width:34px;text-align:center}.btn-danger{background:#dc2626;color:#fff;border-color:#dc2626}.btn-danger:hover{background:#b91c1c;color:#fff}

/* PART 11 bright UI accents */
.status-aktif{background:#dcfce7!important;color:#166534!important}.status-nonaktif{background:#fee2e2!important;color:#991b1b!important}.status-H,.status-h{background:#dcfce7!important;color:#166534!important}.status-T,.status-t{background:#ffedd5!important;color:#9a3412!important}.status-I,.status-i{background:#dbeafe!important;color:#1d4ed8!important}.status-S,.status-s{background:#ede9fe!important;color:#6d28d9!important}.status-A,.status-a{background:#fee2e2!important;color:#b91c1c!important}.status-belum{background:#e2e8f0!important;color:#475569!important}


/* =====================================================
   PART UI CORE — MODERN DESIGN SYSTEM
===================================================== */
:root{
    --ui-primary:#2563eb;
    --ui-primary-dark:#1d4ed8;
    --ui-ink:#0f172a;
    --ui-muted:#64748b;
    --ui-line:#e2e8f0;
    --ui-soft:#f8fafc;
    --ui-success:#16a34a;
    --ui-danger:#dc2626;
    --ui-warning:#d97706;
}

.sidebar{
    box-shadow: 8px 0 24px rgba(15,23,42,.08);
}
.sidebar-brand h2{letter-spacing:-.02em}
.sidebar-brand small{line-height:1.45}
.menu-title{letter-spacing:.08em;color:#94a3b8}
.menu-item{
    display:flex;
    align-items:center;
    gap:10px;
    padding:11px 13px;
    border:1px solid transparent;
    font-weight:500;
}
.menu-item:hover{background:#172033;border-color:rgba(148,163,184,.12)}
.menu-item.active{background:linear-gradient(135deg,#2563eb,#1d4ed8);box-shadow:0 6px 16px rgba(37,99,235,.22)}
.menu-icon{
    width:20px;
    min-width:20px;
    height:20px;
    margin:0;
    border-radius:6px;
    background:transparent;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    font-size:15px;
    color:#94a3b8;
    vertical-align:middle;
}
.menu-item:hover .menu-icon{color:#dbeafe}
.menu-item.active .menu-icon{background:rgba(255,255,255,.14);color:#fff}
.logout-item{display:flex;align-items:center;gap:10px;font-weight:600}
.logout-item .menu-icon{background:transparent}

.topbar{box-shadow:0 1px 10px rgba(15,23,42,.04)}
.topbar-title{letter-spacing:-.01em}
.content{max-width:1600px;margin:0 auto}
.page-header h1,.page-header h2{letter-spacing:-.025em}
.dashboard-card{
    border-radius:14px;
    box-shadow:0 6px 20px rgba(15,23,42,.04);
    transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;
}
.dashboard-card:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(15,23,42,.07);border-color:#dbe4f0}
.dashboard-table-card{box-shadow:0 8px 26px rgba(15,23,42,.045)}
.btn{
    border-radius:10px;
    gap:7px;
    transition:transform .15s ease,box-shadow .15s ease,background .15s ease;
}
.btn:hover{transform:translateY(-1px)}
.btn-primary{background:var(--ui-primary);box-shadow:0 4px 10px rgba(37,99,235,.16)}
.btn-primary:hover{background:var(--ui-primary-dark);box-shadow:0 6px 14px rgba(37,99,235,.2)}
.btn-secondary:hover{border-color:#94a3b8;background:#f8fafc}
.btn-danger{box-shadow:0 4px 10px rgba(220,38,38,.12)}
.btn-icon{min-width:36px!important;width:36px;height:36px;padding:0!important}
.btn-icon-sm{min-width:32px!important;width:32px;height:32px;padding:0!important}
.btn i{font-size:1em;line-height:1}
.table-actions{align-items:center}
.data-table tbody td{padding-top:14px;padding-bottom:14px}
.status-badge{border:1px solid rgba(148,163,184,.12)}
.form-control{transition:border-color .15s ease,box-shadow .15s ease}
.form-control:focus{border-color:#60a5fa;box-shadow:0 0 0 4px rgba(37,99,235,.10)}
.empty-state{color:#64748b}

@media (max-width:700px){
    .menu-item{padding:10px 11px}
    .content{padding:18px}
}

/* Outline action used by scanner */
.btn-outline-primary{background:#fff;color:#2563eb;border-color:#93c5fd}
.btn-outline-primary:hover{background:#eff6ff;color:#1d4ed8;border-color:#60a5fa}

/* Student master cards */
.dashboard-card .card-icon{width:40px;height:40px;border-radius:11px;display:inline-flex;align-items:center;justify-content:center;background:#eff6ff;color:#2563eb;margin-bottom:10px;font-size:18px}
.dashboard-card .card-icon i{line-height:1}

/* =====================================================
   SISWA PICKER - Pencarian cepat untuk sekolah 700+ siswa
===================================================== */
.student-picker{position:relative}.student-picker-toolbar{display:grid;grid-template-columns:minmax(0,2fr) minmax(180px,1fr);gap:10px;margin-bottom:10px}.student-picker-results{display:grid;gap:7px;max-height:310px;overflow:auto;padding:4px;border:1px solid #d7e0ec;border-radius:12px;background:#f8fafc}.student-picker-result{width:100%;border:1px solid #e2e8f0;background:#fff;border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:10px;text-align:left;cursor:pointer;color:#0f172a}.student-picker-result:hover{border-color:#2563eb;box-shadow:0 3px 12px rgba(15,23,42,.08)}.student-picker-result>span:nth-child(2){min-width:0;flex:1}.student-picker-result strong,.student-picker-result small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.student-picker-result small{margin-top:2px;color:#64748b}.student-picker-avatar{width:34px;height:34px;min-width:34px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;background:#e8eefc;color:#1d4ed8}.student-picker-selected-card{display:flex;align-items:center;gap:10px;padding:10px 12px;margin-bottom:10px;border:1px solid #bfdbfe;background:#eff6ff;border-radius:12px}.student-picker-selected-card>div:nth-child(2){min-width:0;flex:1}.student-picker-selected-card strong,.student-picker-selected-card div:nth-child(2)>div{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.student-picker-selected-card div:nth-child(2)>div{font-size:12px;color:#475569;margin-top:2px}.student-picker-clear{border:0;background:transparent;color:#64748b;cursor:pointer;padding:7px}.student-picker-clear:hover{color:#dc2626}.student-picker-empty,.student-picker-more{padding:12px;text-align:center;color:#64748b;font-size:13px}.student-picker-help{display:block;color:#64748b;margin-top:6px;font-size:12px}@media(max-width:700px){.student-picker-toolbar{grid-template-columns:1fr}.student-picker-results{max-height:260px}}


/* =====================================================
   PART58 - ROLE & TUGAS TAMBAHAN DI SIDEBAR
===================================================== */
.sidebar-role-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 9px;
    padding: 5px 9px;
    border: 1px solid rgba(148,163,184,.18);
    border-radius: 999px;
    color: #dbeafe;
    background: rgba(37,99,235,.16);
    font-size: 10px;
    font-weight: 700;
    line-height: 1.2;
}
.sidebar-role-badge i { color: #93c5fd; }
.sidebar-task-list { display:flex; flex-wrap:wrap; gap:5px; margin-top:7px; }
.sidebar-task-badge {
    display:inline-flex; align-items:center; max-width:100%;
    padding:4px 7px; border-radius:6px;
    color:#cbd5e1; background:rgba(255,255,255,.055);
    font-size:9px; font-weight:600; line-height:1.25;
}


/* =====================================================
   PART61 — ROLE-BASED SIDEBAR COLORS
   ===================================================== */
.sidebar{
    --sidebar-primary:#334155;
    --sidebar-deep:#0f172a;
    --sidebar-soft:#1e293b;
    --sidebar-active:#475569;
    background:linear-gradient(180deg,var(--sidebar-deep) 0%,var(--sidebar-soft) 100%);
}
.sidebar-role-admin{--sidebar-primary:#6366f1;--sidebar-deep:#111827;--sidebar-soft:#1e1b4b;--sidebar-active:#4f46e5}
.sidebar-role-kepala_sekolah{--sidebar-primary:#10b981;--sidebar-deep:#052e2b;--sidebar-soft:#064e3b;--sidebar-active:#059669}
.sidebar-role-guru{--sidebar-primary:#3b82f6;--sidebar-deep:#0b1f3a;--sidebar-soft:#102f59;--sidebar-active:#2563eb}
.sidebar-role-guru_bk{--sidebar-primary:#8b5cf6;--sidebar-deep:#21113f;--sidebar-soft:#3b1768;--sidebar-active:#7c3aed}
.sidebar-role-tu{--sidebar-primary:#f59e0b;--sidebar-deep:#2d1b05;--sidebar-soft:#5a3507;--sidebar-active:#d97706}
.sidebar-role-siswa{--sidebar-primary:#06b6d4;--sidebar-deep:#062a33;--sidebar-soft:#084957;--sidebar-active:#0891b2}
.sidebar-role-ortu{--sidebar-primary:#f97316;--sidebar-deep:#321306;--sidebar-soft:#612007;--sidebar-active:#ea580c}
.sidebar-role-default{--sidebar-primary:#64748b;--sidebar-deep:#0f172a;--sidebar-soft:#1e293b;--sidebar-active:#475569}
.sidebar .sidebar-brand{border-bottom-color:rgba(255,255,255,.10)}
.sidebar .menu-title{color:rgba(255,255,255,.62)}
.sidebar .menu-item:hover{background:rgba(255,255,255,.09);border-color:rgba(255,255,255,.08)}
.sidebar .menu-item.active{background:linear-gradient(135deg,var(--sidebar-primary),var(--sidebar-active));box-shadow:0 7px 18px color-mix(in srgb,var(--sidebar-primary) 28%,transparent)}
.sidebar .menu-item.active .menu-icon{background:rgba(255,255,255,.18)}
.sidebar .sidebar-role-badge{border-color:color-mix(in srgb,var(--sidebar-primary) 45%,white 8%);background:color-mix(in srgb,var(--sidebar-primary) 24%,transparent);color:#fff}
.sidebar .sidebar-role-badge i{color:#fff}
.sidebar .sidebar-task-badge{border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.08);color:#fff}
.sidebar .sidebar-bottom{background:transparent;border-top-color:rgba(255,255,255,.10)}
.sidebar .logout-item:hover{background:rgba(220,38,38,.35)}


/* =====================================================
   PART63 — UI-18 ICON ALIGNMENT & SIDEBAR CONSISTENCY
   Presentation only: no menu logic/permission changes.
===================================================== */
.sidebar .menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
}

.sidebar .menu-icon {
    flex: 0 0 22px;
    width: 22px;
    min-width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    font-size: 15px;
}

.sidebar .menu-icon i {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1em;
    height: 1em;
    line-height: 1;
}

.sidebar .menu-label {
    flex: 1 1 auto;
    min-width: 0;
    line-height: 1.3;
}

.sidebar .menu-item-sub {
    padding-left: 24px;
}

.sidebar .menu-item-sub .menu-icon {
    flex-basis: 20px;
    width: 20px;
    min-width: 20px;
}


/* =====================================================
   PART64 UI-03 — CONSISTENT PAGE LAYOUT
   Presentation only: no business logic changes.
===================================================== */

/* Consistent page rhythm */
.content {
    padding: 24px;
}

.page-header {
    margin-bottom: 18px;
}

.page-header-actions {
    align-items: center;
    justify-content: flex-end;
}

/* Keep action groups usable when several buttons are present */
.page-header-actions .btn {
    min-height: 38px;
}

/* Standard content surfaces */
.content > .card,
.content > .dashboard-table-card,
.content > .form-card {
    border: 1px solid var(--ui-line, #e2e8f0);
    border-radius: 14px;
}

/* Tables: modern zebra rows + clear hover state */
.data-table tbody tr:nth-child(even) {
    background: #f8fafc;
}

.data-table tbody tr:nth-child(odd) {
    background: #ffffff;
}

.data-table tbody tr:hover {
    background: #eef4ff;
}

.data-table thead th {
    position: relative;
}

/* Keep table action groups compact and non-forcing */
.table-actions {
    min-width: max-content;
}

/* Pagination remains flexible instead of forcing one row */
.pagination-bar {
    align-items: center;
}

.pagination-bar > * {
    min-width: 0;
}

/* Responsive page header */
@media (max-width: 900px) {
    .page-header {
        align-items: stretch;
        flex-direction: column;
        gap: 12px;
    }

    .page-header-actions {
        justify-content: flex-start;
    }
}

@media (max-width: 700px) {
    .content {
        padding: 16px;
    }

    .page-header {
        margin-bottom: 14px;
    }

    .page-header h1,
    .page-header h2 {
        font-size: 21px;
    }

    .page-header-actions {
        width: 100%;
    }

    .page-header-actions .btn {
        flex: 0 0 auto;
    }

    .data-table {
        min-width: 760px;
    }
}


/* =====================================================
   PART65 UI-04 — MODERN ACTION BUTTONS
   Presentation only: no business logic changes.
===================================================== */

/* Semantic button system */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    border-radius: 9px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    transition: transform .12s ease, box-shadow .12s ease, background-color .12s ease;
}

.btn > .bi,
.btn > i {
    flex: 0 0 auto;
    line-height: 1;
}

.btn:hover {
    transform: translateY(-1px);
}

.btn:active {
    transform: translateY(0);
}

.btn:focus-visible {
    outline: 3px solid rgba(59, 130, 246, .22);
    outline-offset: 2px;
}

/* Primary actions: save, add, submit, continue */
.btn-primary {
    box-shadow: 0 2px 5px rgba(37, 99, 235, .14);
}

/* Destructive actions */
.btn-danger {
    box-shadow: 0 2px 5px rgba(220, 38, 38, .10);
}

/* Secondary/neutral actions */
.btn-secondary,
.btn-light {
    box-shadow: 0 1px 3px rgba(15, 23, 42, .06);
}

/* Compact icon-only actions: suitable for dense tables */
.btn-icon,
.table-actions .btn {
    width: auto;
    min-width: 36px;
    min-height: 36px;
    padding: .45rem .65rem;
}

.table-actions {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
}

/* Do not force large buttons in dense toolbars */
.toolbar,
.page-header-actions,
.form-actions,
.card-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
}

.toolbar .btn,
.page-header-actions .btn,
.form-actions .btn,
.card-actions .btn {
    flex: 0 0 auto;
}

/* Buttons that intentionally carry more context can be wider */
.btn-action-wide {
    min-width: 120px;
}

/* Mobile: let action groups wrap instead of overflowing */
@media (max-width: 700px) {
    .toolbar,
    .page-header-actions,
    .form-actions,
    .card-actions {
        align-items: stretch;
    }

    .toolbar .btn,
    .page-header-actions .btn,
    .form-actions .btn,
    .card-actions .btn {
        max-width: 100%;
    }

    .btn-action-wide {
        min-width: 0;
    }
}


/* =====================================================
   PART66 UI-05 — TOOLBAR / SEARCH / FILTER LAYOUT
   Presentation only: no business logic changes.
===================================================== */

/* Flexible action/search/filter rows */
.toolbar,
.list-toolbar,
.page-tools,
.search-toolbar,
.filter-toolbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
}

/* Separate primary actions from utility controls when both exist */
.toolbar-main,
.toolbar-actions,
.page-tools-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
}

.toolbar-filters,
.page-tools-filters,
.search-tools {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
}

/* Search fields get room, but never force the entire toolbar wider */
.toolbar-search,
.search-box,
.search-group {
    flex: 1 1 240px;
    min-width: 180px;
    max-width: 420px;
}

.toolbar-search input,
.search-box input,
.search-group input {
    width: 100%;
}

/* Filter controls remain compact and can wrap naturally */
.toolbar-filters .form-select,
.toolbar-filters .form-control,
.filter-toolbar .form-select,
.filter-toolbar .form-control {
    min-width: 140px;
    max-width: 240px;
}

/* Avoid awkward full-width selects on normal desktop */
@media (min-width: 901px) {
    .toolbar .btn,
    .list-toolbar .btn,
    .page-tools .btn {
        flex: 0 0 auto;
    }
}

/* Small screens: stack logically, not mechanically */
@media (max-width: 700px) {
    .toolbar,
    .list-toolbar,
    .page-tools,
    .search-toolbar,
    .filter-toolbar {
        align-items: stretch;
    }

    .toolbar-main,
    .toolbar-actions,
    .page-tools-actions,
    .toolbar-filters,
    .page-tools-filters,
    .search-tools {
        width: 100%;
    }

    .toolbar-search,
    .search-box,
    .search-group {
        flex-basis: 100%;
        max-width: none;
        min-width: 0;
    }

    .toolbar-filters .form-select,
    .toolbar-filters .form-control,
    .filter-toolbar .form-select,
    .filter-toolbar .form-control {
        flex: 1 1 160px;
        max-width: none;
    }
}

/* Prevent pagination/control groups from colliding */
.pagination-bar,
.table-footer,
.list-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
}

@media (max-width: 700px) {
    .pagination-bar,
    .table-footer,
    .list-footer {
        justify-content: flex-start;
    }
}


/* =====================================================
   PART67 UI-06 — MODERN FORM LAYOUT
   Presentation only: no field/logic changes.
===================================================== */

/* Form rhythm and readable grouping */
.form-card .form-group,
.form-section,
.form-row {
    margin-bottom: 14px;
}

.form-card label,
.form-section label,
form label {
    display: inline-block;
    margin-bottom: 6px;
    font-weight: 600;
    line-height: 1.35;
}

/* Consistent controls without changing their semantics */
.form-control,
.form-select,
textarea.form-control,
input.form-control {
    min-height: 40px;
    border-radius: 9px;
}

textarea.form-control {
    min-height: 96px;
    resize: vertical;
}

.form-control:focus,
.form-select:focus {
    box-shadow: 0 0 0 3px rgba(59, 130, 246, .12);
}

/* Keep helper text visually secondary */
.form-text,
.form-help,
.help-text {
    margin-top: 5px;
    font-size: .82rem;
    line-height: 1.45;
}

/* Validation should be readable, not disruptive */
.invalid-feedback,
.form-error,
.field-error {
    margin-top: 5px;
    font-size: .82rem;
    line-height: 1.4;
}

/* Form action area: buttons wrap according to available width */
.form-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
    padding-top: 14px;
}

.form-actions .btn {
    flex: 0 0 auto;
}

/* Common two-column form grids when existing markup provides these classes */
.form-grid,
.form-row-grid,
.form-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.form-grid .full-width,
.form-row-grid .full-width,
.form-fields .full-width {
    grid-column: 1 / -1;
}

/* Avoid overly wide form controls on large screens */
.form-card form,
.form-section form {
    max-width: 100%;
}

/* Mobile: one logical field per row */
@media (max-width: 700px) {
    .form-grid,
    .form-row-grid,
    .form-fields {
        grid-template-columns: 1fr;
    }

    .form-grid .full-width,
    .form-row-grid .full-width,
    .form-fields .full-width {
        grid-column: auto;
    }

    .form-actions {
        justify-content: flex-start;
    }
}


/* =====================================================
   PART68 UI-07 — FEEDBACK, ALERT, BADGE & MODAL POLISH
   Presentation only: no business logic changes.
===================================================== */

/* Alerts / flash messages */
.alert {
    border-radius: 10px;
    border-width: 1px;
    padding: .75rem .9rem;
    display: flex;
    align-items: flex-start;
    gap: .6rem;
}

.alert .bi,
.alert > i {
    flex: 0 0 auto;
    margin-top: .1rem;
}

.alert-dismissible {
    padding-right: 2.75rem;
}

/* Semantic status badges */
.badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .3rem;
    min-height: 24px;
    padding: .28rem .55rem;
    border-radius: 999px;
    font-weight: 600;
    line-height: 1.1;
    white-space: nowrap;
}

.status-badge,
.badge-status {
    min-width: 76px;
}

/* Common active/inactive states where existing markup uses these classes */
.badge-success,
.badge-active,
.status-active {
    font-weight: 600;
}

.badge-danger,
.badge-inactive,
.status-inactive {
    font-weight: 600;
}

/* Modal: readable hierarchy and comfortable spacing */
.modal-content {
    border: 0;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 18px 45px rgba(15, 23, 42, .18);
}

.modal-header {
    padding: 1rem 1.15rem;
    border-bottom: 1px solid rgba(148, 163, 184, .22);
    align-items: center;
}

.modal-title {
    font-weight: 700;
    line-height: 1.3;
}

.modal-body {
    padding: 1.15rem;
}

.modal-footer {
    padding: .85rem 1.15rem;
    gap: 8px;
    flex-wrap: wrap;
    border-top: 1px solid rgba(148, 163, 184, .22);
}

.modal-footer .btn {
    flex: 0 0 auto;
}

/* Confirmation dialogs: danger action remains visually distinct */
.modal-footer .btn-danger {
    font-weight: 700;
}

/* Loading / processing feedback */
.loading,
.is-loading,
.processing {
    opacity: .78;
    cursor: wait;
}

.spinner-border,
.spinner-grow {
    flex: 0 0 auto;
}

/* Empty states */
.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 32px 20px;
    text-align: center;
}

.empty-state .bi,
.empty-state > i {
    font-size: 2rem;
    opacity: .65;
}

/* Small screens: modals and feedback remain usable */
@media (max-width: 700px) {
    .modal-dialog {
        margin: .75rem;
    }

    .modal-footer {
        justify-content: flex-start;
    }

    .modal-footer .btn {
        max-width: 100%;
    }

    .alert {
        padding: .7rem .8rem;
    }
}


/* =====================================================
   PART69 UI-08 — RESPONSIVE / MOBILE POLISH
   Presentation only: no business logic changes.
===================================================== */

/* Main content should not create accidental horizontal overflow */
html,
body {
    max-width: 100%;
    overflow-x: hidden;
}

.content {
    min-width: 0;
}

/* Cards and dashboard grids should shrink naturally */
.card,
.dashboard-card,
.stat-card,
.form-card,
.table-card {
    min-width: 0;
}

.card-body {
    min-width: 0;
}

/* Tables scroll horizontally instead of breaking the page */
.table-responsive {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}

/* Mobile-friendly controls */
@media (max-width: 700px) {
    .content {
        padding: 14px;
    }

    .card-header,
    .card-body,
    .card-footer {
        padding-left: 14px;
        padding-right: 14px;
    }

    .card-header {
        gap: 10px;
        flex-wrap: wrap;
    }

    .dashboard-grid,
    .stats-grid,
    .card-grid {
        grid-template-columns: 1fr;
    }

    /* Keep dashboard numbers readable without oversized cards */
    .stat-card,
    .dashboard-card {
        width: 100%;
    }

    /* Long text should wrap rather than force horizontal overflow */
    .page-header h1,
    .page-header h2,
    .card-title,
    .table td,
    .table th {
        overflow-wrap: anywhere;
    }

    /* Form controls remain tappable */
    .form-control,
    .form-select,
    .btn {
        min-height: 40px;
    }

    /* Avoid tiny icon actions on touch devices */
    .table-actions .btn,
    .btn-icon {
        min-width: 40px;
        min-height: 40px;
    }

    /* Pagination can wrap cleanly */
    .pagination {
        flex-wrap: wrap;
    }

    /* Sidebar content must not force viewport width */
    .sidebar,
    .app-sidebar,
    .sidebar-nav {
        max-width: 100%;
    }
}

/* Very small phones */
@media (max-width: 420px) {
    .content {
        padding: 10px;
    }

    .page-header h1,
    .page-header h2 {
        font-size: 19px;
    }

    .btn {
        font-size: .88rem;
    }

    .badge {
        max-width: 100%;
        white-space: normal;
        text-align: center;
    }
}


/* =====================================================
   PART70 UI-09 — DASHBOARD / STAT CARD POLISH
   Presentation only: no data or business logic changes.
===================================================== */

/* Dashboard/stat cards: clear hierarchy without oversized boxes */
.stat-card,
.dashboard-card {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(148, 163, 184, .22);
    min-height: 118px;
    transition: transform .15s ease, box-shadow .15s ease;
}

.stat-card:hover,
.dashboard-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(15, 23, 42, .08);
}

/* Accent strip can be supplied by existing semantic classes */
.stat-card::before,
.dashboard-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    border-radius: 14px 0 0 14px;
    background: currentColor;
    opacity: .65;
}

/* Numbers should be prominent but not dominate the page */
.stat-card .stat-value,
.stat-card .value,
.dashboard-card .stat-value,
.dashboard-card .value {
    font-size: clamp(1.45rem, 2.2vw, 2rem);
    font-weight: 750;
    line-height: 1.1;
    letter-spacing: -.02em;
}

/* Labels and supporting information */
.stat-card .stat-label,
.stat-card .label,
.dashboard-card .stat-label,
.dashboard-card .label {
    font-size: .82rem;
    font-weight: 600;
    line-height: 1.35;
    opacity: .78;
}

.stat-card .stat-icon,
.dashboard-card .stat-icon {
    width: 42px;
    height: 42px;
    min-width: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    font-size: 1.15rem;
}

/* Dashboard sections have clear separation */
.dashboard-section {
    margin-bottom: 20px;
}

.dashboard-section:last-child {
    margin-bottom: 0;
}

/* Card titles */
.dashboard-section .card-title,
.dashboard-card .card-title {
    font-weight: 700;
}

/* Dashboard grids stay balanced */
@media (min-width: 701px) {
    .stats-grid,
    .dashboard-grid {
        align-items: stretch;
    }
}

@media (max-width: 700px) {
    .stat-card,
    .dashboard-card {
        min-height: 104px;
    }

    .stat-card .stat-icon,
    .dashboard-card .stat-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
    }
}


/* =====================================================
   PART71 UI-10 — DATA TABLE READABILITY
   Presentation only: no query/data/logic changes.
===================================================== */

/* Table surface */
.table-card,
.data-table-card {
    overflow: hidden;
}

.table-responsive {
    border-radius: 10px;
}

/* Clear table header hierarchy */
.data-table thead th,
.table thead th {
    font-weight: 700;
    font-size: .78rem;
    line-height: 1.3;
    letter-spacing: .01em;
    vertical-align: middle;
    white-space: nowrap;
}

/* Comfortable body rows */
.data-table tbody td,
.table tbody td {
    vertical-align: middle;
    line-height: 1.4;
}

/* Common alignment helpers */
.text-number,
.col-number,
th.number,
td.number {
    text-align: right;
    font-variant-numeric: tabular-nums;
}

.text-center,
.col-center {
    text-align: center;
}

/* Action column should remain compact */
.data-table th:last-child,
.data-table td:last-child {
    white-space: nowrap;
}

/* Status cells */
.data-table td .badge,
.table td .badge {
    vertical-align: middle;
}

/* Don't let long names/descriptions destroy the table */
.data-table td,
.table td {
    overflow-wrap: anywhere;
}

/* Empty table state */
.data-table .empty-state,
.table .empty-state {
    min-height: 150px;
}

/* Dense tables remain usable */
.table-sm thead th {
    padding-top: .6rem;
    padding-bottom: .6rem;
}

/* Mobile table: preserve data integrity, allow horizontal scrolling */
@media (max-width: 700px) {
    .data-table,
    .table {
        min-width: 680px;
    }

    .data-table thead th,
    .table thead th {
        font-size: .76rem;
    }

    .data-table tbody td,
    .table tbody td {
        padding-top: .65rem;
        padding-bottom: .65rem;
    }

    .data-table th:last-child,
    .data-table td:last-child {
        position: sticky;
        right: 0;
        z-index: 1;
        background: inherit;
    }
}


/* =====================================================
   PART72 UI-11 — PAGINATION
   Presentation only: no pagination/query logic changes.
===================================================== */

/* Pagination container */
.pagination-bar,
.table-footer,
.list-footer {
    gap: 12px;
}

/* Bootstrap pagination remains compact and readable */
.pagination {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
}

.pagination .page-item {
    margin: 0;
}

.pagination .page-link {
    min-width: 36px;
    min-height: 36px;
    padding: .42rem .65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-weight: 600;
    line-height: 1;
}

.pagination .page-item.active .page-link {
    font-weight: 700;
}

.pagination .page-item.disabled .page-link {
    opacity: .55;
}

/* Results-per-page controls */
.pagination-size,
.page-size,
.per-page {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
}

.pagination-size label,
.page-size label,
.per-page label {
    margin: 0;
    font-size: .82rem;
    font-weight: 600;
    white-space: nowrap;
}

.pagination-size .form-select,
.page-size .form-select,
.per-page .form-select {
    width: auto;
    min-width: 76px;
    min-height: 36px;
    padding-top: .35rem;
    padding-bottom: .35rem;
    border-radius: 8px;
}

/* Keep pagination information visually secondary */
.pagination-info,
.page-info,
.pagination-summary {
    font-size: .82rem;
    line-height: 1.4;
    opacity: .76;
}

/* Mobile: controls wrap rather than collide */
@media (max-width: 700px) {
    .pagination-bar,
    .table-footer,
    .list-footer {
        align-items: flex-start;
    }

    .pagination {
        max-width: 100%;
    }

    .pagination .page-link {
        min-width: 34px;
        min-height: 36px;
        padding-left: .55rem;
        padding-right: .55rem;
    }

    .pagination-size,
    .page-size,
    .per-page,
    .pagination-info,
    .page-info,
    .pagination-summary {
        width: 100%;
    }
}


/* =====================================================
   PART73 UI-12 — SEARCH & FILTER USABILITY
   Presentation only: no search/filter/query logic changes.
===================================================== */

/* Search/filter surfaces */
.search-toolbar,
.filter-toolbar,
.toolbar-filters,
.page-tools-filters {
    align-items: flex-end;
}

/* Give labels a clear relationship to their controls */
.search-toolbar label,
.filter-toolbar label,
.toolbar-filters label,
.page-tools-filters label {
    display: block;
    margin-bottom: 5px;
    font-size: .78rem;
    font-weight: 700;
    line-height: 1.25;
}

/* Search input with icon area */
.search-box,
.search-group,
.toolbar-search {
    position: relative;
}

.search-box .bi,
.search-group .bi,
.toolbar-search .bi {
    color: currentColor;
    opacity: .55;
}

/* Inputs/selects in filter rows */
.search-toolbar .form-control,
.search-toolbar .form-select,
.filter-toolbar .form-control,
.filter-toolbar .form-select,
.toolbar-filters .form-control,
.toolbar-filters .form-select {
    min-height: 40px;
    border-radius: 9px;
}

/* Search submit/reset controls remain compact */
.search-toolbar .btn,
.filter-toolbar .btn,
.toolbar-filters .btn {
    min-height: 40px;
}

/* Reset/filter actions should not overpower the search */
.filter-toolbar .btn-light,
.filter-toolbar .btn-secondary,
.toolbar-filters .btn-light,
.toolbar-filters .btn-secondary {
    font-weight: 600;
}

/* Active filter indicator when markup provides it */
.filter-active,
.has-filter,
.active-filter {
    font-weight: 700;
}

/* Filter summary/chips */
.filter-summary,
.filter-chips {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
}

.filter-summary .badge,
.filter-chips .badge {
    min-height: 28px;
}

/* On mobile, each logical control gets adequate touch width */
@media (max-width: 700px) {
    .search-toolbar,
    .filter-toolbar,
    .toolbar-filters,
    .page-tools-filters {
        align-items: stretch;
    }

    .search-toolbar > *,
    .filter-toolbar > *,
    .toolbar-filters > *,
    .page-tools-filters > * {
        min-width: 0;
    }

    .search-toolbar .form-control,
    .search-toolbar .form-select,
    .filter-toolbar .form-control,
    .filter-toolbar .form-select,
    .toolbar-filters .form-control,
    .toolbar-filters .form-select {
        width: 100%;
    }

    .search-toolbar .btn,
    .filter-toolbar .btn,
    .toolbar-filters .btn {
        min-width: 40px;
    }

    .filter-summary,
    .filter-chips {
        width: 100%;
    }
}


/* =====================================================
   PART74 UI-13 — XLSX IMPORT UX
   Presentation only: no import logic/template changes.
===================================================== */

/* Import area / card */
.import-card,
.import-panel,
.upload-card {
    border-radius: 14px;
    border: 1px solid rgba(148, 163, 184, .22);
}

.import-card .card-body,
.import-panel .card-body,
.upload-card .card-body {
    padding: 18px;
}

/* Import steps */
.import-steps,
.upload-steps {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 18px;
}

.import-step,
.upload-step {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    font-size: .82rem;
    font-weight: 700;
}

.import-step-number,
.upload-step-number {
    width: 30px;
    height: 30px;
    min-width: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: .78rem;
}

/* File picker area */
.file-upload-area,
.upload-dropzone {
    border: 1px dashed rgba(100, 116, 139, .45);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    transition: border-color .15s ease, background-color .15s ease;
}

.file-upload-area:hover,
.upload-dropzone:hover {
    border-color: rgba(59, 130, 246, .6);
    background: rgba(59, 130, 246, .035);
}

.file-upload-area .bi,
.upload-dropzone .bi {
    font-size: 1.7rem;
    margin-bottom: 7px;
}

/* Selected file information */
.selected-file,
.file-selected,
.upload-file-info {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
    margin-top: 10px;
    padding: 9px 11px;
    border-radius: 9px;
    font-size: .84rem;
}

/* Import result summary */
.import-summary,
.upload-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 16px;
}

.import-summary-item,
.upload-summary-item {
    padding: 11px 12px;
    border-radius: 10px;
    border: 1px solid rgba(148, 163, 184, .2);
}

.import-summary-item .value,
.upload-summary-item .value {
    display: block;
    font-size: 1.25rem;
    font-weight: 750;
    line-height: 1.1;
}

.import-summary-item .label,
.upload-summary-item .label {
    display: block;
    margin-top: 4px;
    font-size: .78rem;
    opacity: .75;
}

/* Import validation/error list */
.import-errors,
.upload-errors {
    margin-top: 12px;
    border-radius: 10px;
    padding: 11px 13px;
}

.import-errors ul,
.upload-errors ul {
    margin: 7px 0 0;
    padding-left: 20px;
}

.import-errors li,
.upload-errors li {
    margin-bottom: 4px;
    line-height: 1.4;
}

/* Template download/action row */
.import-actions,
.upload-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 15px;
}

@media (max-width: 700px) {
    .import-steps,
    .upload-steps {
        flex-direction: column;
    }

    .import-summary,
    .upload-summary {
        grid-template-columns: 1fr;
    }

    .file-upload-area,
    .upload-dropzone {
        padding: 16px 12px;
    }

    .import-actions,
    .upload-actions {
        align-items: stretch;
    }

    .import-actions .btn,
    .upload-actions .btn {
        max-width: 100%;
    }
}


/* =====================================================
   PART75 UI-14 — DETAIL / PROFILE PAGE LAYOUT
   Presentation only: no data/query/logic changes.
===================================================== */

/* Detail page surface */
.detail-card,
.profile-card,
.detail-panel {
    border-radius: 14px;
    border: 1px solid rgba(148, 163, 184, .22);
    overflow: hidden;
}

/* Identity header */
.profile-header,
.detail-header {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 18px;
}

.profile-avatar,
.detail-avatar {
    width: 58px;
    height: 58px;
    min-width: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    font-size: 1.35rem;
    font-weight: 750;
}

.profile-identity,
.detail-identity {
    min-width: 0;
    flex: 1 1 220px;
}

.profile-identity h1,
.profile-identity h2,
.detail-identity h1,
.detail-identity h2 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 750;
    line-height: 1.25;
    overflow-wrap: anywhere;
}

.profile-identity .meta,
.detail-identity .meta {
    margin-top: 4px;
    font-size: .84rem;
    opacity: .76;
}

/* Detail actions stay separate from identity */
.profile-header-actions,
.detail-header-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-left: auto;
}

/* Information groups */
.detail-section,
.profile-section {
    padding: 18px;
    border-top: 1px solid rgba(148, 163, 184, .18);
}

.detail-section-title,
.profile-section-title {
    margin: 0 0 12px;
    font-size: .92rem;
    font-weight: 750;
    line-height: 1.3;
}

/* Key/value information */
.detail-grid,
.profile-info-grid,
.info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 18px;
}

.detail-item,
.profile-info-item,
.info-item {
    min-width: 0;
    padding: 9px 0;
}

.detail-item .label,
.profile-info-item .label,
.info-item .label {
    display: block;
    margin-bottom: 3px;
    font-size: .76rem;
    font-weight: 700;
    opacity: .68;
}

.detail-item .value,
.profile-info-item .value,
.info-item .value {
    display: block;
    font-weight: 600;
    line-height: 1.45;
    overflow-wrap: anywhere;
}

/* History/activity inside detail pages */
.detail-history,
.profile-history,
.detail-timeline {
    margin-top: 0;
}

/* Responsive detail pages */
@media (max-width: 700px) {
    .profile-header,
    .detail-header,
    .detail-section,
    .profile-section {
        padding: 14px;
    }

    .profile-header-actions,
    .detail-header-actions {
        width: 100%;
        margin-left: 0;
        justify-content: flex-start;
    }

    .detail-grid,
    .profile-info-grid,
    .info-grid {
        grid-template-columns: 1fr;
    }

    .profile-avatar,
    .detail-avatar {
        width: 50px;
        height: 50px;
        min-width: 50px;
    }
}


/* =====================================================
   PART76 UI-15 — REPORT / PRINT LAYOUT
   Presentation only: no report/query/export logic changes.
===================================================== */

/* Report page hierarchy */
.report-page,
.report-container {
    min-width: 0;
}

.report-header,
.report-title {
    margin-bottom: 16px;
}

.report-header h1,
.report-title h1,
.report-header h2,
.report-title h2 {
    margin-bottom: 4px;
    font-weight: 750;
}

.report-meta {
    font-size: .82rem;
    line-height: 1.45;
    opacity: .72;
}

/* Report controls: filters and actions stay separate from results */
.report-toolbar,
.report-filters,
.report-actions {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 9px;
}

.report-toolbar {
    justify-content: space-between;
    margin-bottom: 16px;
}

.report-filters,
.report-actions {
    min-width: 0;
}

.report-filters label {
    display: block;
    margin-bottom: 5px;
    font-size: .77rem;
    font-weight: 700;
}

.report-filters .form-control,
.report-filters .form-select {
    min-height: 40px;
    border-radius: 9px;
}

/* Preview/result surface */
.report-preview,
.report-card {
    border: 1px solid rgba(148, 163, 184, .22);
    border-radius: 14px;
    overflow: hidden;
}

.report-preview-header,
.report-card-header {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(148, 163, 184, .18);
}

.report-preview-body,
.report-card-body {
    padding: 16px;
}

/* Print document identity */
.print-header {
    text-align: center;
    margin-bottom: 16px;
}

.print-header .school-name {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.3;
}

.print-header .document-title {
    margin-top: 3px;
    font-size: 1rem;
    font-weight: 700;
}

.print-header .document-meta {
    margin-top: 3px;
    font-size: .8rem;
}

/* Print table readability */
.print-document table {
    width: 100%;
    border-collapse: collapse;
}

.print-document th,
.print-document td {
    padding: 6px 7px;
    vertical-align: middle;
}

.print-document th {
    font-weight: 700;
}

/* Hide application-only controls when printing */
@media print {
    @page {
        margin: 12mm;
    }

    html,
    body {
        overflow: visible !important;
        width: 100% !important;
        background: #fff !important;
    }

    .sidebar,
    .app-sidebar,
    .topbar,
    .navbar,
    .page-header-actions,
    .toolbar,
    .report-toolbar,
    .report-filters,
    .report-actions,
    .pagination,
    .pagination-bar,
    .no-print,
    .print-hide {
        display: none !important;
    }

    .content,
    .main-content,
    .page-content,
    .report-page,
    .report-container {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow: visible !important;
    }

    .report-preview,
    .report-card {
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
    }

    .report-preview-header,
    .report-card-header {
        padding: 0 0 8px !important;
        border-bottom: 0 !important;
    }

    .report-preview-body,
    .report-card-body {
        padding: 0 !important;
    }

    .print-document {
        display: block !important;
        width: 100% !important;
        color: #000 !important;
        background: #fff !important;
    }

    .print-document table {
        page-break-inside: auto;
    }

    .print-document tr {
        page-break-inside: avoid;
        page-break-after: auto;
    }

    .print-document thead {
        display: table-header-group;
    }

    .print-document tfoot {
        display: table-footer-group;
    }

    .print-document th,
    .print-document td {
        border: 1px solid #777 !important;
        color: #000 !important;
    }

    .print-document a {
        color: #000 !important;
        text-decoration: none !important;
    }
}

/* Mobile report controls */
@media (max-width: 700px) {
    .report-toolbar {
        align-items: stretch;
        justify-content: flex-start;
    }

    .report-filters,
    .report-actions {
        width: 100%;
        align-items: stretch;
    }

    .report-filters > *,
    .report-actions > * {
        min-width: 0;
    }

    .report-filters .form-control,
    .report-filters .form-select {
        width: 100%;
    }

    .report-preview-body,
    .report-card-body {
        padding: 12px;
    }
}


/* =====================================================
   PART77 UI-16 — MODULE COLOR / STATUS CONSISTENCY
   Presentation only: no role/data/logic changes.
===================================================== */

/* Semantic color tokens */
:root {
    --module-primary: #2563eb;
    --module-success: #16a34a;
    --module-warning: #d97706;
    --module-danger: #dc2626;
    --module-info: #0891b2;
    --module-neutral: #64748b;
}

/* Module identity helpers */
.module-accent-primary { color: var(--module-primary); }
.module-accent-success { color: var(--module-success); }
.module-accent-warning { color: var(--module-warning); }
.module-accent-danger { color: var(--module-danger); }
.module-accent-info { color: var(--module-info); }
.module-accent-neutral { color: var(--module-neutral); }

/* Semantic status indicators */
.status-dot {
    width: 8px;
    height: 8px;
    min-width: 8px;
    display: inline-block;
    border-radius: 50%;
    vertical-align: middle;
}

.status-dot-success { background: var(--module-success); }
.status-dot-warning { background: var(--module-warning); }
.status-dot-danger { background: var(--module-danger); }
.status-dot-info { background: var(--module-info); }
.status-dot-neutral { background: var(--module-neutral); }

/* Status labels */
.status-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 650;
    line-height: 1.2;
}

/* Module cards may use a semantic accent without recoloring the whole card */
.module-card {
    position: relative;
    overflow: hidden;
}

.module-card-accent-primary::before,
.module-card-accent-success::before,
.module-card-accent-warning::before,
.module-card-accent-danger::before,
.module-card-accent-info::before,
.module-card-accent-neutral::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    border-radius: 14px 0 0 14px;
}

.module-card-accent-primary::before { background: var(--module-primary); }
.module-card-accent-success::before { background: var(--module-success); }
.module-card-accent-warning::before { background: var(--module-warning); }
.module-card-accent-danger::before { background: var(--module-danger); }
.module-card-accent-info::before { background: var(--module-info); }
.module-card-accent-neutral::before { background: var(--module-neutral); }

/* Keep semantic badges readable */
.badge-module-primary { color: #1d4ed8; background: #eff6ff; }
.badge-module-success { color: #166534; background: #f0fdf4; }
.badge-module-warning { color: #92400e; background: #fffbeb; }
.badge-module-danger { color: #991b1b; background: #fef2f2; }
.badge-module-info { color: #155e75; background: #ecfeff; }
.badge-module-neutral { color: #334155; background: #f1f5f9; }

/* Dark-mode friendly status surfaces if the application already enables dark mode */
@media (prefers-color-scheme: dark) {
    .badge-module-primary { color: #bfdbfe; background: rgba(37, 99, 235, .16); }
    .badge-module-success { color: #bbf7d0; background: rgba(22, 163, 74, .16); }
    .badge-module-warning { color: #fde68a; background: rgba(217, 119, 6, .16); }
    .badge-module-danger { color: #fecaca; background: rgba(220, 38, 38, .16); }
    .badge-module-info { color: #a5f3fc; background: rgba(8, 145, 178, .16); }
    .badge-module-neutral { color: #cbd5e1; background: rgba(100, 116, 139, .16); }
}


/* =====================================================
   PART78 UI-17 — SIDEBAR / NAVIGATION FINAL POLISH
   Presentation only: no route/role/menu logic changes.
===================================================== */

/* Navigation group hierarchy */
.sidebar-nav .nav-section,
.sidebar-nav .menu-section,
.sidebar-nav .sidebar-section {
    margin-top: 14px;
    margin-bottom: 5px;
}

.sidebar-nav .nav-section:first-child,
.sidebar-nav .menu-section:first-child,
.sidebar-nav .sidebar-section:first-child {
    margin-top: 4px;
}

/* Section labels are quieter than clickable menu items */
.sidebar-nav .nav-section-title,
.sidebar-nav .menu-section-title,
.sidebar-nav .sidebar-section-title {
    padding: 6px 12px;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .62;
}

/* Navigation items */
.sidebar-nav .nav-link,
.sidebar-nav a {
    min-height: 40px;
    display: flex;
    align-items: center;
    gap: 9px;
    border-radius: 9px;
    line-height: 1.25;
}

.sidebar-nav .nav-link .bi,
.sidebar-nav a .bi {
    width: 20px;
    min-width: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
}

/* Active page should be obvious without becoming visually heavy */
.sidebar-nav .nav-link.active,
.sidebar-nav a.active {
    font-weight: 700;
}

/* Submenus */
.sidebar-nav .submenu,
.sidebar-nav .nav-submenu,
.sidebar-nav ul ul {
    margin: 3px 0 5px 20px;
    padding-left: 9px;
    border-left: 1px solid rgba(148, 163, 184, .25);
}

.sidebar-nav .submenu .nav-link,
.sidebar-nav .nav-submenu .nav-link,
.sidebar-nav ul ul a {
    min-height: 36px;
    font-size: .88rem;
}

/* Parent menu with children */
.sidebar-nav .has-submenu > .nav-link,
.sidebar-nav .menu-parent > a {
    font-weight: 650;
}

.sidebar-nav .submenu-toggle,
.sidebar-nav .nav-toggle {
    margin-left: auto;
    width: 24px;
    min-width: 24px;
    display: inline-flex;
    justify-content: center;
}

/* Sidebar scrolling: keep navigation accessible */
.sidebar-nav,
.sidebar-menu,
.app-sidebar-nav {
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
}

/* Avoid scrollbar shifting the menu width */
.sidebar-nav::-webkit-scrollbar,
.sidebar-menu::-webkit-scrollbar,
.app-sidebar-nav::-webkit-scrollbar {
    width: 7px;
}

.sidebar-nav::-webkit-scrollbar-thumb,
.sidebar-menu::-webkit-scrollbar-thumb,
.app-sidebar-nav::-webkit-scrollbar-thumb {
    border-radius: 999px;
}

/* Sidebar footer stays visually separate where present */
.sidebar-footer {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid rgba(148, 163, 184, .18);
}

/* Mobile navigation */
@media (max-width: 700px) {
    .sidebar-nav .nav-link,
    .sidebar-nav a {
        min-height: 42px;
    }

    .sidebar-nav .nav-section-title,
    .sidebar-nav .menu-section-title,
    .sidebar-nav .sidebar-section-title {
        padding-left: 10px;
    }

    .sidebar-nav .submenu,
    .sidebar-nav .nav-submenu,
    .sidebar-nav ul ul {
        margin-left: 14px;
    }
}


/* =====================================================
   CHECKUP-18 PERFORMANCE CSS HYGIENE
   Presentation/performance only: no business logic.
===================================================== */

/* Prevent accidental expensive layout patterns */
img,
svg,
video,
canvas {
    max-width: 100%;
}

img {
    height: auto;
}

/* Long pages: avoid unnecessary paint complexity */
.card,
.dashboard-card,
.stat-card,
.detail-card,
.profile-card,
.report-card,
.import-card {
    contain: layout;
}

/* Tables should not force the whole viewport to reflow */
.table-responsive,
.table-wrapper,
.data-table-wrapper {
    max-width: 100%;
}

/* Keep interactive transitions lightweight */
.btn,
.nav-link,
.sidebar-nav a,
.card,
.dashboard-card,
.stat-card {
    transition-duration: .15s;
    transition-timing-function: ease;
}

/* Respect users who prefer reduced motion */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
    }
}

/* Mobile: don't introduce extra layout constraints */
@media (max-width: 700px) {
    .card,
    .dashboard-card,
    .stat-card,
    .detail-card,
    .profile-card,
    .report-card,
    .import-card {
        contain: none;
    }
}


/* SIDEBAR UI POLISH — 2026-09-26
   Presentation only: no menu/route/permission logic changes.
*/
.sidebar {
    width: 250px;
}

.sidebar-brand {
    padding: 18px 16px 16px;
}

.sidebar-menu {
    padding: 12px 8px 18px;
}

.menu-title {
    padding: 13px 10px 7px;
    margin-top: 7px;
    font-size: 10px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: .09em;
}

.menu-title:first-child {
    margin-top: 0;
}

.sidebar .menu-item {
    width: 100%;
    min-height: 42px;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    align-items: center;
    column-gap: 10px;
    padding: 9px 12px;
    margin: 2px 0;
    border: 1px solid transparent;
    border-radius: 10px;
    line-height: 1.25;
}

.sidebar .menu-icon,
.sidebar .menu-item-sub .menu-icon {
    width: 24px;
    min-width: 24px;
    flex: none;
    height: 24px;
    margin: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.sidebar .menu-icon i {
    width: 18px;
    height: 18px;
    font-size: 15px;
}

.sidebar .menu-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.25;
}

/* Sub-items remain visually grouped, while icon/label columns stay consistent. */
.sidebar .menu-item-sub {
    min-height: 38px;
    margin-left: 8px;
    width: calc(100% - 8px);
    padding-left: 12px;
    font-size: 13px;
    border-radius: 9px;
    position: relative;
}

.sidebar .menu-item-sub::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 7px;
    bottom: 7px;
    width: 2px;
    border-radius: 999px;
    background: rgba(148, 163, 184, .18);
}

.sidebar .menu-item-sub:hover::before,
.sidebar .menu-item-sub.active::before {
    background: rgba(255,255,255,.42);
}

.sidebar-bottom {
    padding: 10px 8px 12px;
}

.sidebar-bottom form {
    width: 100%;
}

.sidebar .logout-item {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    min-height: 44px;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    align-items: center;
    column-gap: 10px;
    padding: 10px 13px;
    margin: 0;
    border: 1px solid rgba(248, 113, 113, .55) !important;
    border-radius: 10px;
    background: linear-gradient(135deg, #dc2626, #b91c1c) !important;
    color: #fff !important;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 7px 16px rgba(185, 28, 28, .22);
    transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
}

.sidebar .logout-item .menu-icon {
    width: 24px;
    min-width: 24px;
    height: 24px;
    color: #fff !important;
    background: transparent !important;
}

.sidebar .logout-item .menu-icon i {
    font-size: 16px;
}

.sidebar .logout-item:hover {
    background: linear-gradient(135deg, #ef4444, #dc2626) !important;
    color: #fff !important;
    border-color: rgba(254, 202, 202, .75) !important;
    box-shadow: 0 9px 20px rgba(185, 28, 28, .30);
    transform: translateY(-1px);
}

.sidebar .logout-item:focus-visible {
    outline: 3px solid rgba(248, 113, 113, .38);
    outline-offset: 2px;
}

@media (max-width: 700px) {
    .sidebar .menu-item {
        min-height: 43px;
        padding-left: 11px;
        padding-right: 11px;
    }

    .sidebar .menu-item-sub {
        margin-left: 6px;
        width: calc(100% - 6px);
    }

    .sidebar .logout-item {
        min-height: 44px;
    }
}


/* BULK STUDENT DELETE UI — presentation only */
.bulk-filter-grid{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:12px;align-items:end}
.bulk-filter-actions{display:flex;gap:8px}
.bulk-student-table .check-col{width:44px;text-align:center}
.bulk-student-table th,.bulk-student-table td{vertical-align:middle}
.bulk-action-bar{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:14px 0 0;margin-top:12px;border-top:1px solid rgba(148,163,184,.2)}
.bulk-action-bar>div:last-child{display:flex;align-items:center;flex-wrap:wrap}
.bulk-confirm{width:120px!important}
.bulk-pagination{display:flex;justify-content:center;align-items:center;gap:12px;padding-top:16px}
@media(max-width:900px){.bulk-filter-grid{grid-template-columns:1fr 1fr}.bulk-filter-actions{grid-column:1/-1}.bulk-action-bar{align-items:flex-start;flex-direction:column}.bulk-action-bar>div:last-child{width:100%}}
@media(max-width:600px){.bulk-filter-grid{grid-template-columns:1fr}.bulk-filter-actions{grid-column:auto}.bulk-confirm{width:100%!important;margin:6px 0!important}.bulk-action-bar>div:last-child{display:grid;grid-template-columns:1fr;width:100%}.bulk-action-bar .btn{margin:6px 0 0!important}}


/* DASHBOARD COLORFUL MODERN — 2026-09-26
   Presentation-only: dashboard data/query/business logic is unchanged.
*/
.dashboard-page {
    background:
        radial-gradient(circle at 8% 0%, rgba(99,102,241,.07), transparent 28%),
        radial-gradient(circle at 92% 12%, rgba(14,165,233,.06), transparent 25%),
        #f4f7fb;
}

/* Rich but clean summary cards */
.dashboard-alert {
    border: 0 !important;
    border-radius: 18px;
    min-height: 116px;
    padding: 17px 18px;
    box-shadow: 0 10px 25px rgba(15,23,42,.11);
    isolation: isolate;
}
.dashboard-alert::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: .98;
    background: linear-gradient(135deg, rgba(255,255,255,.08), transparent 48%, rgba(0,0,0,.08));
}
.dashboard-alert::after {
    content: "";
    position: absolute;
    width: 120px;
    height: 120px;
    right: -38px;
    bottom: -55px;
    border-radius: 50%;
    background: rgba(255,255,255,.12);
    z-index: -1;
}
.dashboard-alert:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 32px rgba(15,23,42,.16);
}

.dashboard-alert.alert-info {
    background: linear-gradient(135deg, #2563eb 0%, #4338ca 100%) !important;
}
.dashboard-alert.alert-success {
    background: linear-gradient(135deg, #16a34a 0%, #047857 100%) !important;
}
.dashboard-alert.alert-purple {
    background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%) !important;
}
.dashboard-alert.alert-warning {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important;
}
.dashboard-alert.alert-danger {
    background: linear-gradient(135deg, #ef4444 0%, #be123c 100%) !important;
}
.dashboard-alert.alert-teal {
    background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%) !important;
}

.dashboard-alert .alert-icon {
    width: 44px;
    height: 44px;
    flex-basis: 44px;
    border-radius: 14px;
    background: rgba(255,255,255,.18) !important;
    border: 1px solid rgba(255,255,255,.24);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.14);
}
.dashboard-alert .alert-label {
    font-size: 12px;
    letter-spacing: .015em;
}
.dashboard-alert .alert-value {
    font-size: 27px;
}

/* White status cards: each card gets its own modern accent */
.modern-card {
    min-height: 136px;
    border: 1px solid #e5eaf2;
    border-radius: 18px;
    padding: 17px 18px;
    background: linear-gradient(145deg, #fff 0%, #f9fbff 100%);
    box-shadow: 0 7px 20px rgba(15,23,42,.055);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
}
.modern-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, #2563eb, #6366f1);
}
.modern-card:nth-child(2)::before {
    background: linear-gradient(90deg, #f59e0b, #f97316);
}
.modern-card:nth-child(3)::before {
    background: linear-gradient(90deg, #06b6d4, #0891b2);
}
.modern-card:nth-child(4)::before {
    background: linear-gradient(90deg, #ef4444, #db2777);
}
.modern-card:hover {
    transform: translateY(-3px);
    border-color: #cbd5e1;
    box-shadow: 0 14px 30px rgba(15,23,42,.10);
}
.modern-card .card-icon {
    width: 42px;
    height: 42px;
    border-radius: 13px;
    box-shadow: 0 4px 10px rgba(15,23,42,.07);
}
.modern-card .card-number {
    font-size: 28px;
    margin-top: 12px;
}

/* Section headings and context chips */
.dashboard-section {
    margin-top: 28px;
}
.dashboard-section-head {
    margin-bottom: 14px;
}
.dashboard-section-head h3 {
    font-size: 18px;
}
.section-accent {
    width: 5px;
    height: 30px;
    border-radius: 999px;
    background: linear-gradient(180deg, #6366f1, #2563eb);
    box-shadow: 0 4px 10px rgba(79,70,229,.20);
}
.context-chip {
    padding: 9px 13px;
    border: 1px solid #e3e8f1;
    box-shadow: 0 4px 10px rgba(15,23,42,.035);
}
.context-chip i {
    font-size: 14px;
}

/* Responsive: keep cards usable on tablets/phones */
@media (max-width: 1100px) {
    .dashboard-alert-grid,
    .dashboard-grid-modern {
        grid-template-columns: repeat(2, minmax(0,1fr));
    }
}
@media (max-width: 680px) {
    .dashboard-alert-grid,
    .dashboard-grid-modern,
    .task-list {
        grid-template-columns: 1fr;
    }
    .dashboard-alert {
        min-height: 104px;
    }
    .modern-card {
        min-height: 126px;
    }
}


/* STUDENT UI POLISH — 2026-09-26
   Presentation-only: no data/query/business-rule changes.
*/
.student-stat {
    position: relative;
    overflow: hidden;
    min-height: 148px;
    padding: 20px 20px 18px;
    border: 0;
    border-radius: 18px;
    color: #fff;
    box-shadow: 0 12px 28px rgba(15,23,42,.10);
    isolation: isolate;
    transition: transform .18s ease, box-shadow .18s ease;
}
.student-stat::before {
    content: "";
    position: absolute;
    width: 150px;
    height: 150px;
    right: -48px;
    bottom: -62px;
    border-radius: 50%;
    background: rgba(255,255,255,.14);
    z-index: -1;
}
.student-stat::after {
    content: "";
    position: absolute;
    width: 80px;
    height: 80px;
    right: 42px;
    top: -38px;
    border-radius: 50%;
    background: rgba(255,255,255,.08);
    z-index: -1;
}
.student-stat:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 34px rgba(15,23,42,.15);
}
.student-stat .card-icon {
    width: 46px;
    height: 46px;
    margin-bottom: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    background: rgba(255,255,255,.18);
    color: #fff;
    border: 1px solid rgba(255,255,255,.22);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.18);
}
.student-stat .card-icon i {
    font-size: 20px;
}
.student-stat .card-label {
    margin-bottom: 5px;
    color: rgba(255,255,255,.90);
    font-size: 13px;
    font-weight: 700;
}
.student-stat .card-number {
    color: #fff;
    font-size: 31px;
    font-weight: 800;
    letter-spacing: -.02em;
}
.student-stat .card-description {
    margin-top: 7px;
    color: rgba(255,255,255,.78);
    font-size: 12px;
}
.student-stat-blue   { background: linear-gradient(135deg,#2563eb 0%,#4338ca 100%); }
.student-stat-green  { background: linear-gradient(135deg,#16a34a 0%,#047857 100%); }
.student-stat-purple { background: linear-gradient(135deg,#7c3aed 0%,#6d28d9 100%); }
.student-stat-orange { background: linear-gradient(135deg,#f59e0b 0%,#ea580c 100%); }
.student-stat-red    { background: linear-gradient(135deg,#ef4444 0%,#be123c 100%); }
.student-stat-cyan   { background: linear-gradient(135deg,#06b6d4 0%,#0f766e 100%); }

/* Filter row: fixed, readable columns on desktop; wraps cleanly on smaller screens. */
.student-filter-bar {
    display: grid;
    grid-template-columns:
        minmax(150px, 1.05fr)
        minmax(210px, 1.55fr)
        minmax(145px, 1fr)
        minmax(165px, 1.15fr)
        auto
        auto
        auto;
    gap: 10px;
    align-items: center;
    margin: 18px 0;
    padding: 14px;
    background: linear-gradient(180deg,#f8fafc 0%,#f1f5f9 100%);
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 4px 14px rgba(15,23,42,.04);
}
.student-filter-bar > .form-control,
.student-filter-bar > select,
.student-filter-bar > input {
    width: 100%;
    min-width: 0;
    margin: 0;
}
.student-filter-bar .form-control {
    min-height: 42px;
    box-sizing: border-box;
}
.student-filter-bar .student-per-page {
    min-width: 116px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    white-space: nowrap;
    color: #475569;
    font-size: 13px;
    font-weight: 700;
}
.student-filter-bar .student-per-page .form-control {
    width: 68px;
    min-width: 68px;
    padding-left: 9px;
    padding-right: 9px;
}
.student-filter-bar .btn {
    min-width: 96px;
    height: 42px;
}
.student-filter-bar .student-filter-apply {
    background: #4f46e5;
    border-color: #4f46e5;
    color: #fff;
}
.student-filter-bar .student-filter-apply:hover {
    background: #4338ca;
    border-color: #4338ca;
    color: #fff;
}
.student-filter-bar .student-filter-reset {
    min-width: 82px;
}

/* Keep the action row below the filters equally clean. */
#bulkSiswaForm > div[style*="justify-content"] {
    padding: 10px 12px;
    margin: 4px 0 12px !important;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #fff;
}
#checkAllSiswa {
    accent-color: #4f46e5;
}
#bulkSiswaForm .btn-danger {
    border-radius: 9px;
    background: linear-gradient(135deg,#ef4444,#dc2626);
    border-color: #dc2626;
}

@media (max-width: 1250px) {
    .student-filter-bar {
        grid-template-columns: repeat(4, minmax(0,1fr));
    }
    .student-filter-bar .student-per-page {
        justify-content: flex-start;
    }
}

@media (max-width: 900px) {
    .student-filter-bar {
        grid-template-columns: repeat(2, minmax(0,1fr));
    }
    .student-filter-bar .student-per-page {
        justify-content: flex-start;
    }
    .student-filter-bar .student-filter-apply,
    .student-filter-bar .student-filter-reset {
        width: 100%;
    }
}

@media (max-width: 600px) {
    .student-filter-bar {
        grid-template-columns: 1fr;
        padding: 12px;
    }
    .student-stat {
        min-height: 132px;
    }
}


/* GLOBAL RESPONSIVE DESIGN SYSTEM V1 — 2026-09-26
   Presentation/layout only. No routes, queries, permissions, or business logic.
*/
:root {
    --ui-space-1: 4px;
    --ui-space-2: 8px;
    --ui-space-3: 12px;
    --ui-space-4: 16px;
    --ui-space-5: 20px;
    --ui-radius-sm: 8px;
    --ui-radius-md: 12px;
    --ui-radius-lg: 16px;
    --ui-content-max: 1680px;
    --ui-sidebar-w: 242px;
}

/* Prevent long labels from forcing the application wider than the viewport. */
html, body {
    max-width: 100%;
    overflow-x: hidden;
}
img, svg, video, canvas {
    max-width: 100%;
}
button, input, select, textarea {
    max-width: 100%;
}
a, button, label, th, td, .menu-label, .card-label, .card-description {
    overflow-wrap: anywhere;
}

/* Application shell */
.app-shell,
.layout,
.main-layout {
    width: 100%;
    max-width: 100%;
}
.main,
.main-content,
.content {
    min-width: 0;
    width: 100%;
}
.content {
    max-width: var(--ui-content-max);
    margin-left: auto;
    margin-right: auto;
}

/* Compact, consistent page header. */
.page-header {
    gap: 14px;
    min-width: 0;
}
.page-header > * {
    min-width: 0;
}
.page-header h1 {
    line-height: 1.25;
    overflow-wrap: anywhere;
}

/* Cards: compact by default on operational pages. */
.card,
.dashboard-card,
.modern-card,
.form-card,
.stat-card {
    min-width: 0;
    box-sizing: border-box;
}
.dashboard-card,
.modern-card,
.stat-card {
    border-radius: var(--ui-radius-lg);
}

/* Text inside cards may wrap instead of overflowing. */
.card-label,
.card-description,
.stat-label,
.stat-description {
    min-width: 0;
    overflow-wrap: anywhere;
}

/* Generic responsive grid helpers already used by different pages. */
.dashboard-grid,
.stats-grid,
.card-grid,
.cards-grid {
    min-width: 0;
}
.dashboard-grid > *,
.stats-grid > *,
.card-grid > *,
.cards-grid > * {
    min-width: 0;
}

/* Tables remain usable without pushing the entire page horizontally. */
.table-responsive,
.table-wrap,
.table-container {
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}
table {
    max-width: 100%;
}
th, td {
    overflow-wrap: anywhere;
}

/* Generic toolbar/filter wrapping. */
.filter-bar,
.toolbar,
.action-bar {
    min-width: 0;
    max-width: 100%;
}
.filter-bar > *,
.toolbar > *,
.action-bar > * {
    min-width: 0;
    max-width: 100%;
}

/* Sidebar: compact professional sizing. */
.sidebar {
    width: var(--ui-sidebar-w);
    max-width: 80vw;
}
.sidebar .menu-item {
    min-width: 0;
    min-height: 40px;
}
.sidebar .menu-label {
    white-space: normal;
    line-height: 1.25;
}
.sidebar .menu-item-sub {
    min-height: 36px;
}
.sidebar .logout-item {
    min-width: 0;
}

/* Large desktop: use space without making cards oversized. */
@media (min-width: 1440px) {
    .content {
        padding-left: 24px;
        padding-right: 24px;
    }
}

/* Laptop / smaller desktop */
@media (max-width: 1199px) {
    :root {
        --ui-sidebar-w: 228px;
    }
    .content {
        padding-left: 18px;
        padding-right: 18px;
    }
}

/* Tablet */
@media (max-width: 991px) {
    .content {
        padding-left: 16px;
        padding-right: 16px;
    }

    .page-header {
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .page-header .btn,
    .page-header a.btn {
        flex: 0 0 auto;
    }

    .sidebar {
        width: min(242px, 82vw);
    }
}

/* Small tablet / large phone */
@media (max-width: 767px) {
    .content {
        padding-left: 12px;
        padding-right: 12px;
    }

    .page-header h1 {
        font-size: 21px;
    }

    .page-header p {
        font-size: 12px;
    }

    .dashboard-card,
    .modern-card,
    .stat-card {
        border-radius: 13px;
    }

    .btn {
        max-width: 100%;
    }

    .table-responsive,
    .table-wrap,
    .table-container {
        margin-left: 0;
        margin-right: 0;
    }
}

/* Phone */
@media (max-width: 575px) {
    .content {
        padding-left: 10px;
        padding-right: 10px;
    }

    .page-header {
        gap: 9px;
        margin-bottom: 14px;
    }

    .page-header h1 {
        font-size: 19px;
    }

    .page-header .btn,
    .page-header a.btn {
        width: 100%;
    }

    .card-label {
        font-size: 13px;
    }

    .card-description {
        font-size: 11px;
    }

    /* Long action groups can wrap instead of overflowing. */
    .action-group,
    .table-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }
}

/* Very narrow phones */
@media (max-width: 390px) {
    .content {
        padding-left: 8px;
        padding-right: 8px;
    }

    .btn {
        min-height: 38px;
    }
}

/* RESPONSIVE CORRECTION V2 — 2026-09-26
   Fixes excessive card size and horizontal page expansion.
   Presentation only; no business logic/database/query changes.
*/
.main {
    width: calc(100% - 250px);
    max-width: calc(100% - 250px);
    min-width: 0;
    box-sizing: border-box;
}

.content {
    width: 100%;
    max-width: none;
    min-width: 0;
    box-sizing: border-box;
    margin-left: 0;
    margin-right: 0;
}

/* Operational/stat grids: compact rather than dashboard-sized. */
.dashboard-grid {
    width: 100%;
    min-width: 0;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    align-items: start;
}

.student-stat {
    min-width: 0;
    min-height: 112px;
    height: auto;
    padding: 14px 15px 13px;
    border-radius: 15px;
    box-shadow: 0 7px 18px rgba(15,23,42,.08);
}

.student-stat .card-icon {
    width: 38px;
    height: 38px;
    margin-bottom: 9px;
    border-radius: 11px;
}

.student-stat .card-icon i {
    font-size: 17px;
}

.student-stat .card-label {
    margin-bottom: 3px;
    font-size: 12px;
    line-height: 1.25;
}

.student-stat .card-number {
    font-size: 25px;
    line-height: 1.05;
}

.student-stat .card-description {
    margin-top: 5px;
    font-size: 10.5px;
    line-height: 1.25;
}

/* Header actions must never push the page wider than the viewport. */
.page-header {
    min-width: 0;
    width: 100%;
}
.page-header > div:first-child {
    min-width: 0;
    flex: 1 1 auto;
}
.page-header-actions {
    min-width: 0;
    max-width: 52%;
    flex: 0 1 auto;
    flex-wrap: wrap;
    justify-content: flex-end;
}
.page-header-actions .btn {
    max-width: 100%;
    white-space: normal;
}

@media (max-width: 1200px) {
    .dashboard-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .page-header-actions {
        max-width: 48%;
    }
}

@media (max-width: 900px) {
    .main {
        width: calc(100% - 228px);
        max-width: calc(100% - 228px);
    }
    .dashboard-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .page-header {
        flex-wrap: wrap;
    }
    .page-header-actions {
        max-width: 100%;
        width: 100%;
        justify-content: flex-start;
    }
}

@media (max-width: 600px) {
    .main {
        width: 100%;
        max-width: 100%;
        margin-left: 0;
    }
    .dashboard-grid {
        grid-template-columns: 1fr;
        gap: 10px;
    }
    .student-stat {
        min-height: 104px;
    }
}

/* =====================================================
   DESIGN SYSTEM V3 — GLOBAL OPERATIONAL CARDS
   Presentation only: colors, spacing, responsive layout.
   No business logic, database, query, auth, or route changes.
===================================================== */

/* Compact operational cards (Dashboard keeps its own visual hierarchy). */
.dashboard-grid > .dashboard-card,
.stats-grid > .stat-card,
.bk-stats > .bk-stat,
.hv-grid > .hv-card,
.pel-grid > .pel-card,
.pb-grid > .pb-card {
    min-width: 0;
    min-height: 108px;
    height: auto;
    box-sizing: border-box;
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
}

.dashboard-grid > .dashboard-card:hover,
.stats-grid > .stat-card:hover,
.bk-stats > .bk-stat:hover,
.hv-grid > .hv-card:hover,
.pel-grid > .pel-card:hover,
.pb-grid > .pb-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(15,23,42,.10);
}

/* Colorful semantic palette for operational stat cards. */
.dashboard-grid > .dashboard-card:nth-child(4n+1),
.stats-grid > .stat-card:nth-child(4n+1),
.bk-stats > .bk-stat:nth-child(4n+1),
.hv-grid > .hv-card:nth-child(4n+1),
.pel-grid > .pel-card:nth-child(4n+1),
.pb-grid > .pb-card:nth-child(4n+1) {
    background: linear-gradient(135deg,#2563eb,#4338ca) !important;
    color: #fff !important;
    border-color: transparent !important;
}
.dashboard-grid > .dashboard-card:nth-child(4n+2),
.stats-grid > .stat-card:nth-child(4n+2),
.bk-stats > .bk-stat:nth-child(4n+2),
.hv-grid > .hv-card:nth-child(4n+2),
.pel-grid > .pel-card:nth-child(4n+2),
.pb-grid > .pb-card:nth-child(4n+2) {
    background: linear-gradient(135deg,#16a34a,#047857) !important;
    color: #fff !important;
    border-color: transparent !important;
}
.dashboard-grid > .dashboard-card:nth-child(4n+3),
.stats-grid > .stat-card:nth-child(4n+3),
.bk-stats > .bk-stat:nth-child(4n+3),
.hv-grid > .hv-card:nth-child(4n+3),
.pel-grid > .pel-card:nth-child(4n+3),
.pb-grid > .pb-card:nth-child(4n+3) {
    background: linear-gradient(135deg,#7c3aed,#6d28d9) !important;
    color: #fff !important;
    border-color: transparent !important;
}
.dashboard-grid > .dashboard-card:nth-child(4n+4),
.stats-grid > .stat-card:nth-child(4n+4),
.bk-stats > .bk-stat:nth-child(4n+4),
.hv-grid > .hv-card:nth-child(4n+4),
.pel-grid > .pel-card:nth-child(4n+4),
.pb-grid > .pb-card:nth-child(4n+4) {
    background: linear-gradient(135deg,#0891b2,#0f766e) !important;
    color: #fff !important;
    border-color: transparent !important;
}

/* Readable typography on colorful stat cards. */
.dashboard-grid > .dashboard-card .card-label,
.dashboard-grid > .dashboard-card .card-number,
.dashboard-grid > .dashboard-card .card-description,
.stats-grid > .stat-card .stat-label,
.stats-grid > .stat-card .stat-value,
.bk-stat .bk-stat-number,
.bk-stat .bk-stat-label,
.hv-card .hv-label,
.hv-card .hv-num,
.hv-card small,
.pel-card .pel-label,
.pel-card .pel-num,
.pel-card small,
.pb-card .pb-label,
.pb-card .pb-num,
.pb-card small {
    color: inherit !important;
    overflow-wrap: anywhere;
}

.dashboard-grid > .dashboard-card .card-label,
.stats-grid > .stat-card .stat-label,
.bk-stat .bk-stat-label,
.hv-card .hv-label,
.pel-card .pel-label,
.pb-card .pb-label {
    font-size: 12px;
    line-height: 1.3;
    font-weight: 700;
}

.dashboard-grid > .dashboard-card .card-number,
.stats-grid > .stat-card .stat-value,
.bk-stat .bk-stat-number,
.hv-card .hv-num,
.pel-card .pel-num,
.pb-card .pb-num {
    font-size: 25px;
    line-height: 1.05;
    font-weight: 800;
}

/* Icon bubbles on colorful cards. */
.dashboard-grid > .dashboard-card .card-icon,
.stats-grid > .stat-card .stat-icon,
.bk-stat .bk-stat-icon {
    width: 38px;
    height: 38px;
    min-width: 38px;
    border-radius: 11px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,.17) !important;
    color: #fff !important;
    border: 1px solid rgba(255,255,255,.24);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.15);
}

/* Generic menu/action cards stay compact and colorful without oversized typography. */
.dashboard-grid > .dashboard-card {
    padding: 14px 15px;
}
.dashboard-grid > .dashboard-card .card-description {
    font-size: 10.5px;
    line-height: 1.3;
}

/* Filter cards and utility cards remain light so forms stay readable. */
.stock-card,
.visit-card,
.portal-card,
.form-card,
.filter-bar {
    min-width: 0;
    box-sizing: border-box;
}
.stock-card,
.visit-card,
.portal-card {
    border-radius: 14px;
}

/* Responsive grid behavior for the common operational card groups. */
.bk-stats,
.hv-grid,
.pel-grid,
.pb-grid,
.stats-grid,
.dashboard-grid {
    min-width: 0;
}

@media (max-width: 1199px) {
    .bk-stats,
    .hv-grid,
    .pel-grid,
    .pb-grid,
    .stats-grid,
    .dashboard-grid {
        gap: 11px;
    }
}

@media (max-width: 900px) {
    .bk-stats,
    .hv-grid,
    .pel-grid,
    .pb-grid,
    .stats-grid,
    .dashboard-grid {
        grid-template-columns: repeat(2,minmax(0,1fr));
    }
}

@media (max-width: 600px) {
    .bk-stats,
    .hv-grid,
    .pel-grid,
    .pb-grid,
    .stats-grid,
    .dashboard-grid {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .dashboard-grid > .dashboard-card,
    .stats-grid > .stat-card,
    .bk-stats > .bk-stat,
    .hv-grid > .hv-card,
    .pel-grid > .pel-card,
    .pb-grid > .pb-card {
        min-height: 100px;
    }
}

/* Utility/action groups: wrap cleanly instead of stretching the page. */
.page-header-actions,
.filter-bar,
.student-picker-toolbar,
.student-filter-bar,
.list-toolbar,
.bulk-filter-actions,
.audit-filter-grid {
    min-width: 0;
    max-width: 100%;
}
.page-header-actions,
.filter-bar,
.student-picker-toolbar,
.student-filter-bar,
.list-toolbar {
    flex-wrap: wrap;
}

.page-header-actions > *,
.filter-bar > *,
.student-picker-toolbar > *,
.student-filter-bar > *,
.list-toolbar > * {
    min-width: 0;
}

/* Long labels never dictate the width of their parent. */
.dashboard-grid a,
.dashboard-grid button,
.stats-grid a,
.stats-grid button,
.card-label,
.card-description,
.stat-label,
.stat-value,
.form-label,
.nav-link,
.sidebar-nav a {
    overflow-wrap: anywhere;
}

/* =====================================================
   DESIGN SYSTEM V4 — STAT GRID / IZIN SISWA POLISH
   Presentation only: no business logic, data, query, route,
   permission, or form-processing changes.
===================================================== */

/* The shared stats-grid must explicitly be a grid.  Some legacy pages
   provide only the class name, so the global fallback is defined here. */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    align-items: stretch;
}

.stats-grid > .stat-card {
    width: 100%;
    min-width: 0;
    min-height: 104px;
    height: auto;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-sizing: border-box;
}

.stats-grid > .stat-card > div:last-child {
    min-width: 0;
    flex: 1 1 auto;
}

.stats-grid > .stat-card .stat-icon {
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    min-width: 40px;
    font-size: 17px;
}

.stats-grid > .stat-card .stat-label {
    display: block;
    margin: 0 0 4px;
    font-size: 13px;
    line-height: 1.25;
    font-weight: 750;
    white-space: normal;
    overflow-wrap: anywhere;
}

.stats-grid > .stat-card .stat-value {
    display: block;
    margin: 0;
    font-size: 27px;
    line-height: 1;
    font-weight: 800;
}

/* Keep the colorful treatment compact instead of turning the card into a banner. */
.stats-grid > .stat-card:nth-child(4n+1),
.stats-grid > .stat-card:nth-child(4n+2),
.stats-grid > .stat-card:nth-child(4n+3),
.stats-grid > .stat-card:nth-child(4n+4) {
    min-height: 104px;
}

/* Avoid accidental width growth from inline/form descendants. */
.content,
.content > *,
.page-header,
.page-header > *,
.stats-grid,
.stats-grid > *,
.form-card,
.table-card {
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
}

@media (max-width: 1199px) {
    .stats-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 900px) {
    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }
}

@media (max-width: 600px) {
    .stats-grid {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .stats-grid > .stat-card {
        min-height: 88px;
        padding: 12px 14px;
    }

    .stats-grid > .stat-card .stat-icon {
        flex-basis: 38px;
        width: 38px;
        height: 38px;
        min-width: 38px;
    }

    .stats-grid > .stat-card .stat-value {
        font-size: 24px;
    }
}


/* DESIGN SYSTEM V5 — IZIN SISWA CARD FIX
   Presentation-only correction for the actual Izin Siswa stats markup.
   No database, query, route, permission, or business-logic changes.
*/
.izin-stats-grid {
    display: grid !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 12px !important;
    align-items: stretch !important;
}

.izin-stats-grid > .stat-card {
    width: 100% !important;
    min-width: 0 !important;
    min-height: 104px !important;
    height: 104px !important;
    padding: 14px !important;
    margin: 0 !important;
    box-sizing: border-box !important;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 11px !important;
    overflow: hidden !important;
}

.izin-stats-grid > .stat-card > div:last-child {
    min-width: 0 !important;
    flex: 1 1 auto !important;
}

.izin-stats-grid .stat-icon {
    flex: 0 0 42px !important;
    width: 42px !important;
    height: 42px !important;
    min-width: 42px !important;
    margin: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border-radius: 12px !important;
    font-size: 17px !important;
}

.izin-stats-grid .stat-label {
    display: block !important;
    margin: 0 0 5px !important;
    font-size: 13px !important;
    line-height: 1.2 !important;
    font-weight: 750 !important;
    white-space: normal !important;
    overflow-wrap: anywhere !important;
}

.izin-stats-grid .stat-value {
    display: block !important;
    margin: 0 !important;
    font-size: 25px !important;
    line-height: 1 !important;
    font-weight: 800 !important;
}

/* Do not let legacy mobile rules turn the desktop card group into one column
   merely because the browser has been zoomed. */
@media (min-width: 1001px) {
    .izin-stats-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    }
}

@media (max-width: 1000px) and (min-width: 701px) {
    .izin-stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
}

@media (max-width: 700px) {
    .izin-stats-grid {
        grid-template-columns: 1fr !important;
        gap: 10px !important;
    }

    .izin-stats-grid > .stat-card {
        min-height: 92px !important;
        height: 92px !important;
        padding: 12px !important;
    }

    .izin-stats-grid .stat-icon {
        flex-basis: 38px !important;
        width: 38px !important;
        height: 38px !important;
        min-width: 38px !important;
    }

    .izin-stats-grid .stat-label {
        font-size: 12px !important;
    }

    .izin-stats-grid .stat-value {
        font-size: 23px !important;
    }
}

/* =====================================================
   PEMELIHARAAN SISTEM — SEMANTIC ACTION CARDS
   Presentation only. No business logic changes.
===================================================== */
.maintenance-stats-grid,
.maintenance-actions-grid {
    min-width: 0;
    display: grid;
    gap: 14px;
}

.maintenance-stats-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 14px;
}

.maintenance-actions-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-bottom: 16px;
}

.maintenance-stats-grid > .maintenance-stat {
    min-height: 126px;
    padding: 16px 18px;
    border: 0 !important;
    border-radius: 16px;
    color: #fff !important;
    box-sizing: border-box;
    overflow: hidden;
    position: relative;
}

.maintenance-stat-backup {
    background: linear-gradient(135deg,#2563eb,#1d4ed8) !important;
}
.maintenance-stat-students {
    background: linear-gradient(135deg,#0f766e,#047857) !important;
}
.maintenance-stat-upload {
    background: linear-gradient(135deg,#7c3aed,#6d28d9) !important;
}

.maintenance-stat .card-icon {
    width: 38px;
    height: 38px;
    margin-bottom: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    background: rgba(255,255,255,.16) !important;
    border: 1px solid rgba(255,255,255,.28);
    color: #fff !important;
    font-size: 18px;
}

.maintenance-stat .card-label,
.maintenance-stat .card-number,
.maintenance-stat .card-description {
    color: #fff !important;
}

.maintenance-stat .card-label {
    font-size: 12px;
    line-height: 1.25;
    font-weight: 800;
}

.maintenance-stat .card-number {
    margin-top: 3px;
    font-size: 27px;
    line-height: 1;
    font-weight: 850;
}

.maintenance-stat .card-description {
    margin-top: 7px;
    font-size: 10.5px;
    line-height: 1.35;
}

.maintenance-action {
    min-height: 146px !important;
    padding: 17px 18px !important;
    border: 0 !important;
    border-radius: 16px !important;
    color: #fff !important;
    text-decoration: none !important;
    box-sizing: border-box;
    overflow: hidden;
    position: relative;
    display: flex !important;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    transition: transform .16s ease, box-shadow .16s ease, filter .16s ease;
}

.maintenance-action:hover {
    color: #fff !important;
    transform: translateY(-2px);
    filter: brightness(1.03);
    box-shadow: 0 12px 28px rgba(15,23,42,.14);
}

.maintenance-action-backup {
    background: linear-gradient(135deg,#2563eb,#1e40af) !important;
}

.maintenance-action-reset {
    background: linear-gradient(135deg,#f59e0b,#d97706) !important;
}

.maintenance-action-danger {
    background: linear-gradient(135deg,#ef4444,#dc2626) !important;
}

.maintenance-action-danger-dark {
    background: linear-gradient(135deg,#dc2626,#991b1b) !important;
}

.maintenance-action-icon {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    border-radius: 12px;
    background: rgba(255,255,255,.16);
    border: 1px solid rgba(255,255,255,.30);
    color: #fff;
    font-size: 19px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.16);
}

.maintenance-action .card-label {
    margin: 0;
    color: #fff !important;
    font-size: 13px;
    line-height: 1.25;
    font-weight: 800;
}

.maintenance-action .card-description {
    margin-top: 7px;
    color: rgba(255,255,255,.94) !important;
    font-size: 10.5px;
    line-height: 1.4;
}

.maintenance-warning {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 4px;
    padding: 13px 15px;
    border: 1px solid #fecaca;
    border-left: 4px solid #dc2626;
    border-radius: 13px;
    background: #fff7ed;
    color: #7f1d1d;
    box-sizing: border-box;
}

.maintenance-warning-icon {
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    background: #fee2e2;
    color: #dc2626;
    font-size: 17px;
}

.maintenance-warning strong {
    display: block;
    margin-bottom: 2px;
    font-size: 12px;
    line-height: 1.3;
}

.maintenance-warning p {
    margin: 0;
    font-size: 11px;
    line-height: 1.45;
    color: #7f1d1d;
}

@media (max-width: 1100px) {
    .maintenance-actions-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 760px) {
    .maintenance-stats-grid,
    .maintenance-actions-grid {
        grid-template-columns: 1fr;
    }
    .maintenance-stats-grid > .maintenance-stat,
    .maintenance-action {
        min-height: 116px !important;
    }
}

/* ================================================================
   GLOBAL SIDEBAR SYSTEM — EXPANDED / COLLAPSED / AUTO-HIDE
   2026-09-27
   Presentation and navigation-chrome only.
   No PHP logic, database, query, permission, route, or business
   processing is changed.
================================================================ */

/* Shell dimensions are centralized so every page follows the same
   sidebar/content relationship. */
:root {
    --sidebar-expanded-w: 250px;
    --sidebar-collapsed-w: 76px;
    --sidebar-current-w: var(--sidebar-expanded-w);
    --sidebar-transition: .22s ease;
}

/* The preference is applied to <html> before the page is painted. */
html[data-sidebar-mode="collapsed"] {
    --sidebar-current-w: var(--sidebar-collapsed-w);
}
html[data-sidebar-mode="auto"] {
    --sidebar-current-w: var(--sidebar-collapsed-w);
}

/* Global shell */
.sidebar {
    width: var(--sidebar-current-w) !important;
    max-width: none !important;
    transition: width var(--sidebar-transition);
    z-index: 1200;
}

.main {
    margin-left: var(--sidebar-current-w) !important;
    width: calc(100% - var(--sidebar-current-w)) !important;
    max-width: calc(100% - var(--sidebar-current-w)) !important;
    min-width: 0 !important;
    transition: margin-left var(--sidebar-transition), width var(--sidebar-transition), max-width var(--sidebar-transition);
}

.topbar {
    left: var(--sidebar-current-w) !important;
    transition: left var(--sidebar-transition);
    padding-left: 54px;
}

/* ================================================================
   GLOBAL TOGGLE
================================================================ */
.global-sidebar-toggle {
    position: fixed;
    top: 14px;
    left: calc(var(--sidebar-current-w) + 10px);
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid #dbe3ee;
    border-radius: 10px;
    background: rgba(255,255,255,.96);
    color: #334155;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: inherit;
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    z-index: 1400;
    box-shadow: 0 4px 14px rgba(15,23,42,.10);
    transition: left var(--sidebar-transition), background .16s ease,
                color .16s ease, box-shadow .16s ease, transform .16s ease;
}

.global-sidebar-toggle:hover {
    background: #f8fafc;
    color: #2563eb;
    box-shadow: 0 7px 18px rgba(15,23,42,.14);
}

.global-sidebar-toggle:focus-visible {
    outline: 3px solid rgba(37,99,235,.20);
    outline-offset: 2px;
}

.global-sidebar-toggle i {
    pointer-events: none;
}

/* ================================================================
   COLLAPSED DESKTOP
================================================================ */
html[data-sidebar-mode="collapsed"] .sidebar-brand {
    padding: 14px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

html[data-sidebar-mode="collapsed"] .sidebar-logo {
    width: 42px;
    height: 42px;
    margin: 0 auto;
}

html[data-sidebar-mode="collapsed"] .sidebar-brand-title,
html[data-sidebar-mode="collapsed"] .sidebar-brand small,
html[data-sidebar-mode="collapsed"] .sidebar-role-badge,
html[data-sidebar-mode="collapsed"] .sidebar-task-list,
html[data-sidebar-mode="collapsed"] .menu-title,
html[data-sidebar-mode="collapsed"] .menu-label {
    display: none !important;
}

html[data-sidebar-mode="collapsed"] .sidebar-menu {
    padding: 12px 8px;
}

html[data-sidebar-mode="collapsed"] .menu-item {
    width: 100%;
    min-height: 42px;
    height: 42px;
    padding: 0;
    margin-bottom: 5px;
    justify-content: center;
    gap: 0;
    border-radius: 10px;
}

html[data-sidebar-mode="collapsed"] .menu-item-sub {
    padding-left: 0;
}

html[data-sidebar-mode="collapsed"] .menu-icon {
    width: 24px;
    min-width: 24px;
    height: 24px;
    font-size: 16px;
}

html[data-sidebar-mode="collapsed"] .sidebar-bottom {
    padding: 9px 8px;
}

html[data-sidebar-mode="collapsed"] .logout-item {
    min-height: 42px;
    height: 42px;
    padding: 0;
    justify-content: center;
    text-align: center !important;
    border-radius: 10px;
}

html[data-sidebar-mode="collapsed"] .logout-item .menu-label {
    display: none !important;
}

/* Tooltip for icon-only navigation. */
html[data-sidebar-mode="collapsed"] .menu-item[data-menu-label]::after {
    content: attr(data-menu-label);
    position: absolute;
    left: calc(100% + 9px);
    top: 50%;
    transform: translateY(-50%) translateX(-4px);
    opacity: 0;
    pointer-events: none;
    white-space: nowrap;
    background: #0f172a;
    color: #fff;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    box-shadow: 0 8px 20px rgba(15,23,42,.18);
    transition: opacity .14s ease, transform .14s ease;
    z-index: 1600;
}

html[data-sidebar-mode="collapsed"] .menu-item[data-menu-label]:hover::after {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
}

/* ================================================================
   AUTO-HIDE DESKTOP
   Collapsed by default; hovering the sidebar expands it. Content
   follows the same width only while the pointer is over the sidebar.
================================================================ */
html[data-sidebar-mode="auto"] .sidebar:hover {
    width: var(--sidebar-expanded-w) !important;
}

html[data-sidebar-mode="auto"] .sidebar:hover ~ .main {
    margin-left: var(--sidebar-expanded-w) !important;
    width: calc(100% - var(--sidebar-expanded-w)) !important;
    max-width: calc(100% - var(--sidebar-expanded-w)) !important;
}

html[data-sidebar-mode="auto"] .sidebar:hover ~ .main .topbar {
    left: var(--sidebar-expanded-w) !important;
}

/* Auto mode uses the same compact icon-only state until hover. */
html[data-sidebar-mode="auto"] .sidebar:not(:hover) .sidebar-brand {
    padding: 14px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

html[data-sidebar-mode="auto"] .sidebar:not(:hover) .sidebar-logo {
    width: 42px;
    height: 42px;
    margin: 0 auto;
}

html[data-sidebar-mode="auto"] .sidebar:not(:hover) .sidebar-brand-title,
html[data-sidebar-mode="auto"] .sidebar:not(:hover) .sidebar-brand small,
html[data-sidebar-mode="auto"] .sidebar:not(:hover) .sidebar-role-badge,
html[data-sidebar-mode="auto"] .sidebar:not(:hover) .sidebar-task-list,
html[data-sidebar-mode="auto"] .sidebar:not(:hover) .menu-title,
html[data-sidebar-mode="auto"] .sidebar:not(:hover) .menu-label {
    display: none !important;
}

html[data-sidebar-mode="auto"] .sidebar:not(:hover) .sidebar-menu {
    padding: 12px 8px;
}

html[data-sidebar-mode="auto"] .sidebar:not(:hover) .menu-item {
    width: 100%;
    min-height: 42px;
    height: 42px;
    padding: 0;
    margin-bottom: 5px;
    justify-content: center;
    gap: 0;
    border-radius: 10px;
}

html[data-sidebar-mode="auto"] .sidebar:not(:hover) .menu-item-sub {
    padding-left: 0;
}

html[data-sidebar-mode="auto"] .sidebar:not(:hover) .menu-icon {
    width: 24px;
    min-width: 24px;
    height: 24px;
    font-size: 16px;
}

html[data-sidebar-mode="auto"] .sidebar:not(:hover) .sidebar-bottom {
    padding: 9px 8px;
}

html[data-sidebar-mode="auto"] .sidebar:not(:hover) .logout-item {
    min-height: 42px;
    height: 42px;
    padding: 0;
    justify-content: center;
    text-align: center !important;
    border-radius: 10px;
}

html[data-sidebar-mode="auto"] .sidebar:not(:hover) .logout-item .menu-label {
    display: none !important;
}

/* ================================================================
   MOBILE / TABLET
   Sidebar becomes a true off-canvas drawer. Content always receives
   the full viewport width, preventing horizontal expansion.
================================================================ */
.sidebar-overlay {
    display: none;
}

@media (max-width: 767px) {
    :root {
        --sidebar-current-w: 0px;
    }

    .sidebar {
        width: min(286px, 86vw) !important;
        max-width: min(286px, 86vw) !important;
        left: 0;
        right: auto;
        transform: translateX(-105%);
        transition: transform var(--sidebar-transition);
        box-shadow: 12px 0 30px rgba(15,23,42,.18);
    }

    .main {
        width: 100% !important;
        max-width: 100% !important;
        margin-left: 0 !important;
        transition: none;
    }

    .topbar,
    html[data-sidebar-mode="auto"] .sidebar:hover ~ .main .topbar {
        left: 0 !important;
        padding-left: 58px;
        transition: none;
    }

    .global-sidebar-toggle {
        top: 11px;
        left: 12px;
        width: 38px;
        height: 38px;
        border-radius: 11px;
    }

    .sidebar-overlay {
        position: fixed;
        inset: 0;
        display: block;
        background: rgba(15,23,42,.42);
        opacity: 0;
        pointer-events: none;
        z-index: 1100;
        transition: opacity .18s ease;
    }

    html.sidebar-mobile-open .sidebar {
        transform: translateX(0);
    }

    html.sidebar-mobile-open .sidebar-overlay {
        opacity: 1;
        pointer-events: auto;
    }

    /* On mobile the drawer is always expanded for readable labels. */
    html[data-sidebar-mode="collapsed"] .sidebar,
    html[data-sidebar-mode="auto"] .sidebar {
        width: min(286px, 86vw) !important;
        max-width: min(286px, 86vw) !important;
    }

    html[data-sidebar-mode="collapsed"] .sidebar-brand,
    html[data-sidebar-mode="auto"] .sidebar-brand,
    html[data-sidebar-mode="collapsed"] .sidebar-menu,
    html[data-sidebar-mode="auto"] .sidebar-menu {
        /* reset desktop icon-only presentation while used as a drawer */
        display: block;
    }

    html[data-sidebar-mode="collapsed"] .sidebar-brand,
    html[data-sidebar-mode="auto"] .sidebar-brand {
        padding: 20px;
        text-align: left;
    }

    html[data-sidebar-mode="collapsed"] .sidebar-brand-title,
    html[data-sidebar-mode="auto"] .sidebar-brand-title,
    html[data-sidebar-mode="collapsed"] .sidebar-brand small,
    html[data-sidebar-mode="auto"] .sidebar-brand small,
    html[data-sidebar-mode="collapsed"] .sidebar-role-badge,
    html[data-sidebar-mode="auto"] .sidebar-role-badge {
        display: block !important;
    }

    html[data-sidebar-mode="collapsed"] .sidebar-menu,
    html[data-sidebar-mode="auto"] .sidebar-menu {
        padding: 15px 10px;
    }

    html[data-sidebar-mode="collapsed"] .menu-title,
    html[data-sidebar-mode="auto"] .menu-title {
        display: block !important;
    }

    html[data-sidebar-mode="collapsed"] .menu-item,
    html[data-sidebar-mode="auto"] .menu-item {
        width: auto;
        min-height: 40px;
        height: auto;
        padding: 10px 13px;
        margin-bottom: 3px;
        justify-content: flex-start;
        gap: 11px;
        border-radius: 9px;
    }

    html[data-sidebar-mode="collapsed"] .menu-item-sub,
    html[data-sidebar-mode="auto"] .menu-item-sub {
        padding-left: 24px;
    }

    html[data-sidebar-mode="collapsed"] .menu-label,
    html[data-sidebar-mode="auto"] .menu-label {
        display: inline !important;
    }

    html[data-sidebar-mode="collapsed"] .menu-icon,
    html[data-sidebar-mode="auto"] .menu-icon {
        width: 20px;
        min-width: 20px;
        height: 20px;
        font-size: 15px;
    }

    html.sidebar-mobile-open .global-sidebar-toggle {
        left: min(298px, calc(86vw + 12px));
    }
}

@media (min-width: 768px) {
    .sidebar-overlay {
        display: none !important;
    }
}

/* Respect reduced-motion preferences. */
@media (prefers-reduced-motion: reduce) {
    .sidebar,
    .main,
    .topbar,
    .global-sidebar-toggle,
    .sidebar-overlay {
        transition: none !important;
    }
}


/* ================================================================
   PART63 — GLOBAL DASHBOARD / OPERATIONAL CARD POLISH
   Presentation only. No route, permission, query, or business logic.
================================================================ */
.dashboard-page .dashboard-alert-grid {
    align-items: stretch;
}
.dashboard-page .dashboard-alert {
    min-width: 0;
    min-height: 116px;
    height: 100%;
    padding: 17px 18px;
    align-items: flex-start;
    border-radius: 18px;
}
.dashboard-page .dashboard-alert > div:last-child {
    min-width: 0;
    padding-top: 1px;
}
.dashboard-page .dashboard-alert .alert-label,
.dashboard-page .dashboard-alert .alert-text {
    overflow-wrap: anywhere;
}
.dashboard-page .dashboard-alert .alert-value {
    line-height: 1.05;
    margin-top: 2px;
}
.dashboard-page .dashboard-alert .alert-icon {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
}
.dashboard-page .modern-card {
    min-height: 124px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
}
.dashboard-page .modern-card .card-number {
    margin-top: 11px;
}
.dashboard-page .task-card {
    min-height: 84px;
    align-items: center;
}
.dashboard-page .task-card > div:last-child {
    min-width: 0;
}
.dashboard-page .task-card strong,
.dashboard-page .task-card span {
    overflow-wrap: anywhere;
}

/* Operational quick actions: one consistent component across roles. */
.dashboard-page .quick-action-grid {
    align-items: stretch;
}
.dashboard-page .quick-action {
    min-height: 82px;
}
.dashboard-page .quick-action-copy strong,
.dashboard-page .quick-action-copy small {
    overflow-wrap: anywhere;
}

/* Piket cards: semantic colors, compact hierarchy, equal height. */
.dashboard-grid > .stat-card.stat-task,
.dashboard-grid > .stat-card.stat-student,
.dashboard-grid > .stat-card.stat-qr,
.dashboard-grid > .stat-card.stat-pending {
    min-height: 118px;
    height: 100%;
    padding: 17px 18px 17px 20px;
    display: flex;
    align-items: center;
    gap: 13px;
    border-radius: 17px;
    border: 1px solid transparent;
    box-shadow: 0 8px 22px rgba(15,23,42,.08);
}
.dashboard-grid > .stat-card.stat-task { background: linear-gradient(135deg,#2563eb,#4338ca); color:#fff; }
.dashboard-grid > .stat-card.stat-student { background: linear-gradient(135deg,#16a34a,#047857); color:#fff; }
.dashboard-grid > .stat-card.stat-qr { background: linear-gradient(135deg,#7c3aed,#6d28d9); color:#fff; }
.dashboard-grid > .stat-card.stat-pending { background: linear-gradient(135deg,#d97706,#b45309); color:#fff; }
.dashboard-grid > .stat-card.stat-task::before,
.dashboard-grid > .stat-card.stat-student::before,
.dashboard-grid > .stat-card.stat-qr::before,
.dashboard-grid > .stat-card.stat-pending::before { background:rgba(255,255,255,.9); opacity:.5; }
.dashboard-grid > .stat-card.stat-task .stat-icon,
.dashboard-grid > .stat-card.stat-student .stat-icon,
.dashboard-grid > .stat-card.stat-qr .stat-icon,
.dashboard-grid > .stat-card.stat-pending .stat-icon {
    flex: 0 0 46px;
    width:46px;
    height:46px;
    border-radius:13px;
    background:rgba(255,255,255,.16);
    color:#fff;
    border:1px solid rgba(255,255,255,.18);
    font-size:19px;
}
.dashboard-grid > .stat-card.stat-task .stat-label,
.dashboard-grid > .stat-card.stat-student .stat-label,
.dashboard-grid > .stat-card.stat-qr .stat-label,
.dashboard-grid > .stat-card.stat-pending .stat-label { color:rgba(255,255,255,.9); opacity:1; font-size:12px; font-weight:800; }
.dashboard-grid > .stat-card.stat-task .stat-value,
.dashboard-grid > .stat-card.stat-student .stat-value,
.dashboard-grid > .stat-card.stat-qr .stat-value,
.dashboard-grid > .stat-card.stat-pending .stat-value { color:#fff; font-size:28px; font-weight:850; margin-top:3px; }

@media (max-width:1100px) {
    .dashboard-page .dashboard-alert-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
@media (max-width:700px) {
    .dashboard-page .dashboard-alert-grid { grid-template-columns:1fr; }
    .dashboard-page .dashboard-alert { min-height:100px; }
}


/* ================================================================
   PART64 — DASHBOARD QUICK ACCESS + ICON FALLBACK POLISH
   Presentation only. No route, permission, query, or business logic.
================================================================ */
.dashboard-page .quick-action-grid{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:14px;
}
.dashboard-page .quick-action{
    position:relative;
    display:flex;
    align-items:center;
    gap:13px;
    min-width:0;
    min-height:88px;
    padding:14px 15px;
    border:1px solid #dbe5f0;
    border-radius:17px;
    background:#fff;
    color:#14233b;
    box-shadow:0 8px 22px rgba(15,23,42,.055);
    overflow:hidden;
    transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;
}
.dashboard-page .quick-action::after{
    content:"";
    position:absolute;
    width:90px;height:90px;
    right:-38px;bottom:-52px;
    border-radius:50%;
    background:currentColor;
    opacity:.045;
    pointer-events:none;
}
.dashboard-page .quick-action:hover{
    transform:translateY(-3px);
    box-shadow:0 14px 30px rgba(15,23,42,.11);
    border-color:#b9cce0;
}
.dashboard-page .quick-action-icon{
    flex:0 0 48px;
    width:48px;height:48px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border-radius:14px;
    background:#eff6ff;
    color:#2563eb;
    font-size:20px;
    border:1px solid #dbeafe;
}
.dashboard-page .quick-action-copy{
    min-width:0;
    display:flex;
    flex:1;
    flex-direction:column;
    gap:3px;
}
.dashboard-page .quick-action-copy strong{
    font-size:14px;
    font-weight:800;
    line-height:1.25;
    color:#14233b;
}
.dashboard-page .quick-action-copy small{
    color:#6b7e95;
    font-size:11px;
    line-height:1.4;
}
.dashboard-page .quick-action-arrow{
    flex:0 0 auto;
    color:#94a8bd;
    font-size:15px;
}
.dashboard-page .quick-action-success .quick-action-icon{background:#ecfdf5;color:#15803d;border-color:#bbf7d0}
.dashboard-page .quick-action-teal .quick-action-icon{background:#ecfeff;color:#0f766e;border-color:#a5f3fc}
.dashboard-page .quick-action-danger .quick-action-icon{background:#fff1f2;color:#dc2626;border-color:#fecdd3}
.dashboard-page .quick-action-purple .quick-action-icon{background:#f5f3ff;color:#6d28d9;border-color:#ddd6fe}
.dashboard-page .quick-action-warning .quick-action-icon{background:#fffbeb;color:#b45309;border-color:#fde68a}
.dashboard-page .quick-action-primary .quick-action-icon{background:#eff6ff;color:#2563eb;border-color:#bfdbfe}

.dashboard-page .task-list{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:13px;
}
.dashboard-page .task-card{
    min-width:0;
    border:1px solid #dfe8f2;
    border-radius:16px;
    background:#fff;
    box-shadow:0 7px 19px rgba(15,23,42,.045);
    padding:14px 15px;
}
.dashboard-page .task-icon{
    width:42px;height:42px;
    border-radius:13px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    flex:0 0 42px;
    background:var(--role-soft,#eff6ff);
    color:var(--role-primary,#2563eb);
    border:1px solid var(--role-border,#bfdbfe);
}
.dashboard-page .task-card > div:last-child{display:flex;flex-direction:column;gap:3px}
.dashboard-page .task-card strong{font-size:13px;line-height:1.3;color:#172a46}
.dashboard-page .task-card span{font-size:10px;line-height:1.4;color:#70849a}

@media (max-width:1050px){
    .dashboard-page .quick-action-grid,
    .dashboard-page .task-list{grid-template-columns:repeat(2,minmax(0,1fr));}
}
@media (max-width:700px){
    .dashboard-page .quick-action-grid,
    .dashboard-page .task-list{grid-template-columns:1fr;}
    .dashboard-page .quick-action{min-height:78px;}
}


/* =====================================================
   SYSTEM INTEGRITY + ABOUT SYSTEM
   ===================================================== */
.integrity-summary{display:flex;align-items:center;gap:16px;border-radius:18px;padding:18px 20px;margin:0 0 20px;border:1px solid var(--border,#dbe3ef);background:#fff;box-shadow:0 8px 24px rgba(15,23,42,.06)}
.integrity-summary.is-ok{border-color:#b9e3c7}.integrity-summary.is-warning{border-color:#f0c36a}.integrity-summary-icon{width:48px;height:48px;display:grid;place-items:center;border-radius:14px;background:#eaf7ee;font-size:24px;color:#198754}.integrity-summary.is-warning .integrity-summary-icon{background:#fff4d8;color:#b77900}.integrity-summary strong{font-size:16px}.integrity-summary small{display:block;margin-top:3px;color:#718096}
.integrity-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.integrity-card{display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid #e4eaf2;border-radius:16px;padding:17px;box-shadow:0 6px 18px rgba(15,23,42,.045)}.integrity-card.ok{border-left:4px solid #20a464}.integrity-card.warn{border-left:4px solid #e3a008}.integrity-icon{font-size:21px;color:#20a464}.integrity-card.warn .integrity-icon{color:#d58a00}.integrity-card h3{font-size:14px;margin:0 0 5px}.integrity-card p{margin:0;color:#64748b;font-size:13px;line-height:1.55}
.about-system-card{display:flex;gap:20px;align-items:center;padding:26px;border-radius:22px;background:linear-gradient(135deg,#102a43,#147d92);color:#fff;box-shadow:0 14px 32px rgba(16,42,67,.18);margin-bottom:18px}.about-logo{width:72px;height:72px;border-radius:20px;background:rgba(255,255,255,.14);display:grid;place-items:center;font-size:34px;flex:0 0 72px}.about-kicker{text-transform:uppercase;letter-spacing:.08em;font-size:11px;opacity:.78}.about-system-card h2{font-size:24px;margin:4px 0}.about-school{margin:0;opacity:.9}.about-meta{display:flex;gap:16px;flex-wrap:wrap;margin-top:14px;font-size:12px;opacity:.9}.about-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.about-panel{display:flex;gap:14px;padding:20px;border:1px solid #e3e9f1;border-radius:17px;background:#fff;box-shadow:0 6px 18px rgba(15,23,42,.045)}.about-panel>i{font-size:24px;color:#147d92}.about-panel h3{margin:0 0 7px;font-size:15px}.about-panel p{margin:0;color:#64748b;font-size:13px;line-height:1.6}.about-panel .about-developer{font-size:18px;font-weight:700;color:#102a43;margin-bottom:4px}.about-footer-note{margin-top:18px;text-align:center;color:#718096;font-size:12px;padding:15px;border-top:1px solid #e5eaf1}
@media(max-width:800px){.integrity-grid,.about-grid{grid-template-columns:1fr}.about-system-card{align-items:flex-start}.about-meta{flex-direction:column;gap:6px}}
.global-app-footer{padding:12px 20px;text-align:center;color:#7a8798;font-size:11px;background:transparent;border-top:1px solid rgba(148,163,184,.14)}
.global-app-footer strong{color:#536273}
.maintenance-action-integrity{border-top:4px solid #147d92}.maintenance-action-integrity .maintenance-action-icon{color:#147d92;background:#e7f7fa}

/* PART90 — SIDEBAR GROUPED NAVIGATION
   Presentation/navigation only. Existing routes and permission checks remain unchanged. */
.sidebar .sidebar-section-label {
    margin-top: 10px;
}

.sidebar .sidebar-group {
    margin: 5px 0;
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255,255,255,.025);
}

.sidebar .sidebar-group[open] {
    background: rgba(255,255,255,.035);
    border-color: rgba(255,255,255,.10);
}

.sidebar .sidebar-group-toggle {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 12px;
    color: rgba(255,255,255,.88);
    cursor: pointer;
    list-style: none;
    user-select: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .01em;
}

.sidebar .sidebar-group-toggle::-webkit-details-marker {
    display: none;
}

.sidebar .sidebar-group-toggle::marker {
    display: none;
    content: '';
}

.sidebar .sidebar-group-toggle:hover {
    background: rgba(255,255,255,.07);
}

.sidebar .sidebar-group-title {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
}

.sidebar .sidebar-group-icon {
    width: 25px;
    min-width: 25px;
    height: 25px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    color: #dbeafe;
    background: rgba(255,255,255,.09);
}

.sidebar .sidebar-group-icon i {
    font-size: 14px;
}

.sidebar .sidebar-group-chevron {
    flex: none;
    color: rgba(255,255,255,.55);
    font-size: 12px;
    transition: transform .18s ease;
}

.sidebar .sidebar-group[open] > .sidebar-group-toggle .sidebar-group-chevron {
    transform: rotate(180deg);
}

.sidebar .sidebar-group-body {
    padding: 2px 7px 8px;
}

.sidebar .sidebar-group-body > .menu-item {
    margin-top: 2px;
    margin-bottom: 2px;
}

.sidebar .sidebar-group-body > .menu-item:first-child {
    margin-top: 0;
}

.sidebar .sidebar-group:has(.menu-item.active) > .sidebar-group-toggle {
    color: #fff;
}

.sidebar .sidebar-group:has(.menu-item.active) > .sidebar-group-toggle .sidebar-group-icon {
    background: color-mix(in srgb, var(--sidebar-primary) 42%, transparent);
    color: #fff;
}

@media (max-width: 700px) {
    .sidebar .sidebar-group-toggle {
        min-height: 45px;
        padding-left: 11px;
        padding-right: 11px;
    }
}

/* SIDEBAR BRAND POLISH — 2026-09-29
   Presentation only. Logo uses the original school-profile asset;
   white card/padding is removed and identity text sits beside it.
*/
.sidebar-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 14px !important;
    text-align: left;
}

.sidebar-logo {
    flex: 0 0 60px;
    width: 60px !important;
    height: 60px !important;
    object-fit: contain;
    background: transparent !important;
    border-radius: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
}

.sidebar-brand-info {
    min-width: 0;
    flex: 1 1 auto;
}

.sidebar-brand-title {
    font-size: 17px;
    line-height: 1.2;
    font-weight: 750;
    white-space: nowrap;
}

.sidebar-brand-info small {
    display: block;
    margin-top: 4px;
    color: #94a3b8;
    font-size: 11px;
    line-height: 1.35;
}

.sidebar-brand-info .sidebar-role-badge {
    margin-top: 7px;
    width: fit-content;
}

html[data-sidebar-mode="collapsed"] .sidebar-brand,
html[data-sidebar-mode="auto"] .sidebar:not(:hover) .sidebar-brand {
    padding: 14px 10px !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0;
}

html[data-sidebar-mode="collapsed"] .sidebar-logo,
html[data-sidebar-mode="auto"] .sidebar:not(:hover) .sidebar-logo {
    flex-basis: 46px;
    width: 46px !important;
    height: 46px !important;
    margin: 0 auto !important;
}

html[data-sidebar-mode="collapsed"] .sidebar-brand-info,
html[data-sidebar-mode="auto"] .sidebar:not(:hover) .sidebar-brand-info {
    display: none !important;
}

@media (max-width: 700px) {
    html[data-sidebar-mode="collapsed"] .sidebar-brand,
    html[data-sidebar-mode="auto"] .sidebar-brand {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: flex-start !important;
        gap: 12px !important;
        padding: 18px 16px !important;
        text-align: left !important;
    }

    html[data-sidebar-mode="collapsed"] .sidebar-brand-info,
    html[data-sidebar-mode="auto"] .sidebar-brand-info {
        display: block !important;
    }

    html[data-sidebar-mode="collapsed"] .sidebar-logo,
    html[data-sidebar-mode="auto"] .sidebar-logo {
        width: 56px !important;
        height: 56px !important;
        flex-basis: 56px;
        margin: 0 !important;
    }
}


/* ================================================================
   PART67 — RESPONSIVE SHELL FINAL CORRECTION
   Prevent page content from exceeding the viewport when the global
   sidebar is expanded/collapsed or when a page contains wide grids.
   Presentation only; no business logic/database changes.
================================================================ */
.main,
.main-content {
    box-sizing: border-box;
    min-width: 0 !important;
    width: calc(100% - var(--sidebar-current-w, 250px)) !important;
    max-width: calc(100% - var(--sidebar-current-w, 250px)) !important;
}

.main > .content,
.main-content > .content,
.content {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: clip;
}

.content > *,
.page-header,
.page-header > *,
.card,
.form-card,
.dashboard-table-card {
    min-width: 0;
    max-width: 100%;
}

@media (max-width: 767px) {
    .main,
    .main-content {
        width: 100% !important;
        max-width: 100% !important;
        margin-left: 0 !important;
    }
}


/* ================================================================
   PART68 — GLOBAL OVERLAY + VIEWPORT CONTAINMENT
   Ensure fixed dialogs are never hidden behind the navigation shell
   and prevent page-level horizontal expansion. Presentation only.
================================================================ */

html, body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden !important;
}

.app,
.main,
.main-content,
.content {
    min-width: 0 !important;
    max-width: 100% !important;
}

.main,
.main-content {
    overflow-x: clip;
}

.content {
    overflow-x: clip;
}

/* The navigation shell sits below dialogs. Any page-level dialog
   must be able to cover the sidebar/topbar when it is intentionally
   opened. */
.service-modal,
.ukspa,
.reason-modal {
    box-sizing: border-box;
}

@media (max-width: 767px) {
    .content {
        overflow-x: hidden;
    }
}


/* =====================================================
   EKSTRAKURIKULER — UI POLISH
   Presentation only: does not change business logic.
===================================================== */
.app-module-extra .extra-page .content {
    max-width: 1500px;
    margin: 0 auto;
    padding: 24px 28px 40px;
}

.app-module-extra .extra-page .page-header {
    margin-bottom: 18px;
    padding: 20px 22px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    box-shadow: 0 5px 18px rgba(15,23,42,.05);
}

.app-module-extra .extra-page .page-header h1 {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.25;
    color: #0f172a;
}

.app-module-extra .extra-page .page-header p {
    margin: 7px 0 0;
    color: #64748b;
    font-size: .9rem;
    line-height: 1.6;
}

.app-module-extra .extra-page .form-card,
.app-module-extra .extra-page .dashboard-table-card {
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    box-shadow: 0 5px 18px rgba(15,23,42,.045);
    background: #fff;
}

.app-module-extra .extra-page .form-card {
    padding: 20px;
    margin-bottom: 18px;
}

.app-module-extra .extra-page .form-card > h2 {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 0;
    color: #0f172a;
    font-size: 1rem;
}

.app-module-extra .extra-page .dashboard-table-card {
    overflow: hidden;
    margin-bottom: 18px;
}

.app-module-extra .extra-page .section-title {
    padding: 15px 18px;
    border-bottom: 1px solid #e2e8f0;
    background: #f8fafc;
}

.app-module-extra .extra-page .section-title h2 {
    margin: 0;
    font-size: .98rem;
    color: #0f172a;
}

.app-module-extra .extra-page .section-title p {
    margin: 3px 0 0;
    color: #64748b;
    font-size: .78rem;
}

.app-module-extra .extra-page .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}

.app-module-extra .extra-page .data-table {
    min-width: 680px;
}

.app-module-extra .extra-page .data-table th {
    background: #f8fafc;
    color: #475569;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .02em;
    text-transform: uppercase;
    white-space: nowrap;
}

.app-module-extra .extra-page .data-table td {
    color: #334155;
    vertical-align: middle;
}

.app-module-extra .extra-page .data-table tbody tr:hover {
    background: #f8fafc;
}

.app-module-extra .extra-page .btn {
    border-radius: 9px;
    font-weight: 600;
    transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
}

.app-module-extra .extra-page .btn:hover {
    transform: translateY(-1px);
}

.app-module-extra .extra-page .btn-sm {
    min-height: 34px;
}

.app-module-extra .extra-page .form-actions {
    gap: 8px;
}

.app-module-extra .extra-page .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-radius: 999px;
    padding: 5px 10px;
    font-size: .72rem;
    font-weight: 700;
    white-space: nowrap;
}

.app-module-extra .extra-page .empty-state {
    padding: 36px 20px;
    color: #64748b;
}

.app-module-extra .extra-page .empty-state i {
    color: #94a3b8;
}

.app-module-extra .extra-page code {
    padding: 3px 7px;
    border-radius: 6px;
    background: #f1f5f9;
    color: #334155;
    font-size: .78rem;
}

/* Card grids used by Ekstra Saya / forms */
.app-module-extra .extra-page .dashboard-grid {
    gap: 14px;
}

.app-module-extra .extra-page .dashboard-grid > .form-card {
    margin-bottom: 0;
}

.app-module-extra .extra-page .form-control,
.app-module-extra .extra-page select,
.app-module-extra .extra-page textarea {
    border-radius: 9px;
}

/* Teacher dashboard cards */
.app-module-extra .extra-page .dashboard-grid > .form-card h2 {
    color: #0f172a;
}

.app-module-extra .extra-page .dashboard-grid > .form-card .form-actions {
    margin-top: 14px;
}

/* Scanner status / camera card */
.app-module-extra .extra-page .decoder-help {
    border-radius: 9px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 9px 11px;
    color: #475569;
    font-size: .78rem;
}

@media (max-width: 900px) {
    .app-module-extra .extra-page .content {
        padding: 18px 16px 32px;
    }
    .app-module-extra .extra-page .page-header {
        padding: 17px;
        border-radius: 13px;
    }
    .app-module-extra .extra-page .form-card {
        padding: 16px;
        border-radius: 13px;
    }
}

@media (max-width: 640px) {
    .app-module-extra .extra-page .content {
        padding: 14px 11px 26px;
    }
    .app-module-extra .extra-page .page-header {
        margin-bottom: 12px;
        padding: 15px;
    }
    .app-module-extra .extra-page .page-header h1 {
        font-size: 1.15rem;
    }
    .app-module-extra .extra-page .page-header p {
        font-size: .8rem;
    }
    .app-module-extra .extra-page .section-title {
        padding: 13px 14px;
    }
    .app-module-extra .extra-page .form-actions .btn {
        flex: 1 1 auto;
    }
}


/* ================================================================
   UI REFINEMENT V1 — SPLASMA
   Presentation only. No database/business-flow changes.
   Fokus: hierarchy, grouping, readability, professional density.
================================================================ */

/* --- Global visual rhythm --- */
:root{
    --ui-primary:#2563eb;
    --ui-primary-deep:#1d4ed8;
    --ui-surface:#ffffff;
    --ui-page:#f6f8fb;
    --ui-border:#e2e8f0;
    --ui-text:#0f172a;
    --ui-muted:#64748b;
    --ui-radius:12px;
}
html,body{background:var(--ui-page);}
.content{padding:26px 28px 36px;}
.page-header{margin-bottom:20px;}
.page-header h1,.page-header h2{letter-spacing:-.02em;}
.page-header p,.page-description{line-height:1.6;}

/* --- Sidebar: calmer, clearer hierarchy --- */
.sidebar{
    width:258px;
    background:#111827;
    box-shadow:8px 0 28px rgba(15,23,42,.06);
}
.sidebar-brand{
    padding:18px 17px 16px;
    border-bottom:1px solid rgba(255,255,255,.08);
}
.sidebar-logo{
    width:42px;
    height:42px;
    border-radius:11px;
    margin-bottom:7px;
}
.sidebar-brand-title{
    font-size:16px;
    letter-spacing:.01em;
}
.sidebar-brand small{
    color:#94a3b8;
    font-size:10.5px;
    line-height:1.45;
}
.sidebar-role-badge{
    margin-top:9px;
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:5px 8px;
    border:1px solid rgba(255,255,255,.10);
    border-radius:999px;
    background:rgba(255,255,255,.055);
    color:#cbd5e1;
    font-size:10px;
    font-weight:700;
}
.sidebar-menu{
    padding:11px 9px 14px;
}
.sidebar-section-label{
    padding:13px 10px 6px;
    color:#64748b;
    font-size:9.5px;
    letter-spacing:.09em;
    font-weight:800;
}
.menu-title{
    margin-top:4px;
}
.menu-item{
    min-height:40px;
    margin-bottom:2px;
    padding:9px 11px;
    border-radius:9px;
    font-size:13px;
    color:#cbd5e1;
}
.menu-item:hover{
    background:#1f2937;
    color:#fff;
}
.menu-item.active{
    background:#2563eb;
    color:#fff;
    box-shadow:0 4px 12px rgba(37,99,235,.20);
}
.menu-item-sub{
    margin-left:9px;
    padding-left:29px;
    color:#94a3b8;
    font-size:12px;
    position:relative;
}
.menu-item-sub::before{
    content:"";
    position:absolute;
    left:17px;
    top:8px;
    bottom:8px;
    width:1px;
    background:rgba(148,163,184,.18);
}
.menu-icon{
    width:19px;
    min-width:19px;
    font-size:14px;
}
.sidebar-group{
    margin:4px 0 5px;
}
.sidebar-group-toggle{
    min-height:38px;
    padding:8px 10px;
    border-radius:9px;
    color:#94a3b8;
    font-size:11.5px;
    font-weight:800;
}
.sidebar-group-toggle:hover{
    background:rgba(255,255,255,.045);
    color:#e2e8f0;
}
.sidebar-group[open] > .sidebar-group-toggle{
    color:#e2e8f0;
}
.sidebar-group-icon{
    width:19px;
    color:#64748b;
}
.sidebar-group[open] .sidebar-group-icon{
    color:#93c5fd;
}
.sidebar-group-body{
    padding:1px 0 4px;
}
.sidebar-bottom{
    padding:9px;
}
.logout-item{
    border-radius:9px !important;
    color:#fca5a5;
}
.logout-item:hover{
    background:#7f1d1d !important;
}

/* Shell follows actual sidebar width */
.main{
    margin-left:258px;
    padding-top:68px;
}
.topbar{
    left:258px;
    height:68px;
    padding:0 27px;
    box-shadow:0 1px 0 rgba(15,23,42,.02);
}
.topbar-title{font-size:17px;}
.topbar-school{font-size:10.5px;}
.content{max-width:1600px;margin:0 auto;}

/* --- Dashboard: reduce visual noise and strengthen hierarchy --- */
.dashboard-page{
    background:#f6f8fb;
}
.dashboard-hero{
    border-radius:16px;
    padding:20px 22px;
    margin-bottom:16px;
    box-shadow:0 5px 18px rgba(15,23,42,.045);
}
.dashboard-hero:after{opacity:.045;}
.hero-copy h2{font-size:23px;}
.hero-copy p{font-size:12.5px;max-width:850px;}
.hero-badge{
    width:62px;
    min-width:62px;
    height:62px;
    border-radius:16px;
    font-size:24px;
    box-shadow:none;
}
.dashboard-context{margin-bottom:16px;}
.context-chip{
    padding:7px 10px;
    border-radius:9px;
    font-size:11px;
    box-shadow:0 1px 2px rgba(15,23,42,.02);
}
.dashboard-section{margin-top:20px;}
.dashboard-section-head{margin-bottom:10px;}
.dashboard-section-head h3{font-size:15px;}
.dashboard-section-head p{font-size:11px;line-height:1.5;}
.section-accent{
    width:3px;
    height:22px;
    margin-right:8px;
    vertical-align:-6px;
}

/* Important information cards: less saturated, easier to scan */
.dashboard-alert-grid{
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:11px;
}
.dashboard-alert{
    min-height:92px;
    padding:13px 14px;
    border-radius:13px;
    box-shadow:0 4px 12px rgba(15,23,42,.055);
}
.dashboard-alert:hover{
    transform:none;
    box-shadow:0 6px 16px rgba(15,23,42,.08);
}
.dashboard-alert .alert-icon{
    width:36px;height:36px;flex-basis:36px;
    border-radius:10px;
    font-size:15px;
}
.dashboard-alert .alert-label{font-size:10.5px;}
.dashboard-alert .alert-value{font-size:20px;}
.dashboard-alert .alert-text{font-size:10px;line-height:1.35;}

/* Quick access is the main operational area for teachers */
.dashboard-quick-access{
    margin-top:22px;
    padding:15px;
    border:1px solid #dbeafe;
    border-radius:16px;
    background:#f8fbff;
}
.dashboard-quick-access .dashboard-section-head{
    margin-bottom:11px;
}
.quick-action-grid{
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:10px;
}
.quick-action{
    min-height:72px;
    padding:12px 13px;
    border-radius:12px;
    box-shadow:0 3px 10px rgba(15,23,42,.035);
}
.quick-action:hover{
    transform:translateY(-1px);
}
.quick-action-icon{
    width:40px;height:40px;flex-basis:40px;
    border-radius:11px;
    font-size:17px;
}
.quick-action-copy strong{font-size:12px;}
.quick-action-copy small{font-size:10px;}
.quick-action-arrow{font-size:11px;}

/* Generic cards/tables/forms */
.modern-card,
.dashboard-table,
.form-card,
.dashboard-table-card{
    border-radius:13px;
    box-shadow:0 4px 14px rgba(15,23,42,.035);
}
.modern-card{padding:15px 16px;}
.modern-card .card-number{font-size:23px;margin-top:10px;}
.dashboard-table th{
    background:#f8fafc;
    font-size:10px;
    font-weight:800;
}
.dashboard-table td{font-size:11.5px;}
.status-pill{padding:4px 8px;font-size:9.5px;}

/* Keep role color as a small accent, not the whole page */
.dashboard-page.role-admin{--role-primary:#4f46e5;--role-deep:#4338ca;--role-soft:#eef2ff;--role-border:#c7d2fe}
.dashboard-page.role-ks{--role-primary:#059669;--role-deep:#047857;--role-soft:#ecfdf5;--role-border:#a7f3d0}
.dashboard-page.role-guru{--role-primary:#2563eb;--role-deep:#1d4ed8;--role-soft:#eff6ff;--role-border:#bfdbfe}
.dashboard-page.role-bk{--role-primary:#7c3aed;--role-deep:#6d28d9;--role-soft:#f5f3ff;--role-border:#ddd6fe}
.dashboard-page.role-tu{--role-primary:#d97706;--role-deep:#b45309;--role-soft:#fffbeb;--role-border:#fde68a}

/* Remove overly decorative dashboard gradients from the V1 prototype */
.dashboard-notification-grid .dashboard-alert,
.dashboard-page .dashboard-alert.alert-cyan{
    background:#fff;
    color:#0f172a;
    border-color:#e2e8f0;
}
.dashboard-notification-grid .dashboard-alert .alert-icon,
.dashboard-page .dashboard-alert.alert-cyan .alert-icon{
    color:var(--role-primary);
    background:var(--role-soft);
    border-color:var(--role-border);
}
.dashboard-notification-grid .dashboard-alert .alert-label,
.dashboard-page .dashboard-alert.alert-cyan .alert-label{
    color:#475569;
}
.dashboard-notification-grid .dashboard-alert .alert-value,
.dashboard-page .dashboard-alert.alert-cyan .alert-value{
    color:#0f172a;
}
.dashboard-notification-grid .dashboard-alert .alert-text,
.dashboard-page .dashboard-alert.alert-cyan .alert-text{
    color:#64748b;
}

/* --- Responsive --- */
@media (max-width:1100px){
    .dashboard-alert-grid,.dashboard-grid-modern{grid-template-columns:repeat(2,minmax(0,1fr));}
    .quick-action-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
}
@media (max-width:767px){
    .sidebar{width:258px;}
    .main{margin-left:0;padding-top:62px;}
    .topbar{left:0;height:62px;padding:0 16px;}
    .content{padding:18px 15px 28px;}
    .dashboard-hero{padding:17px;border-radius:13px;}
    .hero-copy h2{font-size:19px;}
    .hero-badge{width:52px;min-width:52px;height:52px;border-radius:13px;font-size:20px;}
    .dashboard-alert-grid,.dashboard-grid-modern,.quick-action-grid,.task-list{grid-template-columns:1fr;}
    .dashboard-quick-access{padding:12px;border-radius:13px;}
}
@media (min-width:768px) and (max-width:1200px){
    .main{margin-left:var(--sidebar-current-w,258px);}
    .topbar{left:var(--sidebar-current-w,258px);}
}

:root{--sidebar-expanded-w:258px;}

/* V1 operational priority */
.dashboard-quick-access .quick-action-primary{
    border-width:1.5px;
    box-shadow:0 5px 14px rgba(37,99,235,.08);
}


/* =========================================================
   UI REFINEMENT V2 — READABILITY FIRST
   Scope: Admin dashboard summary + notification cards.
   Presentation only. No business logic changes.
========================================================= */
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert {
    position: relative;
    background: #ffffff !important;
    color: #0f172a !important;
    border: 1px solid #e2e8f0 !important;
    border-left: 5px solid #2563eb !important;
    box-shadow: 0 6px 18px rgba(15,23,42,.06);
    overflow: hidden;
}

.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert::before {
    display: none;
}

.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert::after {
    width: 92px;
    height: 92px;
    right: -36px;
    bottom: -48px;
    background: rgba(37,99,235,.055);
    z-index: -1;
}

.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-info {
    border-left-color: #2563eb !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-success {
    border-left-color: #16a34a !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-purple {
    border-left-color: #7c3aed !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-warning {
    border-left-color: #d97706 !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-danger {
    border-left-color: #dc2626 !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-teal {
    border-left-color: #0f766e !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-cyan {
    border-left-color: #0891b2 !important;
}

.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-icon {
    background: #eff6ff !important;
    color: #1d4ed8 !important;
    border: 1px solid #bfdbfe;
    box-shadow: none;
}

.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-success .alert-icon {
    background: #f0fdf4 !important;
    color: #15803d !important;
    border-color: #bbf7d0;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-purple .alert-icon {
    background: #faf5ff !important;
    color: #7e22ce !important;
    border-color: #e9d5ff;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-warning .alert-icon {
    background: #fffbeb !important;
    color: #b45309 !important;
    border-color: #fde68a;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-danger .alert-icon {
    background: #fef2f2 !important;
    color: #b91c1c !important;
    border-color: #fecaca;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-teal .alert-icon {
    background: #f0fdfa !important;
    color: #0f766e !important;
    border-color: #99f6e4;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-cyan .alert-icon {
    background: #ecfeff !important;
    color: #0e7490 !important;
    border-color: #a5f3fc;
}

.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-label {
    color: #334155 !important;
    font-weight: 700;
    line-height: 1.35;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-value {
    color: #0f172a !important;
    font-weight: 800;
    line-height: 1.05;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-text {
    color: #64748b !important;
    line-height: 1.45;
}

.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert:hover {
    transform: translateY(-2px);
    border-color: #cbd5e1 !important;
    box-shadow: 0 10px 24px rgba(15,23,42,.09);
}

/* Ringkasan utama tetap berwarna sebagai penanda kategori,
   tetapi menggunakan warna yang lebih terkendali. */
.dashboard-page.role-admin .dashboard-section:first-of-type .dashboard-alert {
    min-height: 112px;
}
.dashboard-page.role-admin .dashboard-section:first-of-type .dashboard-alert::after {
    opacity: .55;
}

/* Header dashboard: beri ruang yang cukup agar judul dan identitas
   tidak bertumpuk pada layar desktop. */
.dashboard-page.role-admin .topbar-user {
    gap: 4px;
    white-space: nowrap;
}
.dashboard-page.role-admin .topbar-user strong {
    color: #1e293b;
}
.dashboard-page.role-admin .topbar-user span {
    color: #64748b;
}

@media (max-width: 767px) {
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert {
        min-height: 108px;
    }
    .dashboard-page.role-admin .topbar-user {
        max-width: 48vw;
        overflow: hidden;
        text-overflow: ellipsis;
    }
}

/* =========================================================
   UI REFINEMENT V3 — FULL COLOR + READABLE TEXT
   Keep the original full-color dashboard cards.
   Only typography/icon contrast is adjusted for readability.
   Presentation only. No business logic changes.
========================================================= */

/* Restore full-color dashboard cards from the original visual system. */
.dashboard-page .dashboard-alert-grid .dashboard-alert,
.dashboard-page .dashboard-section .dashboard-alert {
    border: 0 !important;
    color: #ffffff !important;
    overflow: hidden;
}

.dashboard-page .dashboard-alert-grid .dashboard-alert::before {
    display: block !important;
    opacity: .98 !important;
}

.dashboard-page .dashboard-alert-grid .dashboard-alert::after {
    z-index: -1 !important;
    background: rgba(255,255,255,.12) !important;
}

.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-info {
    background: linear-gradient(135deg, #2563eb 0%, #4338ca 100%) !important;
}
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-success {
    background: linear-gradient(135deg, #16a34a 0%, #047857 100%) !important;
}
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-purple {
    background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%) !important;
}
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-danger {
    background: linear-gradient(135deg, #ef4444 0%, #be123c 100%) !important;
}
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-teal {
    background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%) !important;
}
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-cyan {
    background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%) !important;
}

/* Orange/yellow needs dark text for stronger contrast. */
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-warning {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important;
    color: #172033 !important;
}

/* Text hierarchy: label < value < supporting description. */
.dashboard-page .dashboard-alert-grid .dashboard-alert .alert-label,
.dashboard-page .dashboard-alert-grid .dashboard-alert .alert-value,
.dashboard-page .dashboard-alert-grid .dashboard-alert .alert-text {
    position: relative;
    z-index: 2;
}

.dashboard-page .dashboard-alert-grid .dashboard-alert .alert-label {
    color: rgba(255,255,255,.98) !important;
    font-weight: 800;
    line-height: 1.3;
    text-shadow: 0 1px 1px rgba(0,0,0,.10);
}
.dashboard-page .dashboard-alert-grid .dashboard-alert .alert-value {
    color: #ffffff !important;
    font-weight: 900;
    line-height: 1.05;
    text-shadow: 0 1px 2px rgba(0,0,0,.14);
}
.dashboard-page .dashboard-alert-grid .dashboard-alert .alert-text {
    color: rgba(255,255,255,.92) !important;
    line-height: 1.42;
}

.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-warning .alert-label,
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-warning .alert-value {
    color: #172033 !important;
    text-shadow: none;
}
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-warning .alert-text {
    color: rgba(23,32,51,.88) !important;
}

/* Icons remain visually integrated with the full-color cards. */
.dashboard-page .dashboard-alert-grid .dashboard-alert .alert-icon {
    background: rgba(255,255,255,.18) !important;
    color: #ffffff !important;
    border: 1px solid rgba(255,255,255,.34) !important;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.14);
}
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-warning .alert-icon {
    background: rgba(255,255,255,.28) !important;
    color: #172033 !important;
    border-color: rgba(23,32,51,.18) !important;
}

/* Keep the cards functional rather than decorative: restrained hover only. */
.dashboard-page .dashboard-alert-grid .dashboard-alert:hover {
    transform: translateY(-2px);
    border-color: transparent !important;
    box-shadow: 0 12px 28px rgba(15,23,42,.14);
}

/* =========================================================
   UI MASTER VISUAL — FULL COLOR / HIGH READABILITY
   Applied from approved SPLASMA visual reference.
   Presentation only. No business logic changes.
========================================================= */

/* Full-color cards: white typography is the default on saturated backgrounds. */
.dashboard-page .dashboard-alert-grid .dashboard-alert,
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-warning {
    color: #fff !important;
}

.dashboard-page .dashboard-alert-grid .dashboard-alert .alert-label,
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-warning .alert-label {
    color: rgba(255,255,255,.98) !important;
    font-size: 14px !important;
    font-weight: 800 !important;
    line-height: 1.25 !important;
    text-shadow: 0 1px 2px rgba(0,0,0,.16);
}

.dashboard-page .dashboard-alert-grid .dashboard-alert .alert-value,
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-warning .alert-value {
    color: #fff !important;
    font-size: 30px !important;
    font-weight: 900 !important;
    line-height: 1.02 !important;
    letter-spacing: -.03em !important;
    text-shadow: 0 1px 2px rgba(0,0,0,.18);
}

.dashboard-page .dashboard-alert-grid .dashboard-alert .alert-text,
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-warning .alert-text {
    color: rgba(255,255,255,.94) !important;
    font-size: 13px !important;
    line-height: 1.4 !important;
    font-weight: 500 !important;
    text-shadow: 0 1px 1px rgba(0,0,0,.10);
}

/* Larger, more expressive icon treatment. The icon glyph carries the card identity. */
.dashboard-page .dashboard-alert-grid .dashboard-alert .alert-icon,
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-warning .alert-icon {
    width: 50px !important;
    height: 50px !important;
    flex-basis: 50px !important;
    border-radius: 15px !important;
    font-size: 22px !important;
    background: rgba(255,255,255,.92) !important;
    border: 1px solid rgba(255,255,255,.72) !important;
    box-shadow: 0 5px 14px rgba(15,23,42,.10), inset 0 1px 0 rgba(255,255,255,.8);
    text-shadow: none !important;
}

.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-info .alert-icon,
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-cyan .alert-icon {
    color: #2563eb !important;
}
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-success .alert-icon {
    color: #16a34a !important;
}
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-purple .alert-icon {
    color: #7c3aed !important;
}
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-danger .alert-icon {
    color: #dc2626 !important;
}
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-warning .alert-icon {
    color: #d97706 !important;
}
.dashboard-page .dashboard-alert-grid .dashboard-alert.alert-teal .alert-icon {
    color: #0f766e !important;
}

/* Give the content a little more breathing room after enlarging typography. */
.dashboard-page .dashboard-alert-grid .dashboard-alert {
    min-height: 122px;
    padding: 18px 19px;
    gap: 15px;
}

@media (max-width: 700px) {
    .dashboard-page .dashboard-alert-grid .dashboard-alert .alert-value {
        font-size: 27px !important;
    }
    .dashboard-page .dashboard-alert-grid .dashboard-alert .alert-label {
        font-size: 13px !important;
    }
    .dashboard-page .dashboard-alert-grid .dashboard-alert .alert-text {
        font-size: 12px !important;
    }
}


/* =========================================================
   UI MASTER V5 — REFERENCE MATCH / EQUAL CARDS / CLEAR TEXT
   Presentation only. No business logic or database changes.
========================================================= */

/* Header must contain all of its text; prevent the school subtitle
   from falling into the dashboard content area. */
.dashboard-page .topbar{
    height:92px !important;
    align-items:center !important;
}
.dashboard-page .main{
    padding-top:92px !important;
}
.dashboard-page .topbar > div:first-child{
    min-width:0;
}
.dashboard-page .topbar > div:first-child h1{
    margin:0 !important;
    line-height:1.05 !important;
}
.dashboard-page .topbar .topbar-subtitle{
    display:block !important;
    margin-top:4px !important;
    line-height:1.2 !important;
}

/* Keep the dashboard introduction compact and separated from the header. */
.dashboard-page .dashboard-hero{
    margin-top:0 !important;
    margin-bottom:12px !important;
}
.dashboard-page .dashboard-context{
    margin-bottom:14px !important;
}

/* Admin cards: force equal dimensions and keep the content inside the card. */
.dashboard-page.role-admin .dashboard-alert-grid{
    grid-auto-rows:154px;
    align-items:stretch;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert{
    height:154px !important;
    min-height:154px !important;
    box-sizing:border-box !important;
    display:flex !important;
    align-items:flex-start !important;
    padding:18px 18px !important;
    gap:14px !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert > div:last-child{
    min-width:0 !important;
    flex:1 1 auto !important;
    padding:0 !important;
}

/* IMPORTANT: override the older role-admin readability rules with the
   approved full-color reference. */
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-label{
    color:rgba(255,255,255,.98) !important;
    font-size:15px !important;
    font-weight:800 !important;
    line-height:1.2 !important;
    margin:0 0 4px !important;
    text-shadow:0 1px 2px rgba(0,0,0,.16) !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-value{
    color:#fff !important;
    font-size:31px !important;
    font-weight:900 !important;
    line-height:1 !important;
    margin:0 !important;
    text-shadow:0 1px 2px rgba(0,0,0,.18) !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-text{
    color:rgba(255,255,255,.94) !important;
    font-size:13px !important;
    font-weight:500 !important;
    line-height:1.28 !important;
    margin-top:6px !important;
    text-shadow:0 1px 1px rgba(0,0,0,.12) !important;
    overflow-wrap:normal !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-icon{
    width:52px !important;
    height:52px !important;
    flex:0 0 52px !important;
    border-radius:15px !important;
    background:rgba(255,255,255,.95) !important;
    border:1px solid rgba(255,255,255,.8) !important;
    box-shadow:0 5px 14px rgba(15,23,42,.10) !important;
