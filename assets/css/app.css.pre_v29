.izin-module .badge.bg-primary{background:#2563eb !important;color:#fff !important}
.izin-module .badge.bg-success{background:#16a34a !important;color:#fff !important}
.izin-module .badge.bg-danger{background:#dc2626 !important;color:#fff !important}
.izin-module .badge.bg-secondary{background:#64748b !important;color:#fff !important}

/* Sholat: action hierarchy is explicit instead of a mixed button row. */
.sholat-module .sholat-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap}
.sholat-module .sholat-actions .btn-primary{background:#2563eb !important;border-color:#2563eb !important;color:#fff !important}
.sholat-module .sholat-actions .btn-secondary{background:#64748b !important;border-color:#64748b !important;color:#fff !important}
.sholat-module .sholat-actions a:nth-of-type(2){background:#0891b2 !important;border-color:#0891b2 !important;color:#fff !important}
.sholat-module .sholat-actions a:nth-of-type(3){background:#f59e0b !important;border-color:#f59e0b !important;color:#fff !important}
.sholat-module .sholat-actions a:nth-of-type(4){background:#7c3aed !important;border-color:#7c3aed !important;color:#fff !important}
.sholat-module .action-divider{display:none !important}
.sholat-module .sholat-session-card{min-height:128px !important;height:128px !important}

/* Sholat subpages. */
.sholat-submodule .page-header-actions{display:flex;gap:8px;flex-wrap:wrap}
.sholat-submodule .page-header-actions .btn-primary{background:#2563eb !important;border-color:#2563eb !important;color:#fff !important}
.sholat-submodule .page-header-actions .btn-secondary{background:#64748b !important;border-color:#64748b !important;color:#fff !important}
.sholat-submodule .page-header-actions .btn.btn-info{background:#06b6d4 !important;border-color:#06b6d4 !important;color:#fff !important}
.sholat-submodule .table-actions .btn-secondary{background:#f59e0b !important;border-color:#f59e0b !important;color:#fff !important}
.sholat-submodule .table-actions .btn-danger{background:#dc2626 !important;border-color:#dc2626 !important;color:#fff !important}
.sholat-submodule .form-actions .btn-primary{background:#16a34a !important;border-color:#16a34a !important;color:#fff !important}
.sholat-submodule .form-actions .btn-secondary{background:#64748b !important;border-color:#64748b !important;color:#fff !important}
.sholat-submodule .status-aktif{background:#dcfce7 !important;color:#166534 !important}
.sholat-submodule .status-draft{background:#fef3c7 !important;color:#92400e !important}
.sholat-submodule .status-ditutup{background:#e2e8f0 !important;color:#334155 !important}

/* Scanner: operational UI, less prose, clearer hierarchy. */
.scanner-module .page-header h1{margin-bottom:3px !important}
.scanner-module .page-header p{font-size:13px !important;margin:0 !important;color:#64748b !important}
.scanner-module .camera-controls{display:flex;align-items:end;gap:10px;flex-wrap:wrap;padding:12px;background:#fff;border:1px solid #dbe3ee;border-radius:14px;margin-bottom:12px}
.scanner-module .camera-controls .camera-select-wrap{flex:1 1 280px}
.scanner-module .camera-controls .btn{background:#2563eb !important;border-color:#2563eb !important;color:#fff !important}
.scanner-module .form-actions{gap:8px !important}
.scanner-module #startCamera{background:#16a34a !important;border-color:#16a34a !important;color:#fff !important}
.scanner-module #stopCamera{background:#64748b !important;border-color:#64748b !important;color:#fff !important}
.scanner-module #closeScanner{background:#dc2626 !important;border-color:#dc2626 !important;color:#fff !important}
.scanner-module #prepareDecoder{background:#7c3aed !important;border-color:#7c3aed !important;color:#fff !important}
.scanner-module .scanner-reader{background:#0f172a !important;border:1px solid #1e293b !important;border-radius:14px !important;overflow:hidden}
.scanner-module .scanner-placeholder{color:#fff !important}
.scanner-module .source-hints>div{background:#fff !important;border:1px solid #dbe3ee !important}
.scanner-module .source-hints strong{color:#0f172a !important}
.scanner-module .scan-result{border:1px solid #dbe3ee !important;background:#fff !important;color:#0f172a !important}
.scanner-module .recent-card{background:#fff !important;border:1px solid #dbe3ee !important}
.scanner-module .sound-toggle{background:#7c3aed !important;color:#fff !important;border-color:#7c3aed !important}

@media(max-width:900px){
 .sholat-module .sholat-actions{justify-content:flex-start}
 .sholat-module .sholat-session-card{height:auto !important;min-height:118px !important}
}


/* V20.1 — Sholat settings pages: same table/action language. */
.sholat-settings-module .dashboard-table-card,
.sholat-settings-module .form-card{
  background:#fff !important;
  border:1px solid #dbe3ee !important;
  box-shadow:0 6px 18px rgba(15,23,42,.045) !important;
}
.sholat-settings-module .data-table{
  background:#fff !important;
  border-collapse:separate !important;
  border-spacing:0 !important;
}
.sholat-settings-module .data-table thead th{
  background:#2563eb !important;
  background-image:none !important;
  color:#fff !important;
  border:0 !important;
  font-size:12px !important;
  font-weight:800 !important;
  white-space:nowrap;
}
.sholat-settings-module .data-table tbody td{
  background:#fff !important;
  color:#1e293b !important;
  border-bottom:1px solid #e5eaf1 !important;
  vertical-align:middle !important;
}
.sholat-settings-module .data-table tbody tr:nth-child(even) td{background:#f8fbff !important}
.sholat-settings-module .data-table tbody tr:hover td{background:#eef5ff !important}
.sholat-settings-module .page-header-actions{display:flex;gap:8px;flex-wrap:wrap}
.sholat-settings-module .page-header-actions .btn-primary{background:#2563eb !important;border-color:#2563eb !important;color:#fff !important}
.sholat-settings-module .page-header-actions .btn-secondary{background:#64748b !important;border-color:#64748b !important;color:#fff !important}
.sholat-settings-module .table-actions .btn-secondary{background:#f59e0b !important;border-color:#f59e0b !important;color:#fff !important}
.sholat-settings-module .table-actions .btn-primary{background:#16a34a !important;border-color:#16a34a !important;color:#fff !important}
.sholat-settings-module .table-actions .btn-danger{background:#dc2626 !important;border-color:#dc2626 !important;color:#fff !important}
.sholat-settings-module .form-actions .btn-primary{background:#16a34a !important;border-color:#16a34a !important;color:#fff !important}
.sholat-settings-module .form-actions .btn-secondary{background:#64748b !important;border-color:#64748b !important;color:#fff !important}
.sholat-settings-module .status-aktif{background:#dcfce7 !important;color:#166534 !important}
.sholat-settings-module .status-nonaktif{background:#fee2e2 !important;color:#991b1b !important}
.sholat-settings-module .pagination .btn-secondary{background:#64748b !important;border-color:#64748b !important;color:#fff !important}


/* =========================================================
   V22 — KESISWAAN & BK UI STANDARD
   Presentation only. No DB, route, permission, transaction,
   workflow, status, or business-logic changes.
   ========================================================= */

/* Shared page rhythm */
.content .pel-hero,
.content .pb-hero,
.content .hv-hero{
    background:#fff !important;
    color:var(--text-primary,#172033) !important;
    border:1px solid #e2e8f0 !important;
    border-radius:16px !important;
    padding:18px 20px !important;
    margin-bottom:16px !important;
    box-shadow:0 5px 18px rgba(15,23,42,.05) !important;
}
.content .pel-hero h1,
.content .pb-hero h1,
.content .hv-hero h1{
    color:#172033 !important;
    font-size:22px !important;
    line-height:1.25 !important;
}
.content .pel-hero p,
.content .pb-hero p,
.content .hv-hero p{
    color:#64748b !important;
    font-size:13px !important;
    line-height:1.55 !important;
}

/* Equal, compact, functional status cards */
.content .pel-grid,
.content .pb-grid,
.content .hv-grid{
    grid-template-columns:repeat(4,minmax(0,1fr)) !important;
    gap:12px !important;
    margin-bottom:16px !important;
}
.content .pel-card,
.content .pb-card,
.content .hv-card{
    position:relative;
    min-height:116px;
    padding:16px 17px !important;
    border:0 !important;
    border-radius:15px !important;
    color:#fff !important;
    box-shadow:0 7px 18px rgba(15,23,42,.10) !important;
    overflow:hidden;
}
.content .pel-card::after,
.content .pb-card::after,
.content .hv-card::after{
    content:'';
    position:absolute;
    width:88px;height:88px;
    right:-25px;bottom:-34px;
    border-radius:50%;
    background:rgba(255,255,255,.12);
    pointer-events:none;
}
.content .pel-card .pel-label,
.content .pb-card .pb-label,
.content .hv-card .hv-label{
    color:rgba(255,255,255,.90) !important;
    font-size:11px !important;
    font-weight:800 !important;
    letter-spacing:.02em;
}
.content .pel-card .pel-num,
.content .pb-card .pb-num,
.content .hv-card .hv-num{
    color:#fff !important;
    font-size:27px !important;
    line-height:1.05 !important;
    font-weight:900 !important;
    margin-top:7px;
}
.content .pel-card small,
.content .pb-card small,
.content .hv-card small{
    color:rgba(255,255,255,.88) !important;
    font-size:11px !important;
}
/* Semantic colors: blue = total, green = active/completed, orange = attention, red = warning */
.content .pel-grid .pel-card:nth-child(1),
.content .pb-grid .pb-card:nth-child(1),
.content .hv-grid .hv-card:nth-child(1){background:linear-gradient(135deg,#2563eb,#4338ca) !important;}
.content .pel-grid .pel-card:nth-child(2),
.content .pb-grid .pb-card:nth-child(2),
.content .hv-grid .hv-card:nth-child(3){background:linear-gradient(135deg,#16a34a,#047857) !important;}
.content .pel-grid .pel-card:nth-child(3),
.content .pb-grid .pb-card:nth-child(3),
.content .hv-grid .hv-card:nth-child(2){background:linear-gradient(135deg,#f59e0b,#d97706) !important;}
.content .pel-grid .pel-card:nth-child(4),
.content .pb-grid .pb-card:nth-child(4),
.content .hv-grid .hv-card:nth-child(4){background:linear-gradient(135deg,#ef4444,#be123c) !important;}
.content .pel-grid .pel-card:nth-child(3){background:linear-gradient(135deg,#7c3aed,#6d28d9) !important;}

/* BK dashboard statistics */
.content .bk-v2 .bk-stat{
    border:0 !important;
    border-radius:15px !important;
    min-height:112px !important;
    box-shadow:0 7px 18px rgba(15,23,42,.10) !important;
}
.content .bk-v2 .bk-stat:nth-child(1){background:linear-gradient(135deg,#2563eb,#4338ca) !important;color:#fff !important;}
.content .bk-v2 .bk-stat:nth-child(2){background:linear-gradient(135deg,#f59e0b,#d97706) !important;color:#fff !important;}
.content .bk-v2 .bk-stat:nth-child(3){background:linear-gradient(135deg,#0ea5e9,#0284c7) !important;color:#fff !important;}
.content .bk-v2 .bk-stat:nth-child(4){background:linear-gradient(135deg,#16a34a,#047857) !important;color:#fff !important;}
.content .bk-v2 .bk-stat-number,
.content .bk-v2 .bk-stat-label{color:#fff !important;}
.content .bk-v2 .bk-stat-icon{background:rgba(255,255,255,.18) !important;color:#fff !important;}

/* Tables: consistent professional header + compact rows */
.content .data-table{
    border-collapse:separate !important;
    border-spacing:0 !important;
    overflow:hidden;
    border:1px solid #e2e8f0 !important;
    border-radius:12px !important;
}
.content .data-table thead th{
    background:linear-gradient(135deg,#2563eb,#4338ca) !important;
    color:#fff !important;
    border-color:rgba(255,255,255,.16) !important;
    font-size:12px !important;
    font-weight:800 !important;
    letter-spacing:.01em;
    white-space:nowrap;
}
.content .data-table tbody td{
    font-size:13px !important;
    padding:10px 12px !important;
    vertical-align:middle !important;
}
.content .data-table tbody tr:nth-child(even){background:#f8fafc !important;}
.content .data-table tbody tr:hover{background:#eff6ff !important;}

/* Functional action buttons inside tables */
.content .data-table .btn.btn-sm.btn-secondary{
    background:#06b6d4 !important;color:#fff !important;border-color:#06b6d4 !important;
}
.content .data-table .btn.btn-sm.btn-primary{
    background:#f59e0b !important;color:#fff !important;border-color:#f59e0b !important;
}
.content .data-table .btn.btn-sm.btn-danger{
    background:#ef4444 !important;color:#fff !important;border-color:#ef4444 !important;
}
.content .data-table .btn.btn-sm.btn-success{
    background:#16a34a !important;color:#fff !important;border-color:#16a34a !important;
}
.content .data-table .btn.btn-sm.btn-warning{
    background:#f59e0b !important;color:#fff !important;border-color:#f59e0b !important;
}

/* Filter blocks: compact and aligned, never stretch unnecessarily */
.content .pel-filter,
.content .pb-filter,
.content .hv-filter,
.content .bk-filter{
    align-items:end !important;
    gap:10px !important;
}
.content .filter-row,
.content .pb-filter,
.content .hv-filter{
    display:flex !important;
    flex-wrap:wrap !important;
}
.content .filter-row label,
.content .pb-filter label,
.content .hv-filter label{
    min-width:180px;
    flex:1 1 180px;
}
.content .filter-row label:first-child,
.content .pb-filter label:first-child,
.content .hv-filter label:first-child{flex-basis:260px;}

/* Compact page-level buttons */
.content .pel-hero .btn,
.content .pb-hero .btn,
.content .hv-hero .btn,
.content .page-header-actions .btn{
    min-height:40px !important;
    padding:9px 14px !important;
    font-size:13px !important;
    font-weight:800 !important;
    border-radius:10px !important;
}

/* BK internal tabs: one compact control strip */
.content .bk-tabs{
    gap:5px !important;
    padding:5px !important;
    margin-bottom:14px !important;
    background:#f1f5f9 !important;
    border:1px solid #e2e8f0 !important;
    border-radius:12px !important;
}
.content .bk-tab{
    padding:9px 12px !important;
    border-radius:9px !important;
    font-size:12px !important;
    color:#475569 !important;
}
.content .bk-tab.active{
    background:#2563eb !important;
    color:#fff !important;
    box-shadow:0 4px 10px rgba(37,99,235,.18) !important;
}
.content .bk-tab-count{
    background:rgba(255,255,255,.18) !important;
}

/* Prevent old decorative backgrounds from leaking through tables/cards */
.content .pel-table,
.content .pb-table,
.content .hv-table,
.content .bk-v2 .bk-table-card{
    background:#fff !important;
    border:1px solid #e2e8f0 !important;
    border-radius:15px !important;
    box-shadow:0 4px 14px rgba(15,23,42,.04) !important;
}

@media (max-width: 1000px){
    .content .pel-grid,.content .pb-grid,.content .hv-grid{grid-template-columns:repeat(2,minmax(0,1fr)) !important;}
}
@media (max-width: 640px){
    .content .pel-grid,.content .pb-grid,.content .hv-grid{grid-template-columns:1fr !important;}
    .content .pel-card,.content .pb-card,.content .hv-card{min-height:104px !important;}
    .content .filter-row label,.content .pb-filter label,.content .hv-filter label{min-width:100%;flex-basis:100% !important;}
}

/* Kesiswaan & BK semantic sidebar icons */
.sidebar .sidebar-group[data-sidebar-group="kesiswaan-bk"] .menu-item:nth-child(1) .menu-icon{color:#22c55e;background:rgba(34,197,94,.10);}
.sidebar .sidebar-group[data-sidebar-group="kesiswaan-bk"] .menu-item:nth-child(2) .menu-icon{color:#a78bfa;background:rgba(167,139,250,.10);}
.sidebar .sidebar-group[data-sidebar-group="kesiswaan-bk"] .menu-item:nth-child(3) .menu-icon{color:#f87171;background:rgba(248,113,113,.10);}
.sidebar .sidebar-group[data-sidebar-group="kesiswaan-bk"] .menu-item:nth-child(4) .menu-icon{color:#fbbf24;background:rgba(251,191,36,.10);}
.sidebar .sidebar-group[data-sidebar-group="kesiswaan-bk"] .menu-item:nth-child(5) .menu-icon{color:#2dd4bf;background:rgba(45,212,191,.10);}
.sidebar .sidebar-group[data-sidebar-group="kesiswaan-bk"] .menu-item:hover .menu-icon{color:#fff;}
.sidebar .sidebar-group[data-sidebar-group="kesiswaan-bk"] .menu-item.active .menu-icon{color:#fff;background:rgba(255,255,255,.18);}


/* =====================================================
   SPLASMA V25 — EKSTRAKURIKULER SAYA
   Visual only: hero identity + full-color functional tiles.
===================================================== */
.extra-page .extra-assignment-list{display:flex;flex-direction:column;gap:22px;}
.extra-page .extra-program{display:flex;flex-direction:column;gap:14px;}
.extra-page .extra-program-hero{position:relative;overflow:hidden;min-height:176px;padding:28px 34px;border-radius:22px;color:#fff;background:linear-gradient(135deg,#2563eb 0%,#4338ca 62%,#7c3aed 100%);box-shadow:0 12px 28px rgba(37,99,235,.18);display:flex;align-items:center;justify-content:space-between;}
.extra-page .extra-program-hero::before,.extra-page .extra-program-hero::after{content:"";position:absolute;border-radius:50%;background:rgba(255,255,255,.10);pointer-events:none;}
.extra-page .extra-program-hero::before{width:210px;height:210px;right:80px;top:-135px;}
.extra-page .extra-program-hero::after{width:180px;height:180px;right:-35px;bottom:-120px;}
.extra-page .extra-program-identity{position:relative;z-index:1;display:flex;align-items:center;gap:20px;min-width:0;}
.extra-page .extra-program-icon{width:76px;height:76px;display:grid;place-items:center;flex:0 0 76px;border-radius:20px;background:rgba(255,255,255,.17);border:1px solid rgba(255,255,255,.30);box-shadow:inset 0 1px 0 rgba(255,255,255,.16);font-size:34px;}
.extra-page .extra-card-kicker{font-size:13px;font-weight:750;letter-spacing:.01em;opacity:.88;margin-bottom:4px;color:rgba(255,255,255,.92);}
.extra-page .extra-program-hero h2{margin:0 0 9px!important;color:#fff!important;font-size:clamp(1.7rem,2.8vw,2.35rem)!important;line-height:1.08!important;font-weight:850!important;}
.extra-page .extra-card-meta{display:flex;align-items:center;flex-wrap:wrap;gap:10px;font-size:13px;font-weight:650;color:rgba(255,255,255,.95);}
.extra-page .extra-code{padding:5px 10px;border-radius:8px;background:rgba(255,255,255,.17);border:1px solid rgba(255,255,255,.25);font-weight:800;color:#fff;}
.extra-page .extra-program-mark{position:relative;z-index:1;margin-right:8%;font-size:88px;line-height:1;color:rgba(255,255,255,.80);filter:drop-shadow(0 8px 12px rgba(15,23,42,.10));}
.extra-page .extra-action-grid{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px!important;margin:0!important;}
.extra-page .extra-action{min-height:108px;padding:16px 18px!important;border:0!important;border-radius:16px!important;color:#fff!important;display:flex!important;align-items:center;gap:13px;text-decoration:none!important;box-shadow:0 8px 18px rgba(15,23,42,.10)!important;position:relative;overflow:hidden;transition:transform .15s ease,box-shadow .15s ease,filter .15s ease;}
.extra-page .extra-action::after{content:"";position:absolute;right:-32px;bottom:-45px;width:115px;height:115px;border-radius:50%;background:rgba(255,255,255,.13);pointer-events:none;}
.extra-page .extra-action:hover{color:#fff!important;transform:translateY(-2px);filter:brightness(1.04);box-shadow:0 12px 22px rgba(15,23,42,.14)!important;}
.extra-page .extra-action-icon{width:50px;height:50px;display:grid;place-items:center;flex:0 0 50px;border-radius:14px;background:rgba(255,255,255,.17);border:1px solid rgba(255,255,255,.22);font-size:21px;position:relative;z-index:1;}
.extra-page .extra-action>span:not(.extra-action-icon){position:relative;z-index:1;font-size:15px;font-weight:800;line-height:1.2;}
.extra-page .extra-action-arrow{margin-left:auto;position:relative;z-index:1;width:30px;height:30px;display:grid;place-items:center;border-radius:50%;background:rgba(255,255,255,.90);color:inherit;font-size:23px;line-height:1;}
.extra-page .extra-action-anggota{background:linear-gradient(135deg,#16a34a,#047857)!important;}
.extra-page .extra-action-jadwal{background:linear-gradient(135deg,#2563eb,#1d4ed8)!important;}
.extra-page .extra-action-absensi{background:linear-gradient(135deg,#f97316,#ea580c)!important;}
.extra-page .extra-action-rekap{background:linear-gradient(135deg,#7c3aed,#6d28d9)!important;}
.extra-page .extra-action-pembina{background:linear-gradient(135deg,#0891b2,#0e7490)!important;}
.extra-page .extra-action-jurnal{background:linear-gradient(135deg,#ef4444,#be123c)!important;}
.extra-page .extra-action-kendala{background:linear-gradient(135deg,#eab308,#d97706)!important;}
.extra-page .extra-action-foto{background:linear-gradient(135deg,#db2777,#be185d)!important;}
@media (max-width:1100px){.extra-page .extra-action-grid{grid-template-columns:repeat(2,minmax(0,1fr));}.extra-page .extra-program-mark{margin-right:3%;}}
@media (max-width:700px){.extra-page .extra-program-hero{padding:22px;min-height:150px;border-radius:18px;}.extra-page .extra-program-icon{width:60px;height:60px;flex-basis:60px;font-size:27px;border-radius:16px;}.extra-page .extra-program-identity{gap:14px;}.extra-page .extra-program-mark{display:none;}.extra-page .extra-action{min-height:88px;padding:13px!important;border-radius:14px!important;gap:10px;}.extra-page .extra-action-icon{width:43px;height:43px;flex-basis:43px;font-size:18px;border-radius:12px;}.extra-page .extra-action>span:not(.extra-action-icon){font-size:13px;}}
@media (max-width:520px){.extra-page .extra-action-grid{grid-template-columns:1fr;}.extra-page .extra-program-hero h2{font-size:1.55rem!important;}.extra-page .extra-card-meta{font-size:12px;}}

/* =====================================================
   V26 — SISTEM & KONFIGURASI HUB
   Presentation/navigation only. Existing business logic untouched.
===================================================== */
.settings-module .settings-page-header{margin-bottom:22px}
.settings-module .settings-page-header h1{display:flex;align-items:center;gap:10px}
.settings-module .settings-page-header h1 i{color:#4f46e5}
.settings-section-head{display:flex;align-items:center;gap:12px;margin:22px 0 11px}
.settings-section-icon{width:42px;height:42px;border-radius:13px;display:inline-flex;align-items:center;justify-content:center;font-size:18px;background:#eef2ff;border:1px solid #dbe4ff}
.settings-section-head h2{margin:0;font-size:17px;color:#172a46}
.settings-section-head p{margin:3px 0 0;color:#71809a;font-size:11.5px;line-height:1.45}
.settings-card-grid{display:grid;gap:14px;min-width:0}
.settings-card-grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}
.settings-card-grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}
.settings-card{position:relative;min-height:132px;padding:17px 18px;border:0!important;border-radius:17px!important;color:#fff!important;text-decoration:none!important;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-start;overflow:hidden;box-sizing:border-box;box-shadow:0 10px 25px rgba(15,23,42,.11);transition:transform .16s ease,box-shadow .16s ease,filter .16s ease}
.settings-card::after{content:"";position:absolute;width:105px;height:105px;border-radius:50%;right:-28px;bottom:-48px;background:rgba(255,255,255,.12);pointer-events:none}
.settings-card:hover{color:#fff!important;transform:translateY(-2px);filter:brightness(1.03);box-shadow:0 15px 30px rgba(15,23,42,.15)}
.settings-card-icon{width:42px;height:42px;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.17);border:1px solid rgba(255,255,255,.30);font-size:19px;color:#fff;flex:0 0 42px;margin-bottom:11px;box-shadow:inset 0 1px 0 rgba(255,255,255,.14)}
.settings-card strong{font-size:13px;line-height:1.3;color:#fff!important;position:relative;z-index:1}
.settings-card>span:last-child,.settings-card>div span{font-size:10.5px;line-height:1.45;color:rgba(255,255,255,.94)!important;margin-top:5px;position:relative;z-index:1}
.settings-card-feature{min-height:116px;display:grid;grid-template-columns:42px minmax(0,1fr) auto;column-gap:12px;align-items:center;padding:16px 18px}
.settings-card-feature .settings-card-icon{margin:0}
.settings-card-feature strong{display:block;font-size:14px}
.settings-card-feature div span{display:block}
.settings-card-arrow{font-size:20px;color:rgba(255,255,255,.88);position:relative;z-index:1}
.settings-note{display:flex;align-items:flex-start;gap:11px;margin-top:18px;padding:13px 15px;border:1px solid #dbe7f5;border-left:4px solid #2563eb;border-radius:13px;background:#f7fbff;color:#31506f}
.settings-note>i{font-size:17px;color:#2563eb;margin-top:1px}
.settings-note strong{display:block;font-size:12px;color:#173b64;margin-bottom:2px}
.settings-note span{display:block;font-size:11px;line-height:1.5;color:#61758e}
.settings-blue{background:linear-gradient(135deg,#2563eb,#3730a3)!important}
.settings-indigo{background:linear-gradient(135deg,#4f46e5,#6d28d9)!important}
.settings-cyan{background:linear-gradient(135deg,#0891b2,#0e7490)!important}
.settings-violet{background:linear-gradient(135deg,#7c3aed,#6d28d9)!important}
.settings-teal{background:linear-gradient(135deg,#0f9bb2,#0f766e)!important}
.settings-green{background:linear-gradient(135deg,#16a34a,#047857)!important}
.settings-emerald{background:linear-gradient(135deg,#059669,#0f766e)!important}
.settings-amber{background:linear-gradient(135deg,#f59e0b,#d97706)!important}
.settings-orange{background:linear-gradient(135deg,#f97316,#ea580c)!important}
.settings-sky{background:linear-gradient(135deg,#0284c7,#0369a1)!important}
.settings-slate{background:linear-gradient(135deg,#475569,#334155)!important}
.attendance-settings-module .settings-card{min-height:142px}
@media(max-width:1050px){.settings-card-grid-3{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.settings-card-grid-2,.settings-card-grid-3{grid-template-columns:1fr}.settings-card,.attendance-settings-module .settings-card{min-height:122px}.settings-card-feature{grid-template-columns:42px minmax(0,1fr) auto}.settings-section-head{align-items:flex-start}.settings-section-icon{flex:0 0 42px}}


/* ================================================================
   UI V27 — FULL COLOR MODULE THEMES
   Presentation only: no business logic / database changes.
   ================================================================ */

/* Shared visual language for supporting modules */
:root{
  --ui-blue:#2563eb; --ui-green:#16a34a; --ui-purple:#7c3aed;
  --ui-orange:#f59e0b; --ui-red:#ef4444; --ui-cyan:#0891b2;
  --ui-pink:#db2777; --ui-indigo:#4f46e5; --ui-slate:#475569;
}

/* Strong, readable table headers */
.data-table thead th,
.table thead th{
  background:linear-gradient(135deg,#2563eb,#4338ca)!important;
  color:#fff!important;
  border-color:rgba(255,255,255,.16)!important;
  font-weight:800!important;
  letter-spacing:.02em;
}
.data-table tbody tr:hover,
.table-hover tbody tr:hover{background:#eff6ff!important}

/* ---------------- LIBRARY ---------------- */
.perpus .stats .stat:nth-child(1){background:linear-gradient(135deg,#2563eb,#4338ca);color:#fff;border:0}
.perpus .stats .stat:nth-child(2){background:linear-gradient(135deg,#16a34a,#047857);color:#fff;border:0}
.perpus .stats .stat:nth-child(3){background:linear-gradient(135deg,#7c3aed,#6d28d9);color:#fff;border:0}
.perpus .stats .stat:nth-child(4){background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;border:0}
.perpus .stats .stat:nth-child(5){background:linear-gradient(135deg,#0891b2,#0e7490);color:#fff;border:0}
.perpus .stats .ico{background:rgba(255,255,255,.18);color:#fff;border:1px solid rgba(255,255,255,.22)}
.perpus .lab{color:rgba(255,255,255,.82)}
.perpus .num{color:#fff}
.perpus .op-grid{grid-template-columns:repeat(4,minmax(0,1fr))}
.perpus .op-card{color:#fff;border:0;min-height:92px;box-shadow:0 8px 20px rgba(15,23,42,.10)}
.perpus .op-card.primary{background:linear-gradient(135deg,#2563eb,#4338ca);border:0}
.perpus .op-card.success{background:linear-gradient(135deg,#16a34a,#047857);border:0}
.perpus .op-card:nth-child(3){background:linear-gradient(135deg,#f97316,#ea580c)}
.perpus .op-card:nth-child(4){background:linear-gradient(135deg,#7c3aed,#6d28d9)}
.perpus .op-card:nth-child(5){background:linear-gradient(135deg,#0891b2,#0e7490)}
.perpus .op-card:nth-child(6){background:linear-gradient(135deg,#db2777,#be185d)}
.perpus .op-card:nth-child(7){background:linear-gradient(135deg,#eab308,#d97706)}
.perpus .op-card:nth-child(8){background:linear-gradient(135deg,#475569,#334155)}
.perpus .op-card .op-ico,.perpus .op-card.success .op-ico{background:rgba(255,255,255,.18);color:#fff;border:1px solid rgba(255,255,255,.22)}
.perpus .op-card small{color:rgba(255,255,255,.82)}
.perpus-page .form-card,.perpus-page .pv-card,.perpus-page .loan-manual,.perpus-page .loan-scan{border:1px solid #dbe4ef;box-shadow:0 8px 24px rgba(15,23,42,.05)}
.perpus-page .form-card h2,.perpus-page .form-card h3{color:#172554}
.perpus-page .btn-primary{background:linear-gradient(135deg,#2563eb,#4338ca)!important;border-color:#2563eb!important;color:#fff!important}
.perpus-page .btn-success{background:linear-gradient(135deg,#16a34a,#047857)!important;border-color:#16a34a!important;color:#fff!important}
.perpus-page .btn-warning{background:linear-gradient(135deg,#f59e0b,#d97706)!important;border-color:#f59e0b!important;color:#fff!important}
.perpus-page .btn-danger{background:linear-gradient(135deg,#ef4444,#dc2626)!important;border-color:#ef4444!important;color:#fff!important}
.perpus-page .btn-info{background:linear-gradient(135deg,#06b6d4,#0891b2)!important;border-color:#06b6d4!important;color:#fff!important}
.perpus-page .btn-secondary{background:#475569!important;border-color:#475569!important;color:#fff!important}
.perpus-page .btn-outline-primary{border:1px solid #2563eb!important;color:#2563eb!important;background:#fff!important}
.perpus-page .scan-reader,.perpus-page .pv-reader{background:linear-gradient(145deg,#0f172a,#1e3a8a);box-shadow:inset 0 0 0 1px rgba(255,255,255,.08)}
.perpus-page .scan-status.success{background:#dcfce7;color:#166534;border-left:4px solid #16a34a}
.perpus-page .scan-status.error{background:#fee2e2;color:#991b1b;border-left:4px solid #ef4444}
.perpus-page .selected-student{background:linear-gradient(135deg,#eff6ff,#dbeafe);border-color:#93c5fd}
.perpus-page .data-table tbody td{vertical-align:middle}
.librep .stats .stat:nth-child(1){background:linear-gradient(135deg,#2563eb,#4338ca);color:#fff;border:0}
.librep .stats .stat:nth-child(2){background:linear-gradient(135deg,#16a34a,#047857);color:#fff;border:0}
.librep .stats .stat:nth-child(3){background:linear-gradient(135deg,#7c3aed,#6d28d9);color:#fff;border:0}
.librep .stats .stat:nth-child(4){background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;border:0}
.librep .stats .stat:nth-child(5){background:linear-gradient(135deg,#0891b2,#0e7490);color:#fff;border:0}
.librep .stats .stat:nth-child(6){background:linear-gradient(135deg,#db2777,#be185d);color:#fff;border:0}
.librep .stats .lab{color:rgba(255,255,255,.82)}
.librep .stats .num{color:#fff}

/* ---------------- UKS ---------------- */
.uks-v1 .stats .stat{color:#fff;border:0;min-height:92px;box-shadow:0 8px 20px rgba(15,23,42,.10)}
.uks-v1 .stats .stat:nth-child(1){background:linear-gradient(135deg,#ef4444,#dc2626)}
.uks-v1 .stats .stat:nth-child(2){background:linear-gradient(135deg,#f59e0b,#d97706)}
.uks-v1 .stats .stat:nth-child(3){background:linear-gradient(135deg,#16a34a,#047857)}
.uks-v1 .stats .stat:nth-child(4){background:linear-gradient(135deg,#2563eb,#4338ca)}
.uks-v1 .stats .stat:nth-child(5){background:linear-gradient(135deg,#0891b2,#0e7490)}
.uks-v1 .stats .stat:nth-child(6){background:linear-gradient(135deg,#7c3aed,#6d28d9)}
.uks-v1 .stats .stat:nth-child(7){background:linear-gradient(135deg,#db2777,#be185d)}
.uks-v1 .stats .stat:nth-child(8){background:linear-gradient(135deg,#475569,#334155)}
.uks-v1 .stats .ico{background:rgba(255,255,255,.18);color:#fff;border-color:rgba(255,255,255,.22)}
.uks-v1 .stats .num{color:#fff}.uks-v1 .stats .lab{color:rgba(255,255,255,.84)}
.uks-v1 .card{box-shadow:0 8px 24px rgba(15,23,42,.05)}
.uks-v1 .btn-primary{background:linear-gradient(135deg,#2563eb,#4338ca)!important;border:0!important;color:#fff!important}
.uks-v1 .btn-secondary{background:#475569!important;border:0!important;color:#fff!important}

/* ---------------- BK ---------------- */
.bk-v2 .bk-stats .bk-stat{color:#fff;border:0;min-height:92px;box-shadow:0 8px 20px rgba(15,23,42,.10)}
.bk-v2 .bk-stats .bk-stat:nth-child(1){background:linear-gradient(135deg,#2563eb,#4338ca)}
.bk-v2 .bk-stats .bk-stat:nth-child(2){background:linear-gradient(135deg,#f59e0b,#d97706)}
.bk-v2 .bk-stats .bk-stat:nth-child(3){background:linear-gradient(135deg,#16a34a,#047857)}
.bk-v2 .bk-stats .bk-stat:nth-child(4){background:linear-gradient(135deg,#7c3aed,#6d28d9)}
.bk-v2 .bk-stat-icon{background:rgba(255,255,255,.18);color:#fff;border-color:rgba(255,255,255,.22)}
.bk-v2 .bk-stat-number{color:#fff}.bk-v2 .bk-stat-label{color:rgba(255,255,255,.84)}
.bk-v2 .bk-table-card{box-shadow:0 8px 24px rgba(15,23,42,.05)}
.bk-v2 .bk-pages a.active{background:linear-gradient(135deg,#7c3aed,#6d28d9);border-color:#7c3aed}

/* ---------------- KESISWAAN / DISCIPLINE ---------------- */
.pel-grid .pel-card,.pb-grid .pb-card,.hv-grid .hv-card{color:#fff;border:0;box-shadow:0 8px 20px rgba(15,23,42,.10);min-height:92px}
.pel-grid .pel-card:nth-child(1){background:linear-gradient(135deg,#2563eb,#4338ca)}
.pel-grid .pel-card:nth-child(2){background:linear-gradient(135deg,#f59e0b,#d97706)}
.pel-grid .pel-card:nth-child(3){background:linear-gradient(135deg,#ef4444,#dc2626)}
.pel-grid .pel-card:nth-child(4){background:linear-gradient(135deg,#db2777,#be185d)}
.pb-grid .pb-card:nth-child(1){background:linear-gradient(135deg,#2563eb,#4338ca)}
.pb-grid .pb-card:nth-child(2){background:linear-gradient(135deg,#f59e0b,#d97706)}
.pb-grid .pb-card:nth-child(3){background:linear-gradient(135deg,#16a34a,#047857)}
.pb-grid .pb-card:nth-child(4){background:linear-gradient(135deg,#7c3aed,#6d28d9)}
.hv-grid .hv-card:nth-child(1){background:linear-gradient(135deg,#2563eb,#4338ca)}
.hv-grid .hv-card:nth-child(2){background:linear-gradient(135deg,#f59e0b,#d97706)}
.hv-grid .hv-card:nth-child(3){background:linear-gradient(135deg,#16a34a,#047857)}
.hv-grid .hv-card:nth-child(4){background:linear-gradient(135deg,#ef4444,#dc2626)}
.pel-card .pel-label,.pb-card .pb-label,.hv-card .hv-label{color:rgba(255,255,255,.84)}
.pel-card .pel-num,.pb-card .pb-num,.hv-card .hv-num{color:#fff}
.pel-table,.pb-table,.hv-table{box-shadow:0 8px 24px rgba(15,23,42,.05)}
.pel-hero{background:linear-gradient(135deg,#7f1d1d,#be123c)}
.pb-hero{background:linear-gradient(135deg,#1d4ed8,#4338ca)}
.hv-hero{background:linear-gradient(135deg,#0e7490,#0369a1)}
.pel-table .btn-primary,.pb-table .btn-primary,.hv-table .btn-primary{background:linear-gradient(135deg,#2563eb,#4338ca)!important;border:0!important;color:#fff!important}
.pel-table .btn-secondary,.pb-table .btn-secondary,.hv-table .btn-secondary{background:#475569!important;border:0!important;color:#fff!important}

/* Colored status badges remain semantic */
.warn-p1{background:#fef3c7!important;color:#92400e!important}.warn-p2{background:#ffedd5!important;color:#9a3412!important}.warn-p3{background:#fee2e2!important;color:#b91c1c!important}.warn-p4{background:#fce7f3!important;color:#9d174d!important}

/* Supporting module action buttons */
.pel-table .btn-sm.btn-icon-sm,.pb-table .btn-sm.btn-icon-sm,.hv-table .btn-sm.btn-icon-sm{border:0!important;color:#fff!important}
.pel-table .btn-sm.btn-icon-sm.btn-primary,.pb-table .btn-sm.btn-icon-sm.btn-primary,.hv-table .btn-sm.btn-icon-sm.btn-primary{background:#2563eb!important}
.pel-table .btn-sm.btn-icon-sm.btn-secondary,.pb-table .btn-sm.btn-icon-sm.btn-secondary,.hv-table .btn-sm.btn-icon-sm.btn-secondary{background:#475569!important}
.pel-table .btn-sm.btn-danger,.pb-table .btn-sm.btn-danger,.hv-table .btn-sm.btn-danger{background:#ef4444!important;color:#fff!important;border:0!important}

/* Consistent form/filter surfaces */
.perpus-page .form-card,.perpus-page .card,.uks-v1 .card,.bk-v2 .bk-table-card,.pel-table,.pb-table,.hv-table{background:#fff}
.perpus-page .form-control,.perpus-page .form-select,.uks-v1 .form-control,.uks-v1 .form-select,.bk-v2 .form-control,.bk-v2 .form-select,.pel-table .form-control,.pel-table .form-select,.pb-table .form-control,.pb-table .form-select,.hv-table .form-control,.hv-table .form-select{border-color:#cbd5e1;border-radius:10px}

/* Responsive cards: keep the dashboard rhythm at all zoom levels */
@media(max-width:1100px){
 .perpus .op-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:700px){
 .perpus .op-grid{grid-template-columns:1fr}
}

/* ============================================================
   SISWA DETAIL / CRUD / KARTU — MASTER UI V12
   Presentation only. No business logic or data rules changed.
   ============================================================ */

/* --- Shared student action hierarchy --- */
.siswa-detail-page .page-header,
.siswa-form-page .page-header,
.siswa-kartu-page .page-header,
.siswa-kartu-cetak-page .page-header,
.siswa-qr-page .page-header{
  align-items:flex-start;
  gap:18px;
}
.siswa-detail-page .page-header-actions,
.siswa-kartu-page .page-header-actions,
.siswa-kartu-cetak-page .page-header-actions,
.siswa-qr-page .page-header-actions{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  align-items:center;
}
.siswa-detail-page .page-header-actions .btn,
.siswa-kartu-page .page-header-actions .btn,
.siswa-kartu-cetak-page .page-header-actions .btn,
.siswa-qr-page .page-header-actions .btn{
  min-height:38px;
  padding:8px 13px;
  border-radius:10px;
  font-weight:700;
}

/* --- Detail: compact summary cards --- */
.siswa-detail-page .dashboard-table-card{
  border-radius:14px;
}
.siswa-detail-page .dashboard-table-card > div[style*="padding:20px 20px 10px"]{
  padding:14px 16px 12px !important;
}
.siswa-detail-page .detail-grid{
  gap:10px 12px;
}
.siswa-detail-page .detail-grid > div{
  padding:11px 13px;
  border-radius:11px;
  background:#f8fafc;
  border:1px solid #e2e8f0;
  min-width:0;
}
.siswa-detail-page .detail-grid small{
  display:block;
  color:#64748b;
  font-size:11px;
  font-weight:700;
  margin-bottom:4px;
}
.siswa-detail-page .detail-grid strong{
  display:block;
  color:#172554;
  font-size:14px;
  line-height:1.25;
  overflow-wrap:anywhere;
}
.siswa-detail-page .section-title{
  margin-bottom:12px;
}
.siswa-detail-page .section-title h2{
  font-size:18px;
  line-height:1.2;
}
.siswa-detail-page .section-title p{
  font-size:12px;
  line-height:1.45;
}

/* Semantic action colors */
.siswa-detail-page .btn-action-edit{
  background:#f59e0b;
  border-color:#f59e0b;
  color:#fff;
}
.siswa-detail-page .btn-action-edit:hover{
  background:#d97706;
  border-color:#d97706;
  color:#fff;
}
.siswa-detail-page .btn-action-qr{
  background:#06b6d4;
  border-color:#06b6d4;
  color:#fff;
}
.siswa-detail-page .btn-action-qr:hover{
  background:#0891b2;
  border-color:#0891b2;
  color:#fff;
}
.siswa-detail-page .siswa-tab-btn{
  border-radius:9px;
  min-height:34px;
  padding:6px 10px;
  font-size:12px;
  font-weight:700;
}
.siswa-detail-page .siswa-tab-btn:not(.is-active){
  background:#f8fafc;
  color:#475569;
  border-color:#cbd5e1;
}
.siswa-detail-page .siswa-tab-btn.is-active{
  background:#2563eb;
  border-color:#2563eb;
  color:#fff;
}
.siswa-detail-page .siswa-tab-kehadiran.is-active{background:#0ea5e9;border-color:#0ea5e9}
.siswa-detail-page .siswa-tab-sholat.is-active{background:#7c3aed;border-color:#7c3aed}
.siswa-detail-page .siswa-tab-pendidikan.is-active{background:#16a34a;border-color:#16a34a}

/* Detail tables: compact but readable */
.siswa-detail-page .data-table th{
  font-size:12px;
  padding:10px 11px;
}
.siswa-detail-page .data-table td{
  font-size:12px;
  padding:9px 11px;
  line-height:1.35;
}
.siswa-detail-page .table-responsive{
  border-radius:10px;
}

/* --- CRUD forms --- */
.siswa-form-page .form-card{
  max-width:1000px;
  margin:0 auto;
  border-radius:14px;
}
.siswa-form-page .form-grid{
  gap:14px;
}
.siswa-form-page .form-grid label{
  font-size:12px;
  font-weight:700;
  color:#334155;
}
.siswa-form-page .form-control{
  min-height:42px;
  border-radius:9px;
  font-size:13px;
}
.siswa-form-page .form-actions{
  display:flex;
  flex-wrap:wrap;
  justify-content:flex-end;
  gap:8px;
  margin-top:18px;
}
.siswa-form-page .form-actions .btn{
  min-height:38px;
  border-radius:9px;
  font-weight:700;
}
.siswa-form-page .btn-save{
  background:#16a34a;
  border-color:#16a34a;
  color:#fff;
}
.siswa-form-page .btn-save:hover{
  background:#15803d;
  border-color:#15803d;
  color:#fff;
}

/* --- Student QR card --- */
.siswa-kartu-page .card-preview{
  padding:18px 0 8px !important;
}
.siswa-kartu-page .student-card{
  width:95mm;
  min-height:60mm;
}
.siswa-kartu-page .btn-print-card{
  background:#7c3aed;
  border-color:#7c3aed;
}
.siswa-kartu-page .btn-print-card:hover{
  background:#6d28d9;
  border-color:#6d28d9;
}

/* --- Bulk print page --- */
.siswa-kartu-cetak-page .filter-bar{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  align-items:center;
}
.siswa-kartu-cetak-page .filter-bar .form-control{
  min-width:180px;
  flex:1 1 220px;
  min-height:40px;
  border-radius:9px;
}
.siswa-kartu-cetak-page .filter-bar .btn{
  min-height:40px;
  border-radius:9px;
  font-weight:700;
}
.siswa-kartu-cetak-page .btn-print-card{
  background:#7c3aed;
  border-color:#7c3aed;
}

/* --- QR standalone --- */
.siswa-qr-page .qr-print-card{
  max-width:430px;
  margin:18px auto 0;
  padding:22px;
  text-align:center;
  border:1px solid #e2e8f0;
  border-radius:14px;
  background:#fff;
  box-shadow:0 8px 24px rgba(15,23,42,.07);
}
.siswa-qr-page .qr-print-card #qrcode{
  display:flex;
  justify-content:center;
  align-items:center;
  padding:8px;
}
.siswa-qr-page .qr-print-card h2{
  font-size:20px;
  margin:10px 0 4px;
}
.siswa-qr-page .qr-print-card p{
  margin:4px 0;
  font-size:12px;
  color:#64748b;
}
.siswa-qr-page .qr-print-card code{
  color:#475569;
  font-size:11px;
}

/* --- Responsive: preserve compactness without overflow --- */
@media (max-width: 900px){
  .siswa-detail-page .page-header-actions,
  .siswa-kartu-page .page-header-actions,
  .siswa-kartu-cetak-page .page-header-actions,
  .siswa-qr-page .page-header-actions{
    width:100%;
  }
  .siswa-detail-page .page-header-actions .btn,
  .siswa-kartu-page .page-header-actions .btn,
  .siswa-kartu-cetak-page .page-header-actions .btn,
  .siswa-qr-page .page-header-actions .btn{
    flex:1 1 auto;
  }
}
@media (max-width: 640px){
  .siswa-detail-page .detail-grid{
    grid-template-columns:1fr !important;
  }
  .siswa-form-page .form-actions{
    justify-content:stretch;
  }
  .siswa-form-page .form-actions .btn{
    flex:1 1 160px;
  }
  .siswa-kartu-page .student-card{
    transform:scale(.92);
    transform-origin:top center;
    margin-bottom:-20px;
  }
}

/* =========================================================
   V28 — GLOBAL FILTER COMPACTION
   Selects no longer stretch across an entire row when their
   content is short. Search fields retain the flexible space.
========================================================= */
.filter-bar > select.form-control{
    flex:0 1 190px;
    width:auto !important;
    min-width:150px;
}
.filter-bar > select[name="per_page"].form-control{
    flex:0 0 92px;
    min-width:92px;
}
.filter-bar > select[name="status"].form-control,
.filter-bar > select[name="aksi"].form-control{
    flex-basis:150px;
}
.filter-bar > select[name="role"].form-control,
.filter-bar > select[name="modul"].form-control{
    flex-basis:175px;
}
.filter-bar > input.form-control,
.filter-bar > input[type="search"].form-control{
    flex:1 1 260px;
    width:auto !important;
    min-width:180px;
}
.filter-bar > label{
    flex:0 1 190px;
    min-width:150px;
}
.filter-bar > label .form-control{
    width:100%;
}
@media(max-width:760px){
    .filter-bar > select.form-control,
    .filter-bar > input.form-control,
    .filter-bar > input[type="search"].form-control,
    .filter-bar > label{
        flex:1 1 100%;
        width:100% !important;
        min-width:0;
    }
    .filter-bar > select[name="per_page"].form-control{
        flex:1 1 100%;
    }
}
