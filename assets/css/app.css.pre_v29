    }
    .dashboard-page .main{
        padding-top:72px !important;
    }
    .dashboard-page.role-admin .dashboard-alert-grid{
        grid-auto-rows:140px;
    }
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert{
