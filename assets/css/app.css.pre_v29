    letter-spacing:0 !important;
}

.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-value,
.dashboard-page.role-admin .dashboard-notification-grid .dashboard-alert .alert-value{
    font-size:28px !important;
    font-weight:800 !important;
    line-height:1.05 !important;
    letter-spacing:-0.01em !important;
}

.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-text,
.dashboard-page.role-admin .dashboard-notification-grid .dashboard-alert .alert-text{
    font-size:12px !important;
    font-weight:500 !important;
    line-height:1.35 !important;
    letter-spacing:0 !important;
}

.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-icon,
.dashboard-page.role-admin .dashboard-notification-grid .dashboard-alert .alert-icon{
    width:50px !important;
    height:50px !important;
    flex-basis:50px !important;
    font-size:21px !important;
}

@media (max-width:767px){
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-label,
    .dashboard-page.role-admin .dashboard-notification-grid .dashboard-alert .alert-label{
        font-size:13px !important;
    }
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-value,
    .dashboard-page.role-admin .dashboard-notification-grid .dashboard-alert .alert-value{
        font-size:25px !important;
    }
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-text,
    .dashboard-page.role-admin .dashboard-notification-grid .dashboard-alert .alert-text{
        font-size:11.5px !important;
    }
}


/* =========================================================
   UI MASTER V7 — CONTENT LAYOUT / SPACE DISCIPLINE
   Baseline: V6. Presentation/layout only.
   No database, business logic, permission, or workflow changes.
   ========================================================= */
.dashboard-page .content{
    padding-bottom:24px !important;
}

/* Compact page introduction: useful context, not a large hero. */
.dashboard-page .dashboard-hero{
    margin-bottom:12px !important;
    padding:14px 18px !important;
    border-radius:16px !important;
    min-height:0 !important;
    box-shadow:0 6px 16px rgba(15,23,42,.05) !important;
}
.dashboard-page .hero-copy h2{
    font-size:19px !important;
    line-height:1.2 !important;
}
.dashboard-page .hero-copy p{
    margin-top:4px !important;
    font-size:12px !important;
    line-height:1.35 !important;
    max-width:900px !important;
}
.dashboard-page .hero-kicker{
    font-size:10px !important;
    margin-bottom:4px !important;
}
.dashboard-page .hero-badge{
    width:48px !important;
    min-width:48px !important;
    height:48px !important;
    border-radius:13px !important;
    font-size:20px !important;
}
.dashboard-page .dashboard-context{
    gap:7px !important;
    margin-bottom:14px !important;
}
.dashboard-page .context-chip{
    padding:6px 9px !important;
    font-size:11px !important;
}

/* Section rhythm: compact and consistent. */
.dashboard-page .dashboard-section{
    margin-top:18px !important;
}
.dashboard-page .dashboard-section-head{
    margin-bottom:9px !important;
}
.dashboard-page .dashboard-section-head h3{
    font-size:16px !important;
    line-height:1.2 !important;
}
.dashboard-page .dashboard-section-head p{
    margin-top:3px !important;
    font-size:11px !important;
    line-height:1.3 !important;
}
.dashboard-page .section-accent{
    height:24px !important;
    width:4px !important;
    margin-right:8px !important;
    vertical-align:-7px !important;
}

/* Card groups: equal size within the same group, compact height. */
.dashboard-page.role-admin .dashboard-alert-grid{
    grid-auto-rows:118px !important;
    gap:12px !important;
    margin-bottom:18px !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert{
    height:118px !important;
    min-height:118px !important;
    padding:13px 14px !important;
    gap:11px !important;
    border-radius:15px !important;
    box-shadow:0 7px 17px rgba(15,23,42,.10) !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-icon{
    width:44px !important;
    height:44px !important;
    flex-basis:44px !important;
    border-radius:12px !important;
    font-size:19px !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-label{
    font-size:13px !important;
    line-height:1.2 !important;
    margin-bottom:3px !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-value{
    font-size:27px !important;
    line-height:1 !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-text{
    font-size:11px !important;
    line-height:1.25 !important;
    margin-top:4px !important;
}

/* Keep labels concise inside a compact card; never allow uneven card height. */
.dashboard-page.role-admin .dashboard-alert-grid .alert-label,
.dashboard-page.role-admin .dashboard-alert-grid .alert-text{
    overflow:hidden !important;
    display:-webkit-box !important;
    -webkit-box-orient:vertical !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .alert-label{
    -webkit-line-clamp:2 !important;
}
.dashboard-page.role-admin .dashboard-alert-grid .alert-text{
    -webkit-line-clamp:2 !important;
}

/* Secondary status cards are intentionally denser than primary KPI cards. */
.dashboard-page .dashboard-grid-modern{
    gap:12px !important;
}
.dashboard-page .dashboard-grid-modern .modern-card{
    min-height:104px !important;
    padding:13px 15px !important;
    border-radius:15px !important;
}
.dashboard-page .modern-card .card-icon{
    width:36px !important;
    height:36px !important;
    border-radius:10px !important;
    font-size:16px !important;
}
.dashboard-page .modern-card .card-number{
    font-size:24px !important;
    margin-top:9px !important;
}
.dashboard-page .modern-card .card-label{
    font-size:12px !important;
}
.dashboard-page .modern-card .card-meta{
    font-size:10.5px !important;
    margin-top:3px !important;
}

@media (max-width:1100px){
    .dashboard-page.role-admin .dashboard-alert-grid{
        grid-auto-rows:116px !important;
    }
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert{
        height:116px !important;
        min-height:116px !important;
    }
}
@media (max-width:767px){
    .dashboard-page .dashboard-hero{
        padding:12px 14px !important;
    }
    .dashboard-page .hero-copy h2{
        font-size:17px !important;
    }
    .dashboard-page .hero-copy p{
        font-size:11px !important;
    }
    .dashboard-page .hero-badge{
        width:42px !important;
        min-width:42px !important;
        height:42px !important;
        font-size:18px !important;
    }
    .dashboard-page.role-admin .dashboard-alert-grid{
        grid-auto-rows:112px !important;
    }
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert{
        height:112px !important;
        min-height:112px !important;
        padding:12px !important;
    }
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-icon{
        width:40px !important;
        height:40px !important;
        flex-basis:40px !important;
        font-size:17px !important;
    }
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-label{
        font-size:12.5px !important;
    }
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-value{
        font-size:25px !important;
    }
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-text{
        font-size:10.5px !important;
    }
}


/* =====================================================
   SPLASMA TABLE MASTER V1 — DATA SISWA
   Presentation only. No business logic.
===================================================== */

.student-master-table{
    min-width: 900px;
    font-size: 13px;
}

.student-master-table thead th{
    padding: 10px 12px;
    background: linear-gradient(135deg,#2563eb,#1d4ed8);
    color:#fff;
    border-bottom:0;
    font-size:11px;
    font-weight:700;
    letter-spacing:.035em;
    text-transform:uppercase;
    vertical-align:middle;
}

.student-master-table thead th:first-child{
    border-radius:8px 0 0 8px;
}
.student-master-table thead th:last-child{
    border-radius:0 8px 8px 0;
}

.student-master-table tbody td{
    padding:9px 12px;
    color:#334155;
    border-bottom:1px solid #e8eef5;
    line-height:1.35;
}

.student-master-table tbody tr{
    height:48px;
}

.student-master-table tbody tr:hover{
    background:#eff6ff;
}

.student-master-table tbody td:first-child{
    width:40px;
    text-align:center;
}

.student-master-table tbody td:nth-child(2),
.student-master-table tbody td:nth-child(4),
.student-master-table tbody td:nth-child(5),
.student-master-table tbody td:nth-child(7){
    white-space:nowrap;
}

.student-master-table tbody td:nth-child(2){
    font-weight:600;
    color:#1e3a8a;
}

.student-master-table tbody td:nth-child(3){
    min-width:210px;
}

.student-master-table tbody td:nth-child(3) strong{
    display:inline-block;
    color:#1e293b;
    font-size:13px;
    line-height:1.3;
}

.student-master-table tbody td:nth-child(3) small{
    color:#64748b;
    font-size:11px;
}

.student-master-table code{
    padding:3px 6px;
    background:#f1f5f9;
    color:#475569;
    border:1px solid #e2e8f0;
    border-radius:5px;
    font-size:11px;
}

.student-master-table .status-badge{
    min-width:60px;
    padding:4px 8px;
    font-size:11px;
    font-weight:700;
}

.student-master-table .table-actions{
    gap:4px;
    flex-wrap:nowrap;
}

.student-master-table .btn-icon-sm{
    width:30px;
    min-width:30px!important;
    height:30px;
    border-radius:7px;
}

.student-master-table .btn-icon-sm i{
    font-size:13px;
}

/* Toolbar master data: compact but still easy to scan */
.student-filter-bar{
    gap:8px;
    padding:10px;
    border-radius:10px;
    background:#f8fafc;
    border:1px solid #e2e8f0;
}

.student-filter-bar .form-control{
    min-height:36px;
    height:36px;
    padding:6px 10px;
    font-size:12px;
}

.student-filter-bar .btn{
    min-height:36px;
    height:36px;
    padding:6px 11px;
    font-size:12px;
}

.student-per-page{
    gap:5px;
    font-size:12px;
    color:#64748b;
    white-space:nowrap;
}

.student-per-page .form-control{
    display:inline-block;
    width:66px;
    margin:0 2px;
}

.student-filter-apply{
    background:#2563eb;
    border-color:#2563eb;
    color:#fff;
}
.student-filter-apply:hover{
    background:#1d4ed8;
    border-color:#1d4ed8;
    color:#fff;
}

.student-filter-reset{
    background:#fff;
}

/* Compact bulk-action strip */
#bulkSiswaForm > div[style*="margin:12px 0"]{
    margin:8px 0!important;
    min-height:32px;
}
#bulkSiswaForm > div[style*="margin:12px 0"] label{
    color:#64748b;
    font-size:12px;
}
#bulkSiswaForm > div[style*="margin:12px 0"] .btn{
    min-height:30px;
    padding:5px 9px;
    font-size:11px;
}

/* Compact table footer */
.dashboard-table-card .pagination{
    padding:10px 14px;
    gap:10px;
    font-size:12px;
}
.dashboard-table-card .pagination .btn{
    min-width:30px;
    min-height:30px;
    padding:4px 8px;
    font-size:12px;
}

@media (max-width:900px){
    .student-filter-bar{
        align-items:stretch;
    }
    .student-filter-bar .form-control,
    .student-filter-bar .btn,
    .student-per-page{
        width:100%;
    }
    .student-per-page .form-control{
        width:72px;
    }
}

@media (max-width:700px){
    .student-master-table{
        min-width:820px;
    }
    .student-master-table tbody tr{
        height:46px;
    }
}


/* =========================================================
   SPLASMA V9 — MASTER CARD + RESPONSIVE FILTER LAYOUT
   Presentation only. Preserve database, logic, routes and workflows.
   Principles: proportional, compact, same-size within a card group.
========================================================= */

/* Card groups: one visual family, one compact proportion. */
.dashboard-grid > .dashboard-card,
.stats-grid > .stat-card,
.bk-stats > .bk-stat,
.hv-grid > .hv-card,
.pel-grid > .pel-card,
.pb-grid > .pb-card {
    min-width: 0;
    min-height: 112px;
    height: 112px;
    padding: 13px 14px !important;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

/* Keep a card group visually disciplined even when copy differs in length. */
.dashboard-grid > .dashboard-card .card-label,
.stats-grid > .stat-card .stat-label,
.bk-stats > .bk-stat .bk-stat-label,
.hv-grid > .hv-card .hv-label,
.pel-grid > .pel-card .pel-label,
.pb-grid > .pb-card .pb-label {
    font-size: 12px !important;
    line-height: 1.25 !important;
    min-height: 15px;
    max-height: 30px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

.dashboard-grid > .dashboard-card .card-number,
.stats-grid > .stat-card .stat-value,
.bk-stats > .bk-stat .bk-stat-number,
.hv-grid > .hv-card .hv-num,
.pel-grid > .pel-card .pel-num,
.pb-grid > .pb-card .pb-num {
    font-size: 25px !important;
    line-height: 1.05 !important;
    margin: 3px 0 0 !important;
}

.dashboard-grid > .dashboard-card .card-description,
.stats-grid > .stat-card .stat-description,
.bk-stats > .bk-stat small,
.hv-grid > .hv-card small,
.pel-grid > .pel-card small,
.pb-grid > .pb-card small {
    font-size: 10.5px !important;
    line-height: 1.25 !important;
    margin-top: 4px !important;
    max-height: 27px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

.dashboard-grid > .dashboard-card .card-icon,
.stats-grid > .stat-card .stat-icon,
.bk-stats > .bk-stat .bk-stat-icon {
    width: 38px !important;
    height: 38px !important;
    min-width: 38px !important;
    flex: 0 0 38px;
    border-radius: 11px !important;
    font-size: 17px !important;
}

/* Student cards use the same master proportion as other operational cards. */
.dashboard-grid > .student-stat {
    min-height: 112px !important;
    height: 112px !important;
    padding: 13px 14px !important;
}
.dashboard-grid > .student-stat .card-icon {
    margin-bottom: 7px !important;
}
.dashboard-grid > .student-stat .card-number {
    font-size: 25px !important;
}

/* Filter controls: responsive to viewport/zoom, never squeeze the controls. */
.student-filter-bar {
    width: 100%;
    box-sizing: border-box;
}
.student-filter-bar .student-per-page {
    min-width: 148px !important;
    display: grid !important;
    grid-template-columns: auto 62px auto;
    align-items: center;
    justify-content: stretch !important;
    gap: 6px !important;
    white-space: nowrap !important;
}
.student-filter-bar .student-per-page .form-control {
    width: 62px !important;
    min-width: 62px !important;
}
.student-filter-bar > select[name="status"] {
    min-width: 0;
}

/* At browser zoom / narrower desktop widths, reorganize rather than squeeze. */
@media (max-width: 1500px) {
    .student-filter-bar {
        grid-template-columns: minmax(150px,1fr) minmax(220px,1.5fr) minmax(145px,1fr) minmax(170px,1.1fr);
    }
    .student-filter-bar .student-per-page {
        grid-column: span 2;
        justify-self: start;
        width: 148px;
    }
    .student-filter-bar .student-filter-apply,
    .student-filter-bar .student-filter-reset {
        justify-self: start;
    }
}

@media (max-width: 1050px) {
    .student-filter-bar {
        grid-template-columns: repeat(2,minmax(0,1fr));
    }
    .student-filter-bar .student-per-page {
        grid-column: auto;
        width: 148px;
    }
    .student-filter-bar .student-filter-apply,
    .student-filter-bar .student-filter-reset {
        width: 100%;
    }
}

@media (max-width: 700px) {
    .dashboard-grid > .dashboard-card,
    .stats-grid > .stat-card,
    .bk-stats > .bk-stat,
    .hv-grid > .hv-card,
    .pel-grid > .pel-card,
    .pb-grid > .pb-card,
    .dashboard-grid > .student-stat {
        height: 108px !important;
        min-height: 108px !important;
    }
    .student-filter-bar {
        grid-template-columns: 1fr;
    }
    .student-filter-bar .student-per-page {
        width: 148px;
        grid-column: auto;
    }
}

/* Do not allow compact cards to become oversized from inherited content rules. */
.dashboard-grid > .dashboard-card > *,
.stats-grid > .stat-card > *,
.bk-stats > .bk-stat > *,
.hv-grid > .hv-card > *,
.pel-grid > .pel-card > *,
.pb-grid > .pb-card > * {
    min-width: 0;
}


/* =========================================================
   SPLASMA V10 — FUNCTION COLOR + PROPORTIONAL CARD/TABLE ACTIONS
   Presentation only. No database, logic, route or workflow changes.
   Principle: full-color, compact, proportional, function-coded.
========================================================= */

/* Data Siswa: six summary cards form a balanced 3x2 composition on wide screens. */
.siswa-page > .content .dashboard-grid{
    grid-template-columns:repeat(3,minmax(0,1fr)) !important;
    gap:14px !important;
    align-items:stretch !important;
}

/* Master card proportion: compact and uniform within this card family. */
.siswa-page > .content .dashboard-grid > .student-stat{
    height:112px !important;
    min-height:112px !important;
    max-height:112px !important;
    padding:12px 14px !important;
    border-radius:15px !important;
    box-sizing:border-box !important;
    display:flex !important;
    flex-direction:column !important;
    justify-content:center !important;
}

/* Colored icon treatment: icon itself carries the card/function color. */
.siswa-page .student-stat .card-icon{
    width:36px !important;
    height:36px !important;
    min-width:36px !important;
    margin:0 0 6px !important;
    border-radius:10px !important;
    background:rgba(255,255,255,.88) !important;
    border:1px solid rgba(255,255,255,.55) !important;
    box-shadow:0 2px 7px rgba(15,23,42,.08) !important;
    font-size:16px !important;
}
.siswa-page .student-stat .card-icon i{font-size:17px !important}

/* Function-coded icon colors */
.siswa-page .student-stat-blue .card-icon{color:#2563eb !important}
.siswa-page .student-stat-green .card-icon{color:#059669 !important}
.siswa-page .student-stat-purple .card-icon{color:#7c3aed !important}
.siswa-page .student-stat-orange .card-icon{color:#c2410c !important}
.siswa-page .student-stat-red .card-icon{color:#dc2626 !important}
.siswa-page .student-stat-warning{
    background:linear-gradient(135deg,#f59e0b 0%,#d97706 100%) !important;
}
.siswa-page .student-stat-warning .card-icon{color:#b45309 !important}

/* Compact typography, aligned with the approved V6/V7 master. */
.siswa-page .student-stat .card-label{
    font-size:12px !important;
    line-height:1.2 !important;
    margin:0 0 2px !important;
    color:#fff !important;
}
.siswa-page .student-stat .card-number{
    font-size:25px !important;
    line-height:1 !important;
    margin:0 !important;
    color:#fff !important;
}
.siswa-page .student-stat .card-description{
    font-size:10.5px !important;
    line-height:1.2 !important;
    margin:3px 0 0 !important;
    color:rgba(255,255,255,.86) !important;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

/* Header actions: each action has a functional color, not a generic neutral button. */
.siswa-page .page-header-actions{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    justify-content:flex-end;
    gap:8px !important;
    max-width:100%;
}
.siswa-page .page-header-actions .btn{
    min-height:38px !important;
    height:38px !important;
    padding:0 13px !important;
    font-size:12.5px !important;
    border-radius:10px !important;
    font-weight:700 !important;
}
.siswa-page .btn-fn-add{
    background:#2563eb !important;
    border-color:#2563eb !important;
    color:#fff !important;
}
.siswa-page .btn-fn-add:hover{background:#1d4ed8 !important;border-color:#1d4ed8 !important}
.siswa-page .btn-fn-import{
    background:#16a34a !important;
    border-color:#16a34a !important;
    color:#fff !important;
}
.siswa-page .btn-fn-import:hover{background:#15803d !important;border-color:#15803d !important}
.siswa-page .btn-fn-card{
    background:#7c3aed !important;
    border-color:#7c3aed !important;
    color:#fff !important;
}
.siswa-page .btn-fn-card:hover{background:#6d28d9 !important;border-color:#6d28d9 !important}

/* Dense table actions: compact, but each action is visually self-explanatory. */
.siswa-page .student-master-table .btn-fn-detail{
    background:#06b6d4 !important;
    border-color:#06b6d4 !important;
    color:#fff !important;
}
.siswa-page .student-master-table .btn-fn-detail:hover{
    background:#0891b2 !important;border-color:#0891b2 !important;
}
.siswa-page .student-master-table .btn-fn-edit{
    background:#f59e0b !important;
    border-color:#f59e0b !important;
    color:#fff !important;
}
.siswa-page .student-master-table .btn-fn-edit:hover{
    background:#d97706 !important;border-color:#d97706 !important;
}
.siswa-page .student-master-table .btn-fn-qr{
    background:#7c3aed !important;
    border-color:#7c3aed !important;
    color:#fff !important;
}
.siswa-page .student-master-table .btn-fn-qr:hover{
    background:#6d28d9 !important;border-color:#6d28d9 !important;
}
.siswa-page .student-master-table .btn-danger{
    background:#dc2626 !important;
    border-color:#dc2626 !important;
    color:#fff !important;
}

/* Filter controls: function-neutral; Apply is primary action, reset is neutral. */
.siswa-page .student-filter-apply{
    background:#2563eb !important;
    border-color:#2563eb !important;
    color:#fff !important;
}
.siswa-page .student-filter-apply:hover{
    background:#1d4ed8 !important;
    border-color:#1d4ed8 !important;
}

/* Status/QR code remains compact; do not let it inflate the row. */
.siswa-page .student-master-table code{
    font-size:10px !important;
    padding:3px 5px !important;
}

/* Responsive card group: 2 columns, then 1; keep each breakpoint balanced. */
@media (max-width:1050px){
    .siswa-page > .content .dashboard-grid{
        grid-template-columns:repeat(2,minmax(0,1fr)) !important;
    }
}
@media (max-width:700px){
    .siswa-page > .content .dashboard-grid{
        grid-template-columns:1fr !important;
        gap:10px !important;
    }
    .siswa-page > .content .dashboard-grid > .student-stat{
        height:108px !important;
        min-height:108px !important;
        max-height:108px !important;
    }
    .siswa-page .page-header-actions{
        justify-content:flex-start;
        width:100%;
    }
    .siswa-page .page-header-actions .btn{
        flex:1 1 140px;
    }
}


/* =========================================================
   SPLASMA V11 — MASTER DATA GURU / TENDIK
   Presentation only. Preserve database, logic, routes and workflows.
   Principles: proportional card family, function color, compact table, responsive controls.
========================================================= */

/* Guru summary cards: one family, equal proportion. */
.guru-page .guru-stat-grid{
    grid-template-columns:repeat(3,minmax(0,1fr)) !important;
    gap:14px !important;
    align-items:stretch !important;
}
.guru-page .guru-stat{
    height:112px !important;
    min-height:112px !important;
    max-height:112px !important;
    padding:12px 14px !important;
    border-radius:15px !important;
    box-sizing:border-box !important;
    display:flex !important;
    flex-direction:column !important;
    justify-content:center !important;
    position:relative;
    overflow:hidden;
    color:#fff !important;
    border:0 !important;
}
.guru-page .guru-stat::after{
    content:"";
    position:absolute;
    width:105px;
    height:105px;
    right:-32px;
    bottom:-54px;
    border-radius:50%;
    background:rgba(255,255,255,.14);
    pointer-events:none;
}
.guru-page .guru-stat-blue{background:linear-gradient(135deg,#2563eb 0%,#4338ca 100%) !important}
.guru-page .guru-stat-green{background:linear-gradient(135deg,#16a34a 0%,#047857 100%) !important}
.guru-page .guru-stat-red{background:linear-gradient(135deg,#ef4444 0%,#be123c 100%) !important}

.guru-page .guru-stat .card-icon{
    width:36px !important;
    height:36px !important;
    min-width:36px !important;
    margin:0 0 6px !important;
    border-radius:10px !important;
    display:flex !important;
    align-items:center !important;
    justify-content:center !important;
    background:rgba(255,255,255,.9) !important;
    border:1px solid rgba(255,255,255,.55) !important;
    box-shadow:0 2px 7px rgba(15,23,42,.08) !important;
    font-size:17px !important;
    position:relative;
    z-index:1;
}
.guru-page .guru-stat-blue .card-icon{color:#2563eb !important}
.guru-page .guru-stat-green .card-icon{color:#059669 !important}
.guru-page .guru-stat-red .card-icon{color:#dc2626 !important}
.guru-page .guru-stat .card-label{
    color:#fff !important;
    font-size:12px !important;
    line-height:1.2 !important;
    margin:0 0 2px !important;
    font-weight:700 !important;
    position:relative;
    z-index:1;
}
.guru-page .guru-stat .card-number{
    color:#fff !important;
    font-size:25px !important;
    line-height:1 !important;
    margin:0 !important;
    font-weight:800 !important;
    position:relative;
    z-index:1;
}
.guru-page .guru-stat .card-description{
    color:rgba(255,255,255,.86) !important;
    font-size:10.5px !important;
    line-height:1.2 !important;
    margin:3px 0 0 !important;
    position:relative;
    z-index:1;
}

/* Page actions: functional colors. */
.guru-page .page-header-actions .btn{
    min-height:38px !important;
    height:38px !important;
    padding:0 13px !important;
    font-size:12.5px !important;
    border-radius:10px !important;
    font-weight:700 !important;
}
.guru-page .btn-fn-add{
    background:#2563eb !important;
    border-color:#2563eb !important;
    color:#fff !important;
}
.guru-page .btn-fn-add:hover{background:#1d4ed8 !important;border-color:#1d4ed8 !important}
.guru-page .btn-fn-import{
    background:#16a34a !important;
    border-color:#16a34a !important;
    color:#fff !important;
}
.guru-page .btn-fn-import:hover{background:#15803d !important;border-color:#15803d !important}

/* Guru filter: compact and wraps instead of squeezing. */
.guru-page .guru-filter-bar{
    display:grid !important;
    grid-template-columns:minmax(240px,1.8fr) minmax(120px,.7fr) minmax(150px,auto) auto auto !important;
    gap:8px !important;
    align-items:center !important;
    margin:12px 0 !important;
}
.guru-page .guru-filter-bar > input,
.guru-page .guru-filter-bar > select{
    min-width:0 !important;
    height:38px !important;
}
.guru-page .guru-filter-bar > label{
    font-size:12px !important;
    color:#64748b !important;
    margin:0 !important;
}
.guru-page .guru-filter-bar > label .form-control{
    height:38px !important;
    min-width:62px !important;
    width:62px !important;
}
.guru-page .guru-filter-apply{
    background:#2563eb !important;
    border-color:#2563eb !important;
    color:#fff !important;
    height:38px !important;
}
.guru-page .guru-filter-reset{
    height:38px !important;
}

/* Guru table: compact, clear, function-coded actions. */
.guru-page .data-table th{
    height:44px !important;
    padding:8px 10px !important;
    font-size:12px !important;
}
.guru-page .data-table td{
    height:48px !important;
    padding:7px 10px !important;
    font-size:12.5px !important;
}
.guru-page .data-table td strong{
    font-size:13px !important;
}
.guru-page .data-table .status-badge{
    font-size:11px !important;
    padding:4px 8px !important;
    border-radius:999px !important;
}
.guru-page .data-table code{
    font-size:10px !important;
    padding:3px 5px !important;
}
.guru-page .table-actions{
    gap:4px !important;
}
.guru-page .table-actions .btn-icon-sm{
    width:30px !important;
    height:30px !important;
    min-width:30px !important;
    padding:0 !important;
    border-radius:8px !important;
}
.guru-page .table-actions .btn-fn-detail{
    background:#06b6d4 !important;
    border-color:#06b6d4 !important;
    color:#fff !important;
}
.guru-page .table-actions .btn-fn-edit{
    background:#f59e0b !important;
    border-color:#f59e0b !important;
    color:#fff !important;
}
.guru-page .table-actions .btn-fn-qr{
    background:#7c3aed !important;
    border-color:#7c3aed !important;
    color:#fff !important;
}
.guru-page .table-actions .btn-warning{
    background:#f59e0b !important;
    border-color:#f59e0b !important;
    color:#fff !important;
}
.guru-page .table-actions .btn-danger{
    background:#dc2626 !important;
    border-color:#dc2626 !important;
    color:#fff !important;
}

/* Bulk action remains compact and danger-coded. */
.guru-page #bulkGuruForm > div[style*="margin:12px 0"]{
    margin:8px 0 !important;
}
.guru-page #bulkGuruForm .btn{
    min-height:32px !important;
    height:32px !important;
    padding:0 10px !important;
    font-size:11.5px !important;
}

/* Pagination stays compact. */
.guru-page .pagination{
    padding:9px 12px !important;
    font-size:11.5px !important;
}
.guru-page .pagination .btn{
    min-width:30px !important;
    min-height:30px !important;
    height:30px !important;
    padding:4px 8px !important;
}

/* Responsive composition: preserve equal card sizing within each breakpoint. */
@media (max-width:1050px){
    .guru-page .guru-stat-grid{
        grid-template-columns:repeat(2,minmax(0,1fr)) !important;
    }
    .guru-page .guru-filter-bar{
        grid-template-columns:minmax(0,1.5fr) minmax(120px,1fr) auto !important;
    }
    .guru-page .guru-filter-bar > label{
        grid-column:span 1;
    }
}
@media (max-width:700px){
    .guru-page .guru-stat-grid{
        grid-template-columns:1fr !important;
        gap:10px !important;
    }
    .guru-page .guru-stat{
        height:108px !important;
        min-height:108px !important;
        max-height:108px !important;
    }
    .guru-page .guru-filter-bar{
        grid-template-columns:1fr !important;
    }
    .guru-page .guru-filter-bar > label{
        grid-column:auto;
    }
    .guru-page .page-header-actions{
        width:100%;
        justify-content:flex-start;
    }
    .guru-page .page-header-actions .btn{
        flex:1 1 140px;
    }
}

/* ============================================================
   SISWA DETAIL / CRUD / KARTU — MASTER UI V12
   Presentation only. No business logic or data rules changed.
   ============================================================ */

/* --- Shared student action hierarchy --- */
.siswa-detail-page .page-header,
.siswa-form-page .page-header,
.siswa-kartu-page .page-header,
.siswa-kartu-cetak-page .page-header,
.siswa-qr-page .page-header{
  align-items:flex-start;
  gap:18px;
}
.siswa-detail-page .page-header-actions,
.siswa-kartu-page .page-header-actions,
.siswa-kartu-cetak-page .page-header-actions,
.siswa-qr-page .page-header-actions{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  align-items:center;
}
.siswa-detail-page .page-header-actions .btn,
.siswa-kartu-page .page-header-actions .btn,
.siswa-kartu-cetak-page .page-header-actions .btn,
.siswa-qr-page .page-header-actions .btn{
  min-height:38px;
  padding:8px 13px;
  border-radius:10px;
  font-weight:700;
}

/* --- Detail: compact summary cards --- */
.siswa-detail-page .dashboard-table-card{
  border-radius:14px;
}
.siswa-detail-page .dashboard-table-card > div[style*="padding:20px 20px 10px"]{
  padding:14px 16px 12px !important;
}
.siswa-detail-page .detail-grid{
  gap:10px 12px;
}
.siswa-detail-page .detail-grid > div{
  padding:11px 13px;
  border-radius:11px;
  background:#f8fafc;
  border:1px solid #e2e8f0;
  min-width:0;
}
.siswa-detail-page .detail-grid small{
  display:block;
  color:#64748b;
  font-size:11px;
  font-weight:700;
  margin-bottom:4px;
}
.siswa-detail-page .detail-grid strong{
  display:block;
  color:#172554;
  font-size:14px;
  line-height:1.25;
  overflow-wrap:anywhere;
}
.siswa-detail-page .section-title{
  margin-bottom:12px;
}
.siswa-detail-page .section-title h2{
  font-size:18px;
  line-height:1.2;
}
.siswa-detail-page .section-title p{
  font-size:12px;
  line-height:1.45;
}

/* Semantic action colors */
.siswa-detail-page .btn-action-edit{
  background:#f59e0b;
  border-color:#f59e0b;
  color:#fff;
}
.siswa-detail-page .btn-action-edit:hover{
  background:#d97706;
  border-color:#d97706;
  color:#fff;
}
.siswa-detail-page .btn-action-qr{
  background:#06b6d4;
  border-color:#06b6d4;
  color:#fff;
}
.siswa-detail-page .btn-action-qr:hover{
  background:#0891b2;
  border-color:#0891b2;
  color:#fff;
}
.siswa-detail-page .siswa-tab-btn{
  border-radius:9px;
  min-height:34px;
  padding:6px 10px;
  font-size:12px;
  font-weight:700;
}
.siswa-detail-page .siswa-tab-btn:not(.is-active){
  background:#f8fafc;
  color:#475569;
  border-color:#cbd5e1;
}
.siswa-detail-page .siswa-tab-btn.is-active{
  background:#2563eb;
  border-color:#2563eb;
  color:#fff;
}
.siswa-detail-page .siswa-tab-kehadiran.is-active{background:#0ea5e9;border-color:#0ea5e9}
.siswa-detail-page .siswa-tab-sholat.is-active{background:#7c3aed;border-color:#7c3aed}
.siswa-detail-page .siswa-tab-pendidikan.is-active{background:#16a34a;border-color:#16a34a}

/* Detail tables: compact but readable */
.siswa-detail-page .data-table th{
  font-size:12px;
  padding:10px 11px;
}
.siswa-detail-page .data-table td{
  font-size:12px;
  padding:9px 11px;
  line-height:1.35;
}
.siswa-detail-page .table-responsive{
  border-radius:10px;
}

/* --- CRUD forms --- */
.siswa-form-page .form-card{
  max-width:1000px;
  margin:0 auto;
  border-radius:14px;
}
.siswa-form-page .form-grid{
  gap:14px;
}
.siswa-form-page .form-grid label{
  font-size:12px;
  font-weight:700;
  color:#334155;
}
.siswa-form-page .form-control{
  min-height:42px;
  border-radius:9px;
  font-size:13px;
}
.siswa-form-page .form-actions{
  display:flex;
  flex-wrap:wrap;
  justify-content:flex-end;
  gap:8px;
  margin-top:18px;
}
.siswa-form-page .form-actions .btn{
  min-height:38px;
  border-radius:9px;
  font-weight:700;
}
.siswa-form-page .btn-save{
  background:#16a34a;
  border-color:#16a34a;
  color:#fff;
}
.siswa-form-page .btn-save:hover{
  background:#15803d;
  border-color:#15803d;
  color:#fff;
}

/* --- Student QR card --- */
.siswa-kartu-page .card-preview{
  padding:18px 0 8px !important;
}
.siswa-kartu-page .student-card{
  width:95mm;
  min-height:60mm;
}
.siswa-kartu-page .btn-print-card{
  background:#7c3aed;
  border-color:#7c3aed;
}
.siswa-kartu-page .btn-print-card:hover{
  background:#6d28d9;
  border-color:#6d28d9;
}

/* --- Bulk print page --- */
.siswa-kartu-cetak-page .filter-bar{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  align-items:center;
}
.siswa-kartu-cetak-page .filter-bar .form-control{
  min-width:180px;
  flex:1 1 220px;
  min-height:40px;
  border-radius:9px;
}
.siswa-kartu-cetak-page .filter-bar .btn{
  min-height:40px;
  border-radius:9px;
  font-weight:700;
}
.siswa-kartu-cetak-page .btn-print-card{
  background:#7c3aed;
  border-color:#7c3aed;
}

/* --- QR standalone --- */
.siswa-qr-page .qr-print-card{
  max-width:430px;
  margin:18px auto 0;
  padding:22px;
  text-align:center;
  border:1px solid #e2e8f0;
  border-radius:14px;
  background:#fff;
  box-shadow:0 8px 24px rgba(15,23,42,.07);
}
.siswa-qr-page .qr-print-card #qrcode{
  display:flex;
  justify-content:center;
  align-items:center;
  padding:8px;
}
.siswa-qr-page .qr-print-card h2{
  font-size:20px;
  margin:10px 0 4px;
}
.siswa-qr-page .qr-print-card p{
  margin:4px 0;
  font-size:12px;
  color:#64748b;
}
.siswa-qr-page .qr-print-card code{
  color:#475569;
  font-size:11px;
}

/* --- Responsive: preserve compactness without overflow --- */
@media (max-width: 900px){
  .siswa-detail-page .page-header-actions,
  .siswa-kartu-page .page-header-actions,
  .siswa-kartu-cetak-page .page-header-actions,
  .siswa-qr-page .page-header-actions{
    width:100%;
  }
  .siswa-detail-page .page-header-actions .btn,
  .siswa-kartu-page .page-header-actions .btn,
  .siswa-kartu-cetak-page .page-header-actions .btn,
  .siswa-qr-page .page-header-actions .btn{
    flex:1 1 auto;
  }
}
@media (max-width: 640px){
  .siswa-detail-page .detail-grid{
    grid-template-columns:1fr !important;
  }
  .siswa-form-page .form-actions{
    justify-content:stretch;
  }
  .siswa-form-page .form-actions .btn{
    flex:1 1 160px;
  }
  .siswa-kartu-page .student-card{
    transform:scale(.92);
    transform-origin:top center;
    margin-bottom:-20px;
  }
}


/* =========================================================
   V13 — SISWA BARU / COMPACT CONTENT LAYOUT
   Presentation-only. No business logic changes.
   ========================================================= */
.siswa-baru-page .page-header,
.siswa-baru-form-page .page-header,
.siswa-import-page .page-header{
  align-items:center;
  gap:16px;
}

.siswa-baru-page .page-header h1,
.siswa-baru-form-page .page-header h1,
.siswa-import-page .page-header h1{
  margin-bottom:4px;
}

.siswa-baru-page .page-header p,
.siswa-baru-form-page .page-header p,
.siswa-import-page .page-header p{
  margin:0;
  max-width:780px;
}

.siswa-baru-page .form-card,
.siswa-baru-form-page .form-card,
.siswa-import-page .form-card{
  border-radius:14px;
}

/* Ringkasan: satu kelompok = ukuran seragam, compact, warna sesuai fungsi. */
.siswa-baru-page .siswa-baru-stats{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:16px;
  margin-top:16px;
}
.siswa-baru-page .siswa-baru-stats .dashboard-card{
  min-height:132px;
  height:132px;
  padding:18px 20px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  position:relative;
  overflow:hidden;
}
.siswa-baru-page .siswa-baru-stats .dashboard-card:nth-child(1){
  background:linear-gradient(135deg,#2563eb,#4338ca);
}
.siswa-baru-page .siswa-baru-stats .dashboard-card:nth-child(2){
  background:linear-gradient(135deg,#16a34a,#047857);
}
.siswa-baru-page .siswa-baru-stats .dashboard-card:nth-child(3){
  background:linear-gradient(135deg,#f59e0b,#d97706);
}
.siswa-baru-page .siswa-baru-stats .card-label,
.siswa-baru-page .siswa-baru-stats .card-description,
.siswa-baru-page .siswa-baru-stats .card-number{
  position:relative;
  z-index:2;
  color:#fff !important;
}
.siswa-baru-page .siswa-baru-stats .card-label{
  font-size:14px;
  line-height:1.25;
  font-weight:700;
}
.siswa-baru-page .siswa-baru-stats .card-number{
  font-size:28px;
  line-height:1.05;
  margin:5px 0 3px;
  font-weight:800;
}
.siswa-baru-page .siswa-baru-stats .card-description{
  font-size:12px;
  line-height:1.3;
  font-weight:600;
  opacity:.95;
}

/* Aksi utama: dua fungsi berbeda, dua warna fungsi. */
.siswa-baru-page .siswa-baru-actions{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:16px;
  margin-top:16px;
}
.siswa-baru-page .siswa-baru-action-card{
  margin-top:0 !important;
  padding:18px 20px;
  min-height:124px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}
.siswa-baru-page .siswa-baru-action-card .section-title{
  margin-bottom:12px;
}
.siswa-baru-page .siswa-baru-action-card .section-title h2{
  font-size:17px;
  margin:0;
}
.siswa-baru-page .siswa-baru-action-card .section-title p{
  font-size:12px;
  line-height:1.4;
  margin:4px 0 0;
}
.siswa-baru-page .siswa-baru-action-card .btn{
  align-self:flex-start;
  min-height:38px;
}
.siswa-baru-page .siswa-baru-action-card .btn-import{
  background:#16a34a;
  border-color:#16a34a;
  color:#fff;
}
.siswa-baru-page .siswa-baru-action-card .btn-import:hover{
  background:#15803d;
  border-color:#15803d;
  color:#fff;
}

/* Alur: informasi sekunder, dibuat padat agar tidak memakan layar. */
.siswa-baru-page .siswa-baru-flow{
  margin-top:16px !important;
  padding:18px 20px;
}
.siswa-baru-page .siswa-baru-flow ol{
  margin:8px 0 0;
  padding-left:22px;
  line-height:1.65 !important;
}
.siswa-baru-page .siswa-baru-flow li{
  margin:2px 0;
}

/* Form tambah: grid tetap proporsional dan responsif. */
.siswa-baru-form-page .form-card{
  max-width:980px;
  margin:0 auto;
}
.siswa-baru-form-page .form-grid{
  gap:12px 14px;
}
.siswa-baru-form-page .form-grid label{
  font-size:12px;
  line-height:1.25;
}
.siswa-baru-form-page .form-control,
.siswa-import-page .form-control{
  min-height:40px;
  border-radius:9px;
  font-size:13px;
}
.siswa-baru-form-page .form-actions,
.siswa-import-page .form-actions{
  margin-top:16px;
  display:flex;
  flex-wrap:wrap;
  justify-content:flex-end;
  gap:8px;
}
.siswa-baru-form-page .btn-save,
.siswa-baru-form-page .form-actions .btn-primary{
  background:#16a34a;
  border-color:#16a34a;
  color:#fff;
}
.siswa-baru-form-page .btn-save:hover,
.siswa-baru-form-page .form-actions .btn-primary:hover{
  background:#15803d;
  border-color:#15803d;
  color:#fff;
}

/* Import: instruksi tetap lengkap, tetapi layout lebih ringkas. */
.siswa-import-page .form-card{
  max-width:1080px;
  margin:0 auto;
}
.siswa-import-page .section-title{
  gap:12px;
}
.siswa-import-page .section-title h2{
  font-size:18px;
}
.siswa-import-page .section-title p{
  font-size:12px;
}
.siswa-import-page .alert{
  border-radius:10px;
  padding:12px 14px;
  font-size:13px;
  line-height:1.5;
}
.siswa-import-page .alert ul{
  margin-top:6px !important;
  line-height:1.55;
}
.siswa-import-page form > label{
  display:block;
  margin-top:12px;
  font-size:12px;
  font-weight:700;
}
.siswa-import-page form > label .form-control{
  margin-top:5px;
}
.siswa-import-page .form-actions .btn-primary{
  background:#16a34a;
  border-color:#16a34a;
  color:#fff;
}
.siswa-import-page .form-actions .btn-primary:hover{
  background:#15803d;
  border-color:#15803d;
}

@media (max-width:900px){
  .siswa-baru-page .siswa-baru-stats{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}
@media (max-width:680px){
  .siswa-baru-page .siswa-baru-stats,
  .siswa-baru-page .siswa-baru-actions{
    grid-template-columns:1fr;
  }
  .siswa-baru-page .siswa-baru-stats .dashboard-card{
    height:124px;
    min-height:124px;
  }
  .siswa-baru-page .siswa-baru-action-card{
    min-height:116px;
  }
}


/* =========================================================
   V14 — SISWA MODULE VISUAL CONSOLIDATION
   Presentation only. Preserve database, logic, routes and workflows.
   Cards follow the approved dashboard master; actions use function color.
========================================================= */
.siswa-page .siswa-master-stat-grid{display:grid !important;grid-template-columns:repeat(3,minmax(0,1fr)) !important;gap:14px !important;margin:0 0 20px !important}
.siswa-page .siswa-master-stat{min-height:122px !important;height:122px !important;padding:18px 19px !important;border:0 !important;border-radius:17px !important;box-shadow:0 9px 22px rgba(15,23,42,.10) !important;display:flex !important;gap:15px !important;align-items:flex-start !important;color:#fff !important;position:relative !important;overflow:hidden !important}
.siswa-page .siswa-master-stat::after,.siswa-baru-page .siswa-baru-stat::after,.siswa-baru-page .siswa-baru-action::after{content:"" !important;position:absolute !important;width:150px !important;height:150px !important;right:-65px !important;bottom:-90px !important;border-radius:50% !important;background:rgba(255,255,255,.13) !important}
.siswa-page .siswa-master-stat.alert-info,.siswa-baru-page .siswa-baru-stat.alert-info,.siswa-baru-page .siswa-baru-action.alert-info{background:linear-gradient(135deg,#2563eb 0%,#4338ca 100%) !important}
.siswa-page .siswa-master-stat.alert-success,.siswa-baru-page .siswa-baru-stat.alert-success,.siswa-baru-page .siswa-baru-action.alert-success{background:linear-gradient(135deg,#16a34a 0%,#047857 100%) !important}
.siswa-page .siswa-master-stat.alert-purple,.siswa-baru-page .siswa-baru-action.alert-purple{background:linear-gradient(135deg,#7c3aed 0%,#6d28d9 100%) !important}
.siswa-page .siswa-master-stat.alert-warning,.siswa-baru-page .siswa-baru-stat.alert-warning{background:linear-gradient(135deg,#f59e0b 0%,#d97706 100%) !important}
.siswa-page .siswa-master-stat.alert-danger{background:linear-gradient(135deg,#ef4444 0%,#be123c 100%) !important}
.siswa-page .siswa-master-stat.alert-teal{background:linear-gradient(135deg,#0d9488 0%,#0f766e 100%) !important}
.siswa-page .siswa-master-stat .alert-icon,.siswa-baru-page .siswa-baru-stat .alert-icon,.siswa-baru-page .siswa-baru-action .alert-icon{width:50px !important;height:50px !important;flex:0 0 50px !important;border-radius:15px !important;display:grid !important;place-items:center !important;background:rgba(255,255,255,.92) !important;border:1px solid rgba(255,255,255,.72) !important;box-shadow:0 5px 14px rgba(15,23,42,.10) !important;font-size:22px !important;position:relative !important;z-index:2 !important}
.siswa-page .siswa-master-stat.alert-info .alert-icon,.siswa-baru-page .siswa-baru-stat.alert-info .alert-icon,.siswa-baru-page .siswa-baru-action.alert-info .alert-icon{color:#2563eb !important}
.siswa-page .siswa-master-stat.alert-success .alert-icon,.siswa-baru-page .siswa-baru-stat.alert-success .alert-icon,.siswa-baru-page .siswa-baru-action.alert-success .alert-icon{color:#16a34a !important}
.siswa-page .siswa-master-stat.alert-purple .alert-icon,.siswa-baru-page .siswa-baru-action.alert-purple .alert-icon{color:#7c3aed !important}
.siswa-page .siswa-master-stat.alert-warning .alert-icon,.siswa-baru-page .siswa-baru-stat.alert-warning .alert-icon{color:#d97706 !important}
.siswa-page .siswa-master-stat.alert-danger .alert-icon{color:#dc2626 !important}.siswa-page .siswa-master-stat.alert-teal .alert-icon{color:#0f766e !important}
.siswa-page .siswa-master-stat>div:last-child,.siswa-baru-page .siswa-baru-stat>div:last-child,.siswa-baru-page .siswa-baru-action>div:last-child{min-width:0;position:relative;z-index:2}
.siswa-page .siswa-master-stat .alert-label,.siswa-baru-page .siswa-baru-stat .alert-label{font-size:14px !important;font-weight:800 !important;line-height:1.25 !important;color:#fff !important}
.siswa-page .siswa-master-stat .alert-value,.siswa-baru-page .siswa-baru-stat .alert-value{font-size:30px !important;font-weight:900 !important;line-height:1.02 !important;letter-spacing:-.03em !important;color:#fff !important}
.siswa-page .siswa-master-stat .alert-text,.siswa-baru-page .siswa-baru-stat .alert-text{font-size:13px !important;line-height:1.35 !important;font-weight:500 !important;color:rgba(255,255,255,.94) !important;margin-top:4px !important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.siswa-baru-page .siswa-tapel-value{font-size:24px !important;letter-spacing:-.02em !important}

.siswa-baru-page .siswa-baru-stats{display:grid !important;grid-template-columns:repeat(3,minmax(0,1fr)) !important;gap:14px !important;margin:0 0 16px !important}
.siswa-baru-page .siswa-baru-stat{min-height:122px !important;height:122px !important;padding:18px 19px !important;border:0 !important;border-radius:17px !important;box-shadow:0 9px 22px rgba(15,23,42,.10) !important;display:flex !important;gap:15px !important;align-items:flex-start !important;color:#fff !important;position:relative !important;overflow:hidden !important}
.siswa-baru-page .siswa-baru-actions{display:grid !important;grid-template-columns:repeat(3,minmax(0,1fr)) !important;gap:14px !important;margin:0 0 16px !important}
.siswa-baru-page .siswa-baru-action{min-height:96px !important;height:96px !important;padding:15px 17px !important;border:0 !important;border-radius:16px !important;box-shadow:0 8px 20px rgba(15,23,42,.10) !important;display:flex !important;align-items:flex-start !important;gap:13px !important;text-decoration:none !important;color:#fff !important;position:relative !important;overflow:hidden !important}
.siswa-baru-page .siswa-baru-action .alert-label{font-size:15px !important;font-weight:800 !important;line-height:1.25 !important;color:#fff !important}.siswa-baru-page .siswa-baru-action .alert-text{font-size:12px !important;line-height:1.35 !important;color:rgba(255,255,255,.93) !important;margin-top:4px !important}.siswa-baru-page .siswa-baru-action:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(15,23,42,.14)}
.siswa-baru-form-page .btn-success,.siswa-import-page .btn-success{background:#16a34a !important;border-color:#16a34a !important;color:#fff !important}.siswa-baru-form-page .btn-success:hover,.siswa-import-page .btn-success:hover{background:#15803d !important;border-color:#15803d !important}.siswa-import-page .btn-purple{background:#7c3aed !important;border-color:#7c3aed !important;color:#fff !important}.siswa-import-page .btn-purple:hover{background:#6d28d9 !important;border-color:#6d28d9 !important}.siswa-baru-form-page .btn-back,.siswa-import-page .btn-back{background:#fff !important;color:#334155 !important;border-color:#cbd5e1 !important}
@media(max-width:1050px){.siswa-page .siswa-master-stat-grid,.siswa-baru-page .siswa-baru-stats,.siswa-baru-page .siswa-baru-actions{grid-template-columns:repeat(2,minmax(0,1fr)) !important}}
@media(max-width:700px){.siswa-page .siswa-master-stat-grid,.siswa-baru-page .siswa-baru-stats,.siswa-baru-page .siswa-baru-actions{grid-template-columns:1fr !important}.siswa-page .siswa-master-stat,.siswa-baru-page .siswa-baru-stat{height:108px !important;min-height:108px !important}.siswa-baru-page .siswa-baru-action{height:88px !important;min-height:88px !important}}

/* =========================================================
   V15 — SISWA BARU CONTENT GROUPING + COMPACT CONTEXT
   Presentation-only. Status, action, and information are distinct groups.
   ========================================================= */
.siswa-baru-page .siswa-baru-context-card{
  padding:18px 20px !important;
  margin-bottom:16px !important;
}
.siswa-baru-page .siswa-baru-context-title{margin-bottom:12px !important}
.siswa-baru-page .siswa-baru-context-title h2{font-size:18px !important;line-height:1.25 !important;margin:0 !important}
.siswa-baru-page .siswa-baru-context-title p{font-size:12px !important;line-height:1.45 !important;margin:4px 0 0 !important}
.siswa-baru-page .siswa-baru-tapel-form{
  display:flex !important;
  align-items:center !important;
  gap:10px !important;
  margin:0 !important;
  max-width:430px !important;
}
.siswa-baru-page .siswa-baru-tapel-form label{
  flex:0 0 auto !important;
  font-size:12px !important;
  font-weight:700 !important;
  color:#334155 !important;
  margin:0 !important;
}
.siswa-baru-page .siswa-baru-tapel-select{
  width:320px !important;
  max-width:100% !important;
  min-height:42px !important;
  height:42px !important;
  border-radius:10px !important;
  font-size:13px !important;
}
.siswa-baru-page .siswa-baru-group-title{
  margin:14px 0 8px !important;
}
.siswa-baru-page .siswa-baru-group-title h2{
  margin:0 !important;
  font-size:17px !important;
  line-height:1.25 !important;
  font-weight:800 !important;
  color:#17233a !important;
}
.siswa-baru-page .siswa-baru-group-title p{
  margin:3px 0 0 !important;
  font-size:12px !important;
  line-height:1.4 !important;
  color:#64748b !important;
}
.siswa-baru-page .siswa-baru-action-group-title{margin-top:16px !important}
.siswa-baru-page .siswa-baru-stats,
.siswa-baru-page .siswa-baru-actions{
  margin-top:0 !important;
}
/* Action cards use the same approved dashboard master proportions, while their
   group heading distinguishes them semantically from status cards. */
.siswa-baru-page .siswa-baru-action{
  min-height:122px !important;
  height:122px !important;
  padding:18px 19px !important;
  border-radius:17px !important;
  gap:15px !important;
}
.siswa-baru-page .siswa-baru-action .alert-icon{
  width:50px !important;
  height:50px !important;
  flex:0 0 50px !important;
  border-radius:15px !important;
  font-size:22px !important;
}
.siswa-baru-page .siswa-baru-action .alert-label{font-size:14px !important;line-height:1.25 !important}
.siswa-baru-page .siswa-baru-action .alert-text{font-size:13px !important;line-height:1.35 !important;margin-top:4px !important}
/* Information is secondary: compact horizontal reading instead of a tall card. */
.siswa-baru-page .siswa-baru-flow{
  padding:14px 18px !important;
  margin-top:16px !important;
}
.siswa-baru-page .siswa-baru-flow .section-title{margin-bottom:7px !important}
.siswa-baru-page .siswa-baru-flow .section-title h2{font-size:16px !important;margin:0 !important}
.siswa-baru-page .siswa-baru-flow .section-title p{font-size:12px !important;margin:3px 0 0 !important;line-height:1.4 !important}
.siswa-baru-page .siswa-baru-flow ol{
  margin:7px 0 0 !important;
  padding-left:20px !important;
  display:grid !important;
  grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  gap:3px 24px !important;
  line-height:1.45 !important;
  font-size:12px !important;
  color:#475569 !important;
}
.siswa-baru-page .siswa-baru-flow li{margin:0 !important}
@media(max-width:700px){
  .siswa-baru-page .siswa-baru-tapel-form{display:block !important;max-width:none !important}
  .siswa-baru-page .siswa-baru-tapel-form label{display:block !important;margin-bottom:5px !important}
  .siswa-baru-page .siswa-baru-tapel-select{width:100% !important}
  .siswa-baru-page .siswa-baru-flow ol{grid-template-columns:1fr !important}
}

/* =========================================================
   V16 — KELAS & ROMBEL MASTER UI
   Presentation only. Preserve database, logic, routes and workflow.
========================================================= */
.kelas-page .page-header{margin-bottom:14px !important}
.kelas-page .page-header h1{margin-bottom:4px !important}
.kelas-page .page-header p{max-width:760px !important}
.kelas-summary-grid{display:grid !important;grid-template-columns:repeat(3,minmax(0,1fr)) !important;gap:14px !important;margin:0 0 18px !important}
.kelas-summary-card{height:112px !important;min-height:112px !important;padding:14px 15px !important;border-radius:15px !important;display:flex !important;align-items:flex-start !important;gap:11px !important;box-shadow:0 7px 17px rgba(15,23,42,.10) !important;overflow:hidden !important}
.kelas-summary-card .alert-icon{width:44px !important;height:44px !important;flex:0 0 44px !important;border-radius:12px !important;background:rgba(255,255,255,.92) !important;display:grid !important;place-items:center !important;font-size:19px !important;box-shadow:0 4px 12px rgba(15,23,42,.08) !important}
.kelas-summary-card.alert-info .alert-icon{color:#2563eb !important}
.kelas-summary-card.alert-success .alert-icon{color:#16a34a !important}
.kelas-summary-card.alert-warning .alert-icon{color:#d97706 !important}
.kelas-summary-card .alert-label{font-size:13px !important;line-height:1.2 !important;font-weight:800 !important;color:#fff !important}
.kelas-summary-card .alert-value{font-size:27px !important;line-height:1 !important;font-weight:900 !important;color:#fff !important;margin-top:3px !important}
.kelas-summary-card .alert-text{font-size:11px !important;line-height:1.25 !important;color:rgba(255,255,255,.94) !important;margin-top:4px !important}
.kelas-page .dashboard-table-card{border-radius:15px !important;overflow:hidden !important}
.kelas-page .section-title{padding-bottom:9px !important;margin-bottom:9px !important}
.kelas-page .section-title h2{font-size:17px !important}
.kelas-page .section-title p{font-size:11px !important}
.kelas-page .filter-bar{display:grid !important;grid-template-columns:minmax(170px,1fr) minmax(220px,1.4fr) minmax(130px,.75fr) 90px auto auto !important;gap:8px !important;align-items:center !important;padding:10px !important;border-radius:12px !important;background:#f8fafc !important;border:1px solid #e2e8f0 !important;margin-bottom:10px !important}
.kelas-page .filter-bar .form-control{min-width:0 !important;height:40px !important;min-height:40px !important;font-size:13px !important}
.kelas-page .filter-bar .btn{height:40px !important;min-height:40px !important;white-space:nowrap !important;padding:0 13px !important}
.kelas-page .data-table thead th{font-size:12px !important;padding:11px 12px !important}
.kelas-page .data-table tbody td{font-size:13px !important;padding:10px 12px !important}
.kelas-page .table-actions{gap:5px !important;flex-wrap:nowrap !important}
.kelas-page .table-actions .btn-icon-sm{width:31px !important;height:31px !important;min-width:31px !important;padding:0 !important;border-radius:9px !important}
.kelas-page .btn-info{background:#06b6d4 !important;border-color:#06b6d4 !important;color:#fff !important}
.kelas-page .btn-warning{color:#fff !important}
.kelas-page .btn-back{background:#fff !important;color:#334155 !important;border-color:#cbd5e1 !important}
.kelas-page .detail-grid{gap:10px !important}
.kelas-page .detail-grid > div{padding:12px 14px !important;border-radius:12px !important;background:#f8fafc !important;border:1px solid #e2e8f0 !important}
.kelas-page .detail-grid small{font-size:11px !important;color:#64748b !important}
.kelas-page .detail-grid strong{font-size:15px !important;color:#17233a !important}
.kelas-page .form-card{border-radius:15px !important;padding:20px !important}
.kelas-page .form-grid{gap:14px !important}
.kelas-page .form-grid label{font-size:12px !important;font-weight:700 !important;color:#334155 !important}
.kelas-page .form-control{min-height:42px !important;height:42px !important;font-size:13px !important}
.kelas-page .form-actions{gap:8px !important;margin-top:16px !important}
@media(max-width:1050px){
 .kelas-summary-grid{grid-template-columns:repeat(2,minmax(0,1fr)) !important}
 .kelas-page .filter-bar{grid-template-columns:repeat(2,minmax(0,1fr)) !important}
}
@media(max-width:700px){
 .kelas-summary-grid{grid-template-columns:1fr !important}
 .kelas-summary-card{height:104px !important;min-height:104px !important}
 .kelas-page .filter-bar{grid-template-columns:1fr !important}
 .kelas-page .page-header-actions{width:100% !important}
 .kelas-page .page-header-actions .btn{width:100% !important}
 .kelas-page .detail-grid{grid-template-columns:1fr !important}
}

/* =========================================================
   V16.1 — KELAS & ROMBEL ACTION / SURFACE FIX
   Presentation only. Preserve database, logic, routes and workflow.
========================================================= */
.kelas-page .dashboard-table-card,
.kelas-page .filter-bar,
.kelas-page .table-responsive,
.kelas-page .data-table,
.kelas-page .data-table thead,
.kelas-page .data-table tbody,
.kelas-page .data-table tr,
.kelas-page .data-table th,
.kelas-page .data-table td{
  background-image:none !important;
}
.kelas-page .dashboard-table-card{
  background:#fff !important;
}
.kelas-page .filter-bar{
  background:#f8fafc !important;
}
.kelas-page .table-responsive{
  background:#fff !important;
}
.kelas-page .data-table{
  background:#fff !important;
}
.kelas-page .data-table thead th{
  background:#f1f5f9 !important;
  color:#334155 !important;
}
.kelas-page .data-table tbody tr:nth-child(even) td{
  background:#f8fafc !important;
}
.kelas-page .data-table tbody tr:nth-child(odd) td{
  background:#fff !important;
}
.kelas-page .data-table tbody tr:hover td{
  background:#eff6ff !important;
}

/* Function-coded table actions: never look disabled when they are actionable. */
.kelas-page .table-actions .btn-info{
  background:#06b6d4 !important;
  border-color:#06b6d4 !important;
  color:#fff !important;
}
.kelas-page .table-actions .btn-warning{
  background:#f59e0b !important;
  border-color:#f59e0b !important;
  color:#fff !important;
}
.kelas-page .table-actions .btn-success{
  background:#16a34a !important;
  border-color:#16a34a !important;
  color:#fff !important;
}
.kelas-page .table-actions .btn-danger{
  background:#dc2626 !important;
  border-color:#dc2626 !important;
  color:#fff !important;
}
.kelas-page .table-actions .btn-info:hover{background:#0891b2 !important;border-color:#0891b2 !important}
.kelas-page .table-actions .btn-warning:hover{background:#d97706 !important;border-color:#d97706 !important}
.kelas-page .table-actions .btn-success:hover{background:#15803d !important;border-color:#15803d !important}
.kelas-page .table-actions .btn-danger:hover{background:#b91c1c !important;border-color:#b91c1c !important}
.kelas-page .table-actions .btn-icon-sm{
  display:inline-flex !important;
  align-items:center !important;
  justify-content:center !important;
  opacity:1 !important;
}
.kelas-page .table-actions .btn-icon-sm i{
  color:#fff !important;
  opacity:1 !important;
}
.kelas-page .table-actions .text-muted{
  color:#64748b !important;
  background:transparent !important;
}

@media(max-width:900px){
  .kelas-page .filter-bar{
    grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  }
}
@media(max-width:620px){
  .kelas-page .filter-bar{
    grid-template-columns:1fr !important;
  }
  .kelas-page .table-actions{
    flex-wrap:wrap !important;
  }
}


/* =========================================================
   V16.2 — KELAS & ROMBEL CLICK / LAYER FIX
   Presentation only. Prevent decorative layers from covering
   interactive table controls. Preserve all routes and logic.
========================================================= */
.kelas-page .dashboard-table-card{
  position:relative !important;
  isolation:isolate !important;
  z-index:1 !important;
}
.kelas-page .dashboard-table-card::before,
.kelas-page .dashboard-table-card::after,
.kelas-page .table-responsive::before,
.kelas-page .table-responsive::after,
.kelas-page .data-table::before,
.kelas-page .data-table::after{
  content:none !important;
  display:none !important;
  pointer-events:none !important;
}
.kelas-page .dashboard-table-card > *,
.kelas-page .table-responsive,
.kelas-page .data-table,
.kelas-page .data-table tbody,
.kelas-page .data-table tr,
.kelas-page .data-table td,
.kelas-page .table-actions{
  position:relative !important;
  z-index:2 !important;
}
.kelas-page .table-actions,
.kelas-page .table-actions a,
.kelas-page .table-actions button,
.kelas-page .table-actions form{
  pointer-events:auto !important;
}
.kelas-page .table-actions .btn-icon-sm{
  position:relative !important;
  z-index:5 !important;
  cursor:pointer !important;
}
/* Keep the table surface visually clean even when another global
   background/pseudo rule is introduced later. */
.kelas-page .dashboard-table-card,
.kelas-page .table-responsive,
.kelas-page .data-table,
.kelas-page .data-table tbody,
.kelas-page .data-table tr,
.kelas-page .data-table td{
  background-image:none !important;
}

/* =========================================================
   V17 — KENAIKAN KELAS MASTER UI
   Presentation only. No business logic / database changes.
========================================================= */
.kenaikan-page{
  --kk-blue:#2563eb;
  --kk-green:#16a34a;
  --kk-orange:#f59e0b;
  --kk-cyan:#0891b2;
  --kk-purple:#7c3aed;
}
.kenaikan-page .page-header{
  align-items:center;
  margin-bottom:18px;
}
.kenaikan-page .page-header h1{
  margin-bottom:5px;
}
.kenaikan-page .page-header p{
  max-width:820px;
}
.kenaikan-page .page-header .btn{
  white-space:nowrap;
}
.kenaikan-page .kenaikan-form-card{
  padding:20px;
  border:1px solid #e2e8f0;
  box-shadow:0 6px 18px rgba(15,23,42,.045);
}
.kenaikan-page .form-grid{
  gap:14px;
}
.kenaikan-page .form-grid label{
  font-size:13px;
  font-weight:700;
  color:#334155;
}
.kenaikan-page .form-control{
  min-height:44px;
}
.kenaikan-page .section-title{
  margin:20px 0 12px;
}
.kenaikan-page .section-title h2{
  font-size:18px;
}
.kenaikan-page .section-title p{
  font-size:13px;
}
.kenaikan-page .table-responsive{
  border:1px solid #e2e8f0;
  border-radius:12px;
  background:#fff;
}
.kenaikan-page .data-table{
  min-width:620px;
  background:#fff !important;
}
.kenaikan-page .data-table thead th{
  background:#f1f5f9 !important;
  color:#334155 !important;
  font-size:12px;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.02em;
  padding:12px 14px;
  white-space:nowrap;
}
.kenaikan-page .data-table tbody td{
  padding:11px 14px;
  font-size:13px;
  vertical-align:middle;
}
.kenaikan-page .data-table tbody tr:nth-child(odd) td{background:#fff !important}
.kenaikan-page .data-table tbody tr:nth-child(even) td{background:#f8fafc !important}
.kenaikan-page .data-table tbody tr:hover td{background:#eff6ff !important}
.kenaikan-page .data-table select.form-control{
  min-height:38px;
  padding-top:7px;
  padding-bottom:7px;
  font-size:13px;
}
.kenaikan-page .form-actions{
  margin-top:14px;
  padding-top:14px;
  border-top:1px solid #eef2f7;
}
.kenaikan-page .form-actions .btn-primary{
  background:#2563eb !important;
  border-color:#2563eb !important;
  color:#fff !important;
}
.kenaikan-page .form-actions .btn-primary:hover{background:#1d4ed8 !important;border-color:#1d4ed8 !important}

/* Status cards: same family as Dashboard, but function-specific colors. */
.kenaikan-page .kenaikan-stats{
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:16px;
}
.kenaikan-page .kenaikan-stat{
  position:relative;
  min-height:122px;
  padding:18px 20px;
  overflow:hidden;
  border:0 !important;
  border-radius:18px;
  color:#fff !important;
  box-shadow:0 8px 22px rgba(15,23,42,.10);
}
.kenaikan-page .kenaikan-stat::after{
  content:"";
  position:absolute;
  width:120px;
  height:120px;
  right:-28px;
  bottom:-62px;
  border-radius:50%;
  background:rgba(255,255,255,.14);
  pointer-events:none;
}
.kenaikan-page .kenaikan-stat .card-label,
.kenaikan-page .kenaikan-stat .card-number,
.kenaikan-page .kenaikan-stat .card-description{
  position:relative;
  z-index:1;
  color:#fff !important;
}
.kenaikan-page .kenaikan-stat .card-label{
  font-size:14px;
  font-weight:800;
  margin-bottom:6px;
}
.kenaikan-page .kenaikan-stat .card-number{
  font-size:30px;
  line-height:1.05;
  font-weight:800;
}
.kenaikan-page .kenaikan-stat .card-description{
  margin-top:5px;
  font-size:12px;
  opacity:.92;
}
.kenaikan-page .kenaikan-stat-total{background:linear-gradient(135deg,#2563eb,#4338ca) !important}
.kenaikan-page .kenaikan-stat-ready{background:linear-gradient(135deg,#16a34a,#047857) !important}
.kenaikan-page .kenaikan-stat-existing{background:linear-gradient(135deg,#0891b2,#0f766e) !important}
.kenaikan-page .kenaikan-stat-attention{background:linear-gradient(135deg,#f59e0b,#d97706) !important}

.kenaikan-page .kenaikan-preview-card{
  overflow:hidden;
  border:1px solid #e2e8f0;
  box-shadow:0 6px 18px rgba(15,23,42,.045);
}
.kenaikan-page .kenaikan-preview-card .section-title{
  padding:0 2px;
}
.kenaikan-page .status-badge{
  font-size:11px;
  font-weight:800;
  white-space:nowrap;
}
.kenaikan-page .status-badge.status-aktif{
  background:#dcfce7 !important;
  color:#166534 !important;
  border-color:#bbf7d0 !important;
}
.kenaikan-page .status-badge.status-nonaktif{
  background:#fef3c7 !important;
  color:#92400e !important;
  border-color:#fde68a !important;
}
.kenaikan-page .kenaikan-preview-card form.mt-3{
  padding-top:14px;
  border-top:1px solid #eef2f7;
}
.kenaikan-page .kenaikan-preview-card .btn-success{
  background:#16a34a !important;
  border-color:#16a34a !important;
  color:#fff !important;
}
.kenaikan-page .kenaikan-preview-card .btn-success:hover{background:#15803d !important;border-color:#15803d !important}

@media(max-width:1100px){
  .kenaikan-page .kenaikan-stats{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:700px){
  .kenaikan-page .page-header{align-items:flex-start;flex-direction:column;gap:10px}
  .kenaikan-page .page-header .btn{width:auto}
  .kenaikan-page .kenaikan-stats{grid-template-columns:1fr;gap:12px}
  .kenaikan-page .kenaikan-stat{min-height:108px;padding:16px}
  .kenaikan-page .kenaikan-form-card{padding:14px}
}


/* =========================================================
   V18 — KENAIKAN + MUTASI + PINDAH + KELUAR + KELULUSAN
   Unified presentation system. Business logic untouched.
========================================================= */

/* ---------- Shared full-color buttons ---------- */
.kenaikan-page .btn-primary,
.mutasi-page .btn-primary,
.mutasi-subpage .btn-primary,
.kelulusan-page .btn-primary{
  background:#2563eb !important;border-color:#2563eb !important;color:#fff !important;
}
.kenaikan-page .btn-success,
.mutasi-page .btn-success,
.mutasi-subpage .btn-success,
.kelulusan-page .btn-success{
  background:#16a34a !important;border-color:#16a34a !important;color:#fff !important;
}
.kenaikan-page .btn-danger,
.mutasi-page .btn-danger,
.mutasi-subpage .btn-danger,
.kelulusan-page .btn-danger{
  background:#dc2626 !important;border-color:#dc2626 !important;color:#fff !important;
}
.kenaikan-page .btn-warning,
.mutasi-page .btn-warning,
.mutasi-subpage .btn-warning,
.kelulusan-page .btn-warning{
  background:#f59e0b !important;border-color:#f59e0b !important;color:#fff !important;
}
.kenaikan-page .btn-secondary,
.mutasi-page .btn-secondary,
.mutasi-subpage .btn-secondary,
.kelulusan-page .btn-secondary{
  background:#fff !important;border-color:#cbd5e1 !important;color:#334155 !important;
}
.kenaikan-page .btn-info,
.mutasi-page .btn-info,
.mutasi-subpage .btn-info,
.kelulusan-page .btn-info{
  background:#06b6d4 !important;border-color:#06b6d4 !important;color:#fff !important;
}
.kenaikan-page .btn-purple,
.mutasi-page .btn-purple,
.mutasi-subpage .btn-purple,
.kelulusan-page .btn-purple{
  background:#7c3aed !important;border-color:#7c3aed !important;color:#fff !important;
}

/* ---------- Shared compact full-color tables ---------- */
.kenaikan-page .dashboard-table-card,
.mutasi-page .dashboard-table-card,
.mutasi-subpage .dashboard-table-card,
.kelulusan-page .dashboard-table-card{
  overflow:hidden;
  border:1px solid #dbe3ee;
  background:#fff !important;
  box-shadow:0 6px 18px rgba(15,23,42,.055);
}
.kenaikan-page .data-table,
.mutasi-page .data-table,
.mutasi-subpage .data-table,
.kelulusan-page .data-table{
  background:#fff !important;
  border-collapse:separate !important;
  border-spacing:0 !important;
  width:100%;
}
.kenaikan-page .data-table thead th,
.mutasi-page .data-table thead th,
.mutasi-subpage .data-table thead th,
.kelulusan-page .data-table thead th{
  background:linear-gradient(135deg,#2563eb,#4338ca) !important;
  color:#fff !important;
  border-color:rgba(255,255,255,.12) !important;
  font-size:12px !important;
  font-weight:800 !important;
  letter-spacing:.02em;
  text-transform:uppercase;
  padding:12px 14px !important;
  white-space:nowrap;
}
.kenaikan-page .data-table tbody td,
.mutasi-page .data-table tbody td,
.mutasi-subpage .data-table tbody td,
.kelulusan-page .data-table tbody td{
  background:#fff !important;
  color:#1e293b !important;
  border-bottom:1px solid #e7edf5 !important;
  padding:11px 14px !important;
  font-size:13px !important;
  vertical-align:middle !important;
}
.kenaikan-page .data-table tbody tr:nth-child(even) td,
.mutasi-page .data-table tbody tr:nth-child(even) td,
.mutasi-subpage .data-table tbody tr:nth-child(even) td,
.kelulusan-page .data-table tbody tr:nth-child(even) td{background:#f8fbff !important}
.kenaikan-page .data-table tbody tr:hover td,
.mutasi-page .data-table tbody tr:hover td,
.mutasi-subpage .data-table tbody tr:hover td,
.kelulusan-page .data-table tbody tr:hover td{background:#eef5ff !important}

/* ---------- Kenaikan ---------- */
.kenaikan-page .kenaikan-form-card{background:#fff !important}
.kenaikan-page .kenaikan-stat{min-height:112px !important;padding:16px 18px !important}
.kenaikan-page .kenaikan-preview-card .section-title{padding:0 2px}
.kenaikan-page .status-badge{display:inline-flex;align-items:center;justify-content:center;min-height:26px;padding:4px 10px;border-radius:999px;font-weight:800}

/* ---------- Mutasi overview ---------- */
.mutasi-page .mutasi-summary{
  display:grid !important;grid-template-columns:repeat(3,minmax(0,1fr)) !important;gap:16px !important;
}
.mutasi-page .mutasi-summary .dashboard-card{
  min-height:112px !important;padding:17px 19px !important;border:0 !important;border-radius:18px !important;color:#fff !important;overflow:hidden;position:relative;
}
.mutasi-page .mutasi-summary .dashboard-card::after{
  content:"";position:absolute;width:105px;height:105px;right:-25px;bottom:-58px;border-radius:50%;background:rgba(255,255,255,.14);pointer-events:none;
}
.mutasi-page .mutasi-summary .dashboard-card:nth-child(1){background:linear-gradient(135deg,#2563eb,#4338ca) !important}
.mutasi-page .mutasi-summary .dashboard-card:nth-child(2){background:linear-gradient(135deg,#0891b2,#0e7490) !important}
.mutasi-page .mutasi-summary .dashboard-card:nth-child(3){background:linear-gradient(135deg,#f59e0b,#d97706) !important}
.mutasi-page .mutasi-summary .card-label,.mutasi-page .mutasi-summary .card-number{position:relative;z-index:1;color:#fff !important}
.mutasi-page .mutasi-summary .card-label{font-size:14px;font-weight:800}
.mutasi-page .mutasi-summary .card-number{font-size:30px;line-height:1.05;font-weight:800;margin-top:4px}

.mutasi-page .mutasi-actions{
  display:grid !important;grid-template-columns:repeat(2,minmax(0,1fr)) !important;gap:16px !important;
}
.mutasi-page .mutasi-actions .form-card{
  min-height:142px;padding:18px 20px !important;border:0 !important;border-radius:18px !important;color:#fff !important;position:relative;overflow:hidden;
}
.mutasi-page .mutasi-actions .form-card:nth-child(1){background:linear-gradient(135deg,#0891b2,#0f766e) !important}
.mutasi-page .mutasi-actions .form-card:nth-child(2){background:linear-gradient(135deg,#f59e0b,#d97706) !important}
.mutasi-page .mutasi-actions .form-card h2,.mutasi-page .mutasi-actions .form-card p{color:#fff !important}
.mutasi-page .mutasi-actions .form-card .btn-primary{background:rgba(255,255,255,.96) !important;border-color:#fff !important;color:#0f172a !important}

/* ---------- Mutasi sub-pages ---------- */
.mutasi-subpage .form-card{background:#fff !important;border:1px solid #dbe3ee !important;box-shadow:0 5px 16px rgba(15,23,42,.045)}
.mutasi-subpage .detail-grid > div{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:12px 14px}
.mutasi-subpage .data-table .btn-sm{font-weight:800}
.mutasi-subpage .form-actions{gap:10px;display:flex;flex-wrap:wrap;align-items:center}
.mutasi-subpage .alert-success{border-left:4px solid #16a34a}
.mutasi-subpage .alert-danger{border-left:4px solid #dc2626}

/* ---------- Kelulusan ---------- */
.kelulusan-page .form-card,
.kelulusan-page .dashboard-table-card{background:#fff !important;border:1px solid #dbe3ee !important;box-shadow:0 6px 18px rgba(15,23,42,.045)}
.kelulusan-page .student-check{width:18px;height:18px;accent-color:#2563eb}
.kelulusan-page .status-badge.status-aktif{background:#dcfce7 !important;color:#166534 !important;border:1px solid #bbf7d0 !important}
.kelulusan-page .form-actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.kelulusan-page .alert-warning{background:#fff7ed !important;border:1px solid #fed7aa !important;color:#9a3412 !important}

/* Remove oversized navigation shortcut appearance on Kenaikan; page header stays clean. */
.kenaikan-page .page-header-actions:empty{display:none !important}

@media(max-width:1000px){
  .mutasi-page .mutasi-summary{grid-template-columns:repeat(2,minmax(0,1fr)) !important}
}
@media(max-width:720px){
  .mutasi-page .mutasi-summary,.mutasi-page .mutasi-actions{grid-template-columns:1fr !important}
  .mutasi-page .mutasi-summary .dashboard-card{min-height:104px !important}
  .mutasi-page .mutasi-actions .form-card{min-height:auto !important}
}


/* =========================================================
   SPLASMA V18.2 — GURU & TENDIK MASTER UI
   Presentation only. No database, business logic, route,
   permission or workflow changes.
   Principle: Dashboard master cards + function-coded actions
   + compact, readable tables/forms + efficient space.
========================================================= */

/* Data Guru uses the exact Dashboard master family for summary cards. */
.guru-master-page .guru-master-stats{
  grid-template-columns:repeat(3,minmax(0,1fr)) !important;
  gap:14px !important;
  margin-bottom:22px !important;
}
.guru-master-page .guru-master-stats .dashboard-alert{
  min-height:108px !important;
  height:108px !important;
  padding:16px 17px !important;
  border-radius:17px !important;
  box-sizing:border-box !important;
}
.guru-master-page .guru-master-stats .alert-icon{
  width:42px !important;height:42px !important;flex:0 0 42px !important;
  border-radius:13px !important;font-size:18px !important;
}
.guru-master-page .guru-master-stats .alert-label{font-size:12px !important;font-weight:800 !important}
.guru-master-page .guru-master-stats .alert-value{font-size:24px !important;font-weight:850 !important}
.guru-master-page .guru-master-stats .alert-text{font-size:11px !important}

/* Functional page actions. */
.guru-page .page-header-actions .btn,
.guru-subpage .page-header-actions .btn,
.guru-task-page .page-header-actions .btn,
.guru-wali-page .page-header-actions .btn,
.guru-piket-page .page-header-actions .btn{
  min-height:38px !important;height:38px !important;
  border-radius:10px !important;font-weight:800 !important;
}
.guru-page .btn-fn-add{background:#2563eb !important;border-color:#2563eb !important;color:#fff !important}
.guru-page .btn-fn-import{background:#16a34a !important;border-color:#16a34a !important;color:#fff !important}
.guru-subpage .btn-fn-save,.guru-task-page .btn-fn-save{background:#16a34a !important;border-color:#16a34a !important;color:#fff !important}
.guru-subpage .btn-fn-print{background:#7c3aed !important;border-color:#7c3aed !important;color:#fff !important}

/* Shared table system for Guru/Tendik-related tables. */
.guru-page .data-table,
.guru-task-page .data-table,
.guru-wali-table-page .data-table{
  width:100% !important;background:#fff !important;border-collapse:separate !important;border-spacing:0 !important;
}
.guru-page .data-table thead th,
.guru-task-page .data-table thead th,
.guru-wali-table-page .data-table thead th{
  background:linear-gradient(135deg,#2563eb,#4338ca) !important;
  color:#fff !important;border-color:rgba(255,255,255,.12) !important;
  font-size:12px !important;font-weight:800 !important;text-transform:uppercase;
  letter-spacing:.02em;padding:11px 12px !important;white-space:nowrap !important;
}
.guru-page .data-table tbody td,
.guru-task-page .data-table tbody td,
.guru-wali-table-page .data-table tbody td{
  background:#fff !important;color:#1e293b !important;border-bottom:1px solid #e7edf5 !important;
  font-size:13px !important;padding:10px 12px !important;vertical-align:middle !important;
}
.guru-page .data-table tbody tr:nth-child(even) td,
.guru-task-page .data-table tbody tr:nth-child(even) td,
.guru-wali-table-page .data-table tbody tr:nth-child(even) td{background:#f8fbff !important}
.guru-page .data-table tbody tr:hover td,
.guru-task-page .data-table tbody tr:hover td,
.guru-wali-table-page .data-table tbody tr:hover td{background:#eef5ff !important}

/* Guru table actions: one color per function. */
.guru-page .table-actions{gap:5px !important;flex-wrap:nowrap !important}
.guru-page .table-actions .btn-icon-sm,
.guru-task-page .table-actions .btn-icon-sm,
.guru-wali-table-page .table-actions .btn-icon-sm{
  width:31px !important;height:31px !important;min-width:31px !important;padding:0 !important;border-radius:9px !important;
  display:inline-flex !important;align-items:center !important;justify-content:center !important;
}
.guru-page .table-actions .btn-fn-detail,
.guru-wali-table-page .table-actions .btn-fn-detail{background:#06b6d4 !important;border-color:#06b6d4 !important;color:#fff !important}
.guru-page .table-actions .btn-fn-edit{background:#f59e0b !important;border-color:#f59e0b !important;color:#fff !important}
.guru-page .table-actions .btn-fn-qr{background:#7c3aed !important;border-color:#7c3aed !important;color:#fff !important}
.guru-page .table-actions .btn-warning,
.guru-task-page .table-actions .btn-warning{background:#f59e0b !important;border-color:#f59e0b !important;color:#fff !important}
.guru-page .table-actions .btn-danger,
.guru-task-page .table-actions .btn-danger{background:#dc2626 !important;border-color:#dc2626 !important;color:#fff !important}
.guru-task-page .table-actions .btn-secondary{background:#06b6d4 !important;border-color:#06b6d4 !important;color:#fff !important}

/* Guru detail/form/import/QR pages: same compact hierarchy. */
.guru-subpage .form-card,
.guru-subpage .dashboard-table-card,
.guru-task-page .form-card,
.guru-task-page .dashboard-table-card,
.guru-wali-page .form-card,
.guru-wali-page .dashboard-table-card,
.guru-piket-page .form-card{
  border:1px solid #dbe3ee !important;background:#fff !important;
  box-shadow:0 6px 18px rgba(15,23,42,.045) !important;
  border-radius:16px !important;
}
.guru-subpage .form-actions,.guru-task-page .form-actions,.guru-wali-page .form-actions,.guru-piket-page .form-actions{
  display:flex !important;gap:9px !important;flex-wrap:wrap !important;align-items:center !important;
}
.guru-subpage .form-actions .btn-primary,.guru-task-page .form-actions .btn-primary,.guru-wali-page .form-actions .btn-primary,.guru-piket-page .form-actions .btn-primary{
  background:#16a34a !important;border-color:#16a34a !important;color:#fff !important;
}
.guru-subpage .form-actions .btn-secondary,.guru-task-page .form-actions .btn-secondary,.guru-wali-page .form-actions .btn-secondary,.guru-piket-page .form-actions .btn-secondary{
  background:#64748b !important;border-color:#64748b !important;color:#fff !important;
}
.guru-subpage .page-header-actions .btn-primary{background:#7c3aed !important;border-color:#7c3aed !important;color:#fff !important}
.guru-subpage .page-header-actions .btn-secondary,.guru-task-page .page-header-actions .btn-secondary,.guru-wali-page .page-header-actions .btn-secondary,.guru-piket-page .page-header-actions .btn-secondary{background:#64748b !important;border-color:#64748b !important;color:#fff !important}
.guru-subpage .form-card .section-title a.btn-secondary{background:#7c3aed !important;border-color:#7c3aed !important;color:#fff !important}

/* Tugas Tambahan: separate editor/action area from history data. */
.guru-task-page .form-card#editor{border-top:4px solid #2563eb !important}
.guru-task-page .form-card#editor h2{font-size:17px !important}
.guru-task-page .data-table td{font-size:12.5px !important}
.guru-task-page .status-badge{font-size:11px !important;padding:4px 8px !important}

/* Wali Kelas: action cards are compact, not oversized forms. */
.guru-wali-page .dashboard-grid > .form-card{
  min-height:132px !important;padding:16px !important;
}
.guru-wali-page .dashboard-grid > .form-card .form-actions{margin-top:12px !important}
.guru-wali-page .dashboard-grid > .form-card .form-actions .btn-primary{background:#2563eb !important;border-color:#2563eb !important;color:#fff !important}
.guru-wali-page .dashboard-grid > .form-card .form-actions .btn-secondary{background:#64748b !important;border-color:#64748b !important;color:#fff !important}
.guru-wali-page .form-card .text-muted{font-size:12px !important}

/* Guru Piket: summary cards use the same Dashboard full-color family. */
.guru-piket-page .dashboard-grid:first-of-type .stat-card{
  min-height:108px !important;height:108px !important;border:0 !important;border-radius:17px !important;color:#fff !important;
}
.guru-piket-page .dashboard-grid:first-of-type .stat-card .stat-label,
.guru-piket-page .dashboard-grid:first-of-type .stat-card .stat-value{color:#fff !important}
.guru-piket-page .dashboard-grid:first-of-type .stat-card .stat-icon{background:rgba(255,255,255,.16) !important;color:#fff !important}
.guru-piket-page .dashboard-grid:first-of-type .stat-task{background:linear-gradient(135deg,#2563eb,#4338ca) !important}
.guru-piket-page .dashboard-grid:first-of-type .stat-student{background:linear-gradient(135deg,#16a34a,#047857) !important}
.guru-piket-page .dashboard-grid:first-of-type .stat-qr{background:linear-gradient(135deg,#7c3aed,#6d28d9) !important}
.guru-piket-page .dashboard-grid:first-of-type .stat-pending{background:linear-gradient(135deg,#f59e0b,#d97706) !important}
.guru-piket-page .btn-primary{background:#2563eb !important;border-color:#2563eb !important;color:#fff !important}
.guru-piket-page .btn-secondary{background:#64748b !important;border-color:#64748b !important;color:#fff !important}
.guru-piket-page .status-badge{font-size:11px !important}

@media(max-width:1050px){
  .guru-master-page .guru-master-stats{grid-template-columns:repeat(2,minmax(0,1fr)) !important}
}
@media(max-width:700px){
  .guru-master-page .guru-master-stats{grid-template-columns:1fr !important}
  .guru-master-page .guru-master-stats .dashboard-alert{height:104px !important;min-height:104px !important}
  .guru-wali-page .dashboard-grid{grid-template-columns:1fr !important}
}

/* =========================================================
   V19.1 HOTFIX — GURU MASTER CARD LAYOUT / CONTRAST
   Presentation only. Fixes the Guru summary cards that were
   missing the Dashboard grid context outside dashboard.php.
========================================================= */
.guru-master-page .guru-master-stats{
  display:grid !important;
  grid-template-columns:repeat(3,minmax(0,1fr)) !important;
  gap:14px !important;
  align-items:stretch !important;
  width:100% !important;
}
.guru-master-page .guru-master-stats .dashboard-alert{
  position:relative !important;
  display:flex !important;
  flex-direction:row !important;
  align-items:flex-start !important;
  gap:13px !important;
  min-width:0 !important;
  min-height:108px !important;
  height:108px !important;
  padding:16px 17px !important;
  box-sizing:border-box !important;
  overflow:hidden !important;
  border:0 !important;
  border-radius:17px !important;
  color:#fff !important;
  isolation:isolate !important;
}
.guru-master-page .guru-master-stats .dashboard-alert::before{
  content:"" !important;
  position:absolute !important;
  inset:0 !important;
  z-index:-2 !important;
  background:linear-gradient(135deg,rgba(255,255,255,.08),transparent 48%,rgba(0,0,0,.08)) !important;
}
.guru-master-page .guru-master-stats .dashboard-alert::after{
  content:"" !important;
  position:absolute !important;
  width:120px !important;
  height:120px !important;
  right:-38px !important;
  bottom:-55px !important;
  border-radius:50% !important;
  background:rgba(255,255,255,.12) !important;
  z-index:-1 !important;
  pointer-events:none !important;
}
.guru-master-page .guru-master-stats .dashboard-alert.alert-info{
  background:linear-gradient(135deg,#2563eb 0%,#4338ca 100%) !important;
}
.guru-master-page .guru-master-stats .dashboard-alert.alert-success{
  background:linear-gradient(135deg,#16a34a 0%,#047857 100%) !important;
}
.guru-master-page .guru-master-stats .dashboard-alert.alert-danger{
  background:linear-gradient(135deg,#ef4444 0%,#be123c 100%) !important;
}
.guru-master-page .guru-master-stats .alert-icon{
  width:44px !important;
  height:44px !important;
  flex:0 0 44px !important;
  display:grid !important;
  place-items:center !important;
  border-radius:14px !important;
  background:rgba(255,255,255,.94) !important;
  border:1px solid rgba(255,255,255,.72) !important;
  box-shadow:none !important;
  font-size:18px !important;
}
.guru-master-page .guru-master-stats .alert-info .alert-icon{color:#2563eb !important}
.guru-master-page .guru-master-stats .alert-success .alert-icon{color:#16a34a !important}
.guru-master-page .guru-master-stats .alert-danger .alert-icon{color:#dc2626 !important}
.guru-master-page .guru-master-stats .dashboard-alert > div:last-child{
  min-width:0 !important;
  padding-top:1px !important;
}
.guru-master-page .guru-master-stats .alert-label{
  color:#fff !important;
  font-size:12px !important;
  line-height:1.2 !important;
  font-weight:800 !important;
  margin-bottom:3px !important;
  overflow-wrap:anywhere !important;
}
.guru-master-page .guru-master-stats .alert-value{
  color:#fff !important;
  font-size:27px !important;
  line-height:1.05 !important;
  font-weight:850 !important;
  letter-spacing:-.025em !important;
}
.guru-master-page .guru-master-stats .alert-text{
  color:rgba(255,255,255,.88) !important;
  font-size:11px !important;
  line-height:1.35 !important;
  margin-top:4px !important;
  overflow-wrap:anywhere !important;
}
@media(max-width:1050px){
  .guru-master-page .guru-master-stats{grid-template-columns:repeat(2,minmax(0,1fr)) !important}
}
@media(max-width:700px){
  .guru-master-page .guru-master-stats{grid-template-columns:1fr !important}
  .guru-master-page .guru-master-stats .dashboard-alert{height:104px !important;min-height:104px !important}
}


/* =====================================================
   V20 — ABSENSI MODULE UI STANDARD
   Presentation only. No DB/query/business-flow changes.
===================================================== */
.attendance-module .page-header-actions,
.izin-module .page-header-actions,
.sholat-module .page-header-actions{gap:8px;}
.attendance-module .page-header-actions .btn,
.izin-module .page-header-actions .btn,
.sholat-module .page-header-actions .btn{min-height:42px;}
.attendance-scan-btn{background:#06b6d4!important;border-color:#06b6d4!important;color:#fff!important;}
.attendance-module .filter-bar{display:grid;grid-template-columns:minmax(0,1fr) 190px 110px auto;gap:10px;align-items:center;padding:12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:14px;}
.attendance-module .filter-bar .btn{height:42px;}
.attendance-module .data-table thead th,
.izin-module .table thead th{background:linear-gradient(90deg,#2563eb,#4338ca);color:#fff;border-bottom:0;font-size:12px;}
.attendance-module .data-table tbody td,
.izin-module .table tbody td{padding:11px 13px;}
.attendance-module .status-badge{font-weight:700;}
.attendance-module .status-aktif{background:#dcfce7;color:#166534;}
.attendance-module .status-draft{background:#fef3c7;color:#92400e;}
.attendance-module .status-ditutup{background:#e2e8f0;color:#334155;}
.izin-module .izin-stats-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;}
.izin-module .izin-stats-grid .stat-card{min-height:108px;padding:16px 18px;border:0;color:#fff;}
.izin-module .izin-stats-grid .stat-card .stat-label,
.izin-module .izin-stats-grid .stat-card .stat-value{color:#fff;}
.izin-module .izin-stats-grid .stat-icon{background:rgba(255,255,255,.18);color:#fff;border-color:rgba(255,255,255,.28);}
.izin-module .izin-stats-grid .stat-card:nth-child(1){background:linear-gradient(135deg,#2563eb,#4338ca);}
.izin-module .izin-stats-grid .stat-card:nth-child(2){background:linear-gradient(135deg,#16a34a,#047857);}
.izin-module .izin-stats-grid .stat-card:nth-child(3){background:linear-gradient(135deg,#7c3aed,#6d28d9);}
.izin-module .izin-stats-grid .stat-card:nth-child(4){background:linear-gradient(135deg,#0891b2,#0f766e);}
.izin-module .form-card{border-radius:14px;padding:16px 18px;}
.izin-module .table-card{border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;background:#fff;}
.izin-module .table{margin:0;}
.izin-module .table tbody td{vertical-align:middle;}
.sholat-module .sholat-actions{justify-content:flex-end;}
.sholat-module .action-divider{width:1px;height:28px;background:#cbd5e1;margin:0 2px;}
.sholat-module .dashboard-table-card{padding:18px;}
.sholat-module .dashboard-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;}
.sholat-module .sholat-session-card{min-height:142px;padding:16px 18px;border:0;color:#fff;box-shadow:0 8px 20px rgba(15,23,42,.10);}
.sholat-module .sholat-session-card .card-label,
.sholat-module .sholat-session-card .card-number,
.sholat-module .sholat-session-card .card-description{color:#fff;}
.sholat-module .sholat-session-card .status-badge{background:rgba(255,255,255,.18);color:#fff;border:1px solid rgba(255,255,255,.25);}
.sholat-module .sholat-state-open{background:linear-gradient(135deg,#16a34a,#047857);}
.sholat-module .sholat-state-draft{background:linear-gradient(135deg,#2563eb,#4338ca);}
.sholat-module .sholat-state-closed{background:linear-gradient(135deg,#64748b,#475569);}
.sholat-module .info-box{border-radius:12px;}
.scanner-module .scanner-connection{padding:9px 12px;margin-bottom:12px;}
.scanner-module .auto-session{padding:12px 14px;margin-bottom:12px;border-radius:12px;}
.scanner-module .form-card{padding:14px;}
.scanner-module .source-hints{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px;}
.scanner-module .source-hints>div{padding:10px 12px;border-radius:10px;background:#f8fafc;border:1px solid #e2e8f0;}
.scanner-module .source-hints span{display:block;margin-top:3px;font-size:12px;color:#64748b;line-height:1.35;}
.scanner-module .scanner-reader{min-height:310px;}
.scanner-module .decoder-help,.scanner-module #cameraHelp{font-size:12px;line-height:1.35;}
.scanner-module .scan-result{border-radius:10px;}
.scanner-module .recent-card{border-radius:12px;}
@media(max-width:900px){
 .izin-module .izin-stats-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
 .sholat-module .dashboard-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
 .attendance-module .filter-bar{grid-template-columns:1fr 1fr;}
 .attendance-module .filter-bar .btn{width:100%;}
}
@media(max-width:700px){
 .izin-module .izin-stats-grid,.sholat-module .dashboard-grid{grid-template-columns:1fr;}
 .attendance-module .filter-bar{grid-template-columns:1fr;}
 .scanner-module .source-hints{grid-template-columns:1fr;}
 .sholat-module .action-divider{display:none;}
}


/* =====================================================
   V20.1 — ABSENSI TABLE + ACTION STANDARD
   Presentation only. Keep business logic untouched.
===================================================== */
.attendance-module .dashboard-table-card,
.attendance-detail-module .dashboard-table-card,
.izin-module .table-card,
.izin-detail-module .form-card,
.sholat-module .dashboard-table-card,
.sholat-submodule .dashboard-table-card,
.sholat-submodule .form-card{
  background:#fff !important;
  border:1px solid #dbe3ee !important;
  box-shadow:0 6px 18px rgba(15,23,42,.045) !important;
}

/* Full-color table header: one consistent SPLASMA standard. */
.attendance-module .data-table,
.attendance-detail-module .data-table,
.izin-module .table,
.sholat-submodule .data-table,
.sholat-module .data-table{
  background:#fff !important;
  border-collapse:separate !important;
  border-spacing:0 !important;
  overflow:hidden;
}
.attendance-module .data-table thead th,
.attendance-detail-module .data-table thead th,
.izin-module .table thead th,
.sholat-submodule .data-table thead th,
.sholat-module .data-table thead th{
  background:#2563eb !important;
  background-image:none !important;
  color:#fff !important;
  border:0 !important;
  font-size:12px !important;
  font-weight:800 !important;
  letter-spacing:.02em;
  white-space:nowrap;
}
.attendance-module .data-table tbody td,
.attendance-detail-module .data-table tbody td,
.izin-module .table tbody td,
.sholat-submodule .data-table tbody td,
.sholat-module .data-table tbody td{
  background:#fff !important;
  color:#1e293b !important;
  border-bottom:1px solid #e5eaf1 !important;
  vertical-align:middle !important;
}
.attendance-module .data-table tbody tr:nth-child(even) td,
.attendance-detail-module .data-table tbody tr:nth-child(even) td,
.izin-module .table tbody tr:nth-child(even) td,
.sholat-submodule .data-table tbody tr:nth-child(even) td,
.sholat-module .data-table tbody tr:nth-child(even) td{
  background:#f8fbff !important;
}
.attendance-module .data-table tbody tr:hover td,
.attendance-detail-module .data-table tbody tr:hover td,
.izin-module .table tbody tr:hover td,
.sholat-submodule .data-table tbody tr:hover td,
.sholat-module .data-table tbody tr:hover td{
  background:#eef5ff !important;
}

/* Filters: compact and aligned. */
.attendance-module .filter-bar,
.sholat-submodule .filter-bar,
.sholat-module .filter-bar{
  background:#f8fafc !important;
  border:1px solid #dbe3ee !important;
  padding:12px !important;
  border-radius:14px !important;
}
.attendance-module .filter-bar .btn,
.sholat-submodule .filter-bar .btn,
.sholat-module .filter-bar .btn{
  background:#2563eb !important;
  border-color:#2563eb !important;
  color:#fff !important;
}
.izin-module .form-card .btn-primary{background:#2563eb !important;border-color:#2563eb !important;color:#fff !important}
.izin-module .form-card .btn-secondary{background:#64748b !important;border-color:#64748b !important;color:#fff !important}

/* Attendance actions. */
.attendance-module .page-header-actions .btn-primary{background:#2563eb !important;border-color:#2563eb !important;color:#fff !important}
.attendance-module .page-header-actions .attendance-scan-btn{background:#06b6d4 !important;border-color:#06b6d4 !important;color:#fff !important}
.attendance-module .table-actions .btn-secondary,
.attendance-detail-module .page-header-actions .btn-secondary{background:#06b6d4 !important;border-color:#06b6d4 !important;color:#fff !important}
.attendance-module .table-actions .btn-primary,
.attendance-detail-module .page-header-actions .btn-primary{background:#2563eb !important;border-color:#2563eb !important;color:#fff !important}
.attendance-module .table-actions .btn-danger{background:#dc2626 !important;border-color:#dc2626 !important;color:#fff !important}
.attendance-module .pagination .btn-secondary,
.sholat-submodule .pagination .btn-secondary{background:#64748b !important;border-color:#64748b !important;color:#fff !important}

/* Verification choices: visible function colors. */
.status-choices button.h{background:#16a34a !important;border-color:#16a34a !important;color:#fff !important}
.status-choices button.a{background:#dc2626 !important;border-color:#dc2626 !important;color:#fff !important}
.status-choices button.i{background:#f59e0b !important;border-color:#f59e0b !important;color:#fff !important}
.status-choices button.s{background:#2563eb !important;border-color:#2563eb !important;color:#fff !important}
.status-choices button.t{background:#7c3aed !important;border-color:#7c3aed !important;color:#fff !important}
.status-choices button.active{box-shadow:0 0 0 2px rgba(15,23,42,.22) inset,0 2px 7px rgba(15,23,42,.12) !important}
