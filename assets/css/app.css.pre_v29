}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-info .alert-icon{color:#2563eb !important;}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-success .alert-icon{color:#16a34a !important;}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-purple .alert-icon{color:#7c3aed !important;}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-danger .alert-icon{color:#dc2626 !important;}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-warning .alert-icon{color:#d97706 !important;}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-teal .alert-icon{color:#0f766e !important;}
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert.alert-cyan .alert-icon{color:#0891b2 !important;}

/* Keep four cards identical even when a label is longer. */
.dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert .alert-label{
    max-width:190px !important;
}
.dashboard-page.role-admin .dashboard-notification-grid .dashboard-alert .alert-label{
    max-width:170px !important;
}

@media (max-width:1100px){
    .dashboard-page.role-admin .dashboard-alert-grid{
        grid-auto-rows:154px;
    }
    .dashboard-page.role-admin .dashboard-alert-grid .dashboard-alert{
        height:154px !important;
        min-height:154px !important;
    }
}
